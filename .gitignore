# build output
dist/
.next/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.*
!.env.example

# Timeless Free Font License: the fonts may be embedded in the site, but this
# public repository must not contain the files or any derivative. Build downloads
# them from a private Vercel Blob store into src/assets/fonts/timeless/.
src/assets/fonts/timeless/
**/*[Tt]imeless*.woff2
**/*[Tt]imeless*.woff
**/*[Tt]imeless*.otf
**/*[Tt]imeless*.ttf
**/*[Tt]imeless*.ttc
**/*[Tt]imeless*.eot
**/*[Tt]imeless*.dfont

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# browser test artifacts
playwright-report/
test-results/

# local scratch / agent previews
output/*.png
output/*.webp
output/*.jpg
