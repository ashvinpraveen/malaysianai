---
interface Props {
	current: 'original' | 'split' | 'index' | 'rail';
}

const { current } = Astro.props;
const options = [
	{ id: 'original', href: '/blog/', label: 'Original' },
	{ id: 'split', href: '/blog/option-1/', label: '01 Wide rail' },
	{ id: 'index', href: '/blog/option-2/', label: '02 Original +' },
	{ id: 'rail', href: '/blog/option-3/', label: '03 Tall rail' },
] as const;
---

<nav class="layout-nav" aria-label="Blog layout options">
	<span>Layouts</span>
	<div>
		{options.map((option) => (
			<a href={option.href} aria-current={current === option.id ? 'page' : undefined}>
				{option.label}
			</a>
		))}
	</div>
</nav>

<style>
	.layout-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: min(100%, 82rem);
		margin: 0 auto clamp(2.25rem, 4vw, 4rem);
		color: rgb(224 232 244 / 0.45);
		font-size: 0.75rem;
		letter-spacing: 0.04em;
	}

	.layout-nav > div {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		justify-content: flex-end;
	}

	.layout-nav a {
		padding: 0.4rem 0.55rem;
		border-radius: 0.35rem;
		color: rgb(224 232 244 / 0.58);
		text-decoration: none;
		transition: color 160ms ease, background 160ms ease;
	}

	.layout-nav a:hover,
	.layout-nav a:focus-visible,
	.layout-nav a[aria-current='page'] {
		color: #f4f7fc;
		background: rgb(115 152 207 / 0.12);
	}

	.layout-nav a:focus-visible {
		outline: 2px solid #97b8e7;
		outline-offset: 2px;
	}

	@media (max-width: 620px) {
		.layout-nav {
			align-items: flex-start;
			margin-bottom: 2.5rem;
		}

		.layout-nav > span {
			display: none;
		}

		.layout-nav > div {
			justify-content: flex-start;
		}
	}
</style>
