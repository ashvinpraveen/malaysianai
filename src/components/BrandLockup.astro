---
import { BRAND_LOCKUP_DARK_SRC, BRAND_LOCKUP_LIGHT_SRC } from '../lib/brand';

interface Props {
	loading?: 'eager' | 'lazy';
}

const { loading = 'eager' } = Astro.props;
---

<span class="brand-lockup">
	<img
		class="brand-lockup-image brand-lockup-image-light"
		src={BRAND_LOCKUP_LIGHT_SRC}
		alt="Malaysian AI"
		width="4380"
		height="1080"
		loading={loading}
		decoding="async"
	/>
	<img
		class="brand-lockup-image brand-lockup-image-dark"
		src={BRAND_LOCKUP_DARK_SRC}
		alt=""
		width="4380"
		height="1080"
		loading={loading}
		decoding="async"
	/>
</span>

<style>
	.brand-lockup {
		display: inline-flex;
		align-items: stretch;
		height: 100%;
	}

	.brand-lockup-image {
		display: block;
		height: 100%;
		width: auto;
		max-width: none;
		object-fit: contain;
	}

	.brand-lockup-image-dark { display: none; }
	:global(html[data-theme='light']) .brand-lockup-image-light { display: none; }
	:global(html[data-theme='light']) .brand-lockup-image-dark { display: block; }
</style>
