---
import { Image } from 'astro:assets';
import { ADD_COMMUNITY_HREF, LUMA_URL } from '../consts';
import buildClubLogo from '../assets/communities/build-club-logo-navbar.webp';
import buildWithAiLogo from '../assets/communities/build_with_ai_logo.jpeg';
import aiTinkerersLogo from '../assets/communities/ai_tinkerers_logo.png';
import aiHackerdormLogo from '../assets/communities/ai_hackerdorm.webp';
import aiSeaLogo from '../assets/communities/aisea_logo.png';
import krackedDevsLogo from '../assets/communities/krackeddevs-logo.png';
import rakanTutorLogo from '../assets/communities/rakan-tutor-logo.png';
import coderPuffsLogo from '../assets/communities/coderpuffs_logo.png';
import cursorLogo from '../assets/communities/cursor-community-logo.png';

// Logos render at most ~145px wide on desktop and ~85px on mobile.
const logoWidths = [200, 400];
const logoSizes = '200px';

const communities = [
	{
		name: 'Build Club',
		logo: buildClubLogo,
		logoClass: 'is-wide',
		label: 'Learn by building',
		description:
			'A large Asia-Pacific builder community with bite-sized courses, role-based learning tracks, and project bounties. A useful place to learn AI by making real things.',
	},
	{
		name: 'Build with AI',
		logo: buildWithAiLogo,
		logoClass: 'is-square',
		label: 'Open builder meetups',
		description:
			"Malaysia's home for developers and non-technical builders creating AI projects together. Its meetups welcome first-timers and experienced makers alike.",
	},
	{
		name: 'AI Tinkerers',
		logo: aiTinkerersLogo,
		logoClass: 'is-wide',
		label: 'Technical deep dives',
		description:
			'The Kuala Lumpur chapter of a global AI engineering network. Monthly meetups put live demos, practical talks, and technical conversation in the same room.',
	},
	{
		name: 'AI Hackerdorm',
		logo: aiHackerdormLogo,
		logoClass: 'is-square',
		label: 'Student-first builds',
		description:
			'A community for student coders, designers, and founders building AI projects together through weekly sprints, hackathons, and mentorship sessions.',
	},
	{
		name: 'AI SEA',
		logo: aiSeaLogo,
		logoClass: 'is-square',
		label: 'Southeast Asian network',
		description:
			'A regional builder network for people shipping AI products. It brings engineers together through hackathons, co-build sprints, and AI.SEA Week.',
	},
	{
		name: 'KrackedDevs',
		logo: krackedDevsLogo,
		logoClass: 'is-square',
		label: 'Grassroots builder guilds',
		description:
			'A Malaysian builder ecosystem helping technical and non-technical folks become AI builders through guilds, workshops, bounties, and project showcases.',
	},
	{
		name: 'Rakan Tutor',
		logo: rakanTutorLogo,
		logoClass: 'is-wide',
		label: 'AI education for all',
		description:
			'A Malaysian non-profit bringing free, hands-on AI education to underserved secondary school students and helping young people prepare for an AI-shaped future.',
	},
	{
		name: 'CoderPuffs',
		logo: coderPuffsLogo,
		logoClass: 'is-square',
		label: 'Women-first community',
		description:
			'Welcoming café-based build sessions that make coding and AI easier to enter. Its monthly meetups are designed for women at every experience level.',
	},
	{
		name: 'Cursor KL',
		logo: cursorLogo,
		logoClass: 'is-square',
		label: 'Cursor builders in KL',
		description:
			'The Kuala Lumpur community for people building with Cursor. Join local hackathons, workshops, and conversations with other product-minded makers.',
	},
];

const startIndex = 0;
---

<section class="community-chapter light-nav-zone" id="communities" aria-labelledby="community-title">
	<div class="community-shell">
		<div class="community-copy">
			<div class="community-heading">
				<h2 id="community-title">Malaysia's AI<br /> Communities and Events.</h2>
			</div>
			<p class="community-lede">
				A growing map of AI communities across Malaysia — meetups, builder groups, student
				chapters, and everyone in between. Join an event, find your people, or add your
				community to the list. Many gatherings are free and very welcoming.
			</p>
			<div class="community-actions">
				<a class="site-button" href={LUMA_URL}>View upcoming events</a>
				<a href={ADD_COMMUNITY_HREF}>Add your community</a>
			</div>
		</div>

		<div
			class="community-stage"
			id="community-stage"
			tabindex="0"
			aria-label="Interactive community filmstrip"
		>
			<p class="sr-only">Select a logo or use the arrow keys to browse the communities.</p>
			<div class="community-deck" id="community-deck" data-community-deck>
				{
					communities.map((community, index) => (
						<button
							class:list={['community-card', community.logoClass]}
							type="button"
							data-community-card
							data-index={String(index)}
							data-name={community.name}
							data-label={community.label}
							data-description={community.description}
							aria-label={`Focus ${community.name}, ${community.label}`}
							aria-current={index === startIndex ? 'true' : 'false'}
						>
							<span class="community-portrait">
								<Image
									src={community.logo}
									alt=""
									widths={logoWidths}
									sizes={logoSizes}
									format="webp"
									loading="lazy"
									decoding="async"
								/>
							</span>
						</button>
					))
				}
			</div>
		</div>

		<div class="community-focus" aria-live="polite" aria-atomic="true">
			<div class="community-focus-title">
				<p class="community-focus-kicker">
					<span data-community-label>{communities[startIndex].label}</span>
				</p>
				<h3 data-community-name>{communities[startIndex].name}</h3>
			</div>
			<p data-community-description>{communities[startIndex].description}</p>
		</div>

		<ul class="community-grid">
			{
				communities.map((community) => (
					<li>
						<article class="community-room">
							<figure class:list={['community-mark', community.logoClass]}>
								<Image
									src={community.logo}
									alt=""
									widths={logoWidths}
									sizes={logoSizes}
									format="webp"
									loading="lazy"
									decoding="async"
								/>
							</figure>
							<div class="community-body">
								<p class="community-label">{community.label}</p>
								<h3>{community.name}</h3>
								<p>{community.description}</p>
							</div>
						</article>
					</li>
				))
			}
		</ul>
	</div>
</section>

<script>
	let cleanUpCommunity = () => {};

	function prepareCommunitySection() {
		const desktopQuery = matchMedia('(min-width: 701px)');
		const stageElement = document.querySelector<HTMLElement>('#community-stage');
		const deck = document.querySelector<HTMLElement>('[data-community-deck]');
		const cards = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-community-card]'));
		const focusLabel = document.querySelector<HTMLElement>('[data-community-label]');
		const focusName = document.querySelector<HTMLElement>('[data-community-name]');
		const focusDescription = document.querySelector<HTMLElement>('[data-community-description]');

		const onBreakpoint = () => prepareCommunity();
		desktopQuery.addEventListener('change', onBreakpoint);

		if (!desktopQuery.matches || !stageElement || !deck || !cards.length) {
			return () => desktopQuery.removeEventListener('change', onBreakpoint);
		}

		// Hoisted function declarations below don't see the narrowing above.
		const stage: HTMLElement = stageElement;

		const count = cards.length;
		const motionPreference = matchMedia('(prefers-reduced-motion: reduce)');
		const idleMs = 2400;
		const stepMs = 2600;
		let reducedMotion = motionPreference.matches;
		let sectionIsVisible = false;
		const startIndex = 0;
		const state = {
			phase: startIndex,
			target: startIndex,
			base: startIndex,
			hovering: false,
			lastInput: performance.now(),
		};
		let lastActiveIndex = startIndex;

		function wrappedDelta(index: number, phase: number) {
			let delta = index - phase;
			while (delta > count / 2) delta -= count;
			while (delta < -count / 2) delta += count;
			return delta;
		}

		function nearestIndex() {
			return ((Math.round(state.phase) % count) + count) % count;
		}

		function moveTo(index: number) {
			const current = nearestIndex();
			let delta = index - current;
			if (delta > count / 2) delta -= count;
			if (delta < -count / 2) delta += count;
			state.base = Math.round(state.phase) + delta;
			state.target = state.base;
			state.lastInput = performance.now();
			updateFocus(index);
			lastActiveIndex = index;
			scheduleRender();
		}

		function updateFocus(index: number) {
			const card = cards[index];
			if (!card) return;
			if (focusLabel) focusLabel.textContent = card.dataset.label ?? '';
			if (focusName) focusName.textContent = card.dataset.name ?? '';
			if (focusDescription) focusDescription.textContent = card.dataset.description ?? '';
		}

		cards.forEach((card, index) => {
			card.addEventListener('click', () => moveTo(index));
			card.addEventListener('focus', () => moveTo(index));
			card.addEventListener('pointerenter', () => {
				if (state.hovering) return;
				state.hovering = true;
				state.base = state.phase;
				state.target = state.phase;
			});
			card.addEventListener('pointerleave', () => {
				if (!state.hovering) return;
				state.hovering = false;
				state.base = state.phase;
				state.target = state.phase;
				state.lastInput = performance.now();
			});
		});

		function handleKeydown(event: KeyboardEvent) {
			const target = event.target;
			const inSection =
				target instanceof Node &&
				(stage.contains(target) || document.getElementById('communities')?.contains(target));
			if (!inSection) return;

			const forward = event.key === 'ArrowRight' || event.key === 'ArrowDown';
			const backward = event.key === 'ArrowLeft' || event.key === 'ArrowUp';
			if (!forward && !backward) return;
			event.preventDefault();
			state.base += forward ? 1 : -1;
			state.target = state.base;
			state.lastInput = performance.now();
			scheduleRender();
		}

		window.addEventListener('keydown', handleKeydown);

		let previousTime = performance.now();
		let frame = 0;

		function render(time: number) {
			frame = 0;
			const deltaTime = Math.min(32, time - previousTime);
			previousTime = time;
			const ease = reducedMotion ? 1 : 1 - Math.pow(0.001, deltaTime / 1000);
			const keyboardFocus = stage.contains(document.activeElement);

			if (!reducedMotion && !state.hovering && !keyboardFocus && time - state.lastInput > idleMs) {
				const elapsed = time - state.lastInput - idleMs;
				state.target = state.base + 1 + Math.floor(elapsed / stepMs);
			}

			state.phase += (state.target - state.phase) * ease;
			const activeIndex = nearestIndex();
			const horizontalSpacing = Math.min(138, Math.max(82, innerWidth * 0.095));

			if (activeIndex !== lastActiveIndex) {
				lastActiveIndex = activeIndex;
				updateFocus(activeIndex);
			}

			cards.forEach((card, index) => {
				const delta = wrappedDelta(index, state.phase);
				const distance = Math.abs(delta);
				const focus = Math.exp(-distance * distance * 1.28);
				const side = Math.max(0, 1 - distance / 5);
				const direction = Math.sign(delta) || 0;
				const x = delta * horizontalSpacing;
				const y = distance * 6;
				const z = focus * 145 - distance * 148;
				const scale = 0.54 + side * 0.15 + focus * 0.54;
				const rotateY = -direction * (distance > 0.2 ? 9 + Math.min(distance, 3) * 3 : 0);

				card.style.setProperty('--focus', focus.toFixed(4));
				card.style.zIndex = String(Math.round(1000 - distance * 100));
				card.style.opacity = String(Math.max(0.42, side * 0.66 + focus * 0.34));
				card.style.transform = [
					'translate(-50%, -50%)',
					`translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, ${z.toFixed(2)}px)`,
					`rotateY(${rotateY.toFixed(2)}deg)`,
					`rotateZ(${(delta * 0.7).toFixed(2)}deg)`,
					`scale(${scale.toFixed(4)})`,
				].join(' ');
				card.setAttribute('aria-current', index === activeIndex ? 'true' : 'false');
			});

			if (!reducedMotion) scheduleRender();
		}

		function scheduleRender() {
			if (!frame && sectionIsVisible && !document.hidden) frame = requestAnimationFrame(render);
		}

		function updateVisibility() {
			cancelAnimationFrame(frame);
			frame = 0;
			previousTime = performance.now();
			state.lastInput = previousTime;
			scheduleRender();
		}

		function updateMotionPreference() {
			reducedMotion = motionPreference.matches;
			updateVisibility();
		}

		const observer = new IntersectionObserver(([entry]) => {
			sectionIsVisible = entry.isIntersecting;
			updateVisibility();
		});
		observer.observe(stage);
		document.addEventListener('visibilitychange', updateVisibility);
		window.addEventListener('resize', scheduleRender);
		motionPreference.addEventListener('change', updateMotionPreference);

		return () => {
			cancelAnimationFrame(frame);
			observer.disconnect();
			document.removeEventListener('visibilitychange', updateVisibility);
			window.removeEventListener('resize', scheduleRender);
			motionPreference.removeEventListener('change', updateMotionPreference);
			window.removeEventListener('keydown', handleKeydown);
			desktopQuery.removeEventListener('change', onBreakpoint);
		};
	}

	function prepareCommunity() {
		cleanUpCommunity();
		cleanUpCommunity = prepareCommunitySection();
	}

	document.addEventListener('astro:page-load', prepareCommunity);
	document.addEventListener('astro:before-swap', () => cleanUpCommunity());
</script>

<style>
	.community-chapter {
		display: grid;
		min-height: 100dvh;
		padding: clamp(4rem, 7vw, 6rem) clamp(1.5rem, 4vw, 4rem);
		align-items: center;
		color: var(--text-bright);
		background: var(--page-background);
	}

	.community-shell {
		display: grid;
		gap: clamp(1.75rem, 3vw, 2.75rem);
		width: min(92rem, 100%);
		margin: 0 auto;
	}

	.community-copy {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		align-items: center;
		width: min(42rem, 100%);
		margin: 0 auto;
		text-align: center;
	}

	.community-copy h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.2rem, 3.6vw, 3.4rem);
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 0.9;
		text-wrap: balance;
	}

	.community-lede {
		max-width: 36rem;
		margin: 0 auto;
		color: var(--text-soft);
		font-size: clamp(0.92rem, 1.25vw, 1.08rem);
		line-height: var(--leading-body);
	}

	.community-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.1rem;
		align-items: center;
		justify-content: center;
	}

	.community-actions a:not(.site-button) {
		color: inherit;
		text-underline-offset: 0.22em;
	}

	.community-actions a:focus-visible {
		outline: 2px solid var(--focus-color);
		outline-offset: 4px;
	}

	.community-stage {
		position: relative;
		width: 100%;
		height: clamp(20rem, 34dvh, 27rem);
		overflow: hidden;
		isolation: isolate;
		perspective: 1450px;
		cursor: default;
		touch-action: pan-y;
	}

	.community-stage:focus-visible {
		outline: none;
	}

	.community-deck {
		position: absolute;
		inset: 0;
		z-index: 2;
		transform-style: preserve-3d;
	}

	.community-card {
		--focus: 0;
		position: absolute;
		top: 50%;
		left: 50%;
		width: clamp(128px, 13vw, 188px);
		aspect-ratio: 1.08;
		padding: 0;
		border: 0;
		border-radius: var(--radius-media);
		color: #0d1622;
		background: transparent;
		box-shadow: 0 8px 18px rgb(0 0 0 / 0.2);
		appearance: none;
		outline: none;
		transform-style: preserve-3d;
		will-change: transform, opacity;
		cursor: pointer;
	}

	/* The focus shadow and the desaturating wash live on their own layers and only
	   animate opacity, so the per-frame loop never forces a repaint of the logo. */
	.community-card::before {
		position: absolute;
		z-index: -1;
		inset: 0;
		border-radius: var(--radius-media);
		box-shadow: 0 24px 46px rgb(0 0 0 / 0.42);
		content: '';
		opacity: var(--focus);
		pointer-events: none;
		will-change: opacity;
	}

	.community-card:focus-visible {
		box-shadow: 0 24px 48px rgb(0 0 0 / 0.48), 0 0 0 3px rgb(151 184 231 / 0.35);
	}

	.community-portrait {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		overflow: hidden;
		border-radius: var(--radius-media);
		background:
			radial-gradient(circle at 50% 40%, rgb(255 255 255 / 0.9), transparent 62%),
			#e9edf3;
	}

	.community-portrait img {
		display: block;
		width: 76%;
		height: 76%;
		object-fit: contain;
		transform: scale(calc(1.02 + (1 - var(--focus)) * 0.04));
	}

	.community-portrait::after {
		position: absolute;
		inset: 0;
		background: rgb(233 237 243 / 0.34);
		content: '';
		opacity: calc(1 - var(--focus));
		pointer-events: none;
		will-change: opacity;
	}

	.community-card.is-wide .community-portrait img {
		width: 86%;
	}

	.community-focus {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
		align-items: center;
		width: min(48rem, 100%);
		margin: 0 auto;
		padding: clamp(1.5rem, 2.5vw, 2rem) clamp(1.5rem, 4vw, 3.25rem);
		border-radius: 1.15rem;
		background: var(--card-raised);
		box-shadow: 0 20px 55px rgb(0 0 0 / 0.22);
		border: 1px solid var(--page-border);
		text-align: center;
	}

	.community-focus-kicker {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem 0.8rem;
		align-items: center;
		justify-content: center;
		margin: 0 0 0.4rem;
		color: var(--text-accent);
		font-size: 0.66rem;
		font-weight: 400;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.community-focus h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.8rem, 2.8vw, 2.65rem);
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 0.95;
	}

	.community-focus > p:last-child {
		max-width: 38rem;
		margin: 0 auto;
		color: var(--text-soft);
		font-size: clamp(0.9rem, 1.15vw, 1.02rem);
		line-height: var(--leading-body);
	}

	.community-grid {
		display: none;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 700px) {
		.community-chapter {
			min-height: auto;
			padding: 3rem 0.65rem;
		}

		.community-shell {
			gap: 1.75rem;
		}

		.community-copy {
			align-items: start;
			width: 100%;
			text-align: left;
		}

		.community-copy h2 {
			font-size: clamp(2.3rem, 10vw, 3.25rem);
		}

		.community-lede {
			max-width: none;
			margin: 0;
		}

		.community-actions {
			justify-content: start;
		}

		.community-stage,
		.community-focus {
			display: none;
		}

		.community-grid {
			display: grid;
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}

		.community-room {
			display: grid;
			grid-template-columns: 6.5rem minmax(0, 1fr);
			align-items: stretch;
			overflow: hidden;
			border: 1.5px solid var(--hairline);
			border-radius: 0.95rem;
			background: var(--card-raised);
		}

		.community-mark {
			position: relative;
			display: grid;
			margin: 0;
			min-height: 6.5rem;
			place-items: center;
			background:
				radial-gradient(circle at 50% 40%, rgb(255 255 255 / 0.9), transparent 62%),
				#e9edf3;
		}

		.community-mark img {
			display: block;
			width: 64%;
			height: auto;
			max-height: 4.2rem;
			object-fit: contain;
		}

		.community-mark.is-wide img {
			width: 78%;
		}

		.community-body {
			display: grid;
			gap: 0.4rem;
			align-content: start;
			min-width: 0;
			padding: 0.9rem 0.95rem 1rem 0.85rem;
		}

		.community-label {
			margin: 0;
			color: var(--text-accent);
			font-size: 0.66rem;
			letter-spacing: 0.12em;
			text-transform: uppercase;
		}

		.community-body h3 {
			margin: 0;
			font-family: var(--font-display);
			font-size: 1.35rem;
			font-weight: 400;
			letter-spacing: -0.03em;
			line-height: 1;
		}

		.community-body p:last-child {
			margin: 0;
			color: var(--text-soft);
			font-size: 0.86rem;
			line-height: var(--leading-body);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.community-card,
		.community-card::before,
		.community-portrait::after {
			will-change: auto;
		}
	}
</style>
