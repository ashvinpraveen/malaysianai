---
import { Image } from 'astro:assets';
import { LUMA_URL } from '../consts';
import { communities } from '../data/communities';

// Logos render at most ~145px wide on desktop and ~85px on mobile.
const logoWidths = [200, 400];
const logoSizes = '200px';

const startIndex = 0;
---

<section class="community-chapter light-nav-zone" id="communities" aria-labelledby="community-title">
	<div class="community-shell">
		<div class="community-copy">
			<div class="community-heading">
				<h2 id="community-title">Discover the AI<br /> communities for you</h2>
			</div>
			<p class="community-lede">
				From deeply technical coding events for developers, to workshops for creators,
				business owners, students and women building your first apps &amp; AI agents; there's a
				community of people here to help you along your AI journey. Global networks are listed
				through the Malaysian chapter or edition you can join.
			</p>
		</div>

		<div class="community-board">
			<div
				class="community-stage"
				id="community-stage"
				tabindex="0"
				aria-label="Interactive community filmstrip"
			>
				<p class="sr-only">Select a logo or use the arrow keys to browse the communities.</p>
				<div class="community-deck" id="community-deck" data-community-deck>
					{
						communities.map((community, index) => (
							<button
								class:list={['community-card', community.logoClass]}
								type="button"
								data-community-card
								data-index={String(index)}
								data-name={community.name}
								data-qualifier={community.qualifier}
								data-description={community.description}
								data-href={community.href}
								aria-label={`Focus ${community.name}, ${community.qualifier}`}
								aria-current={index === startIndex ? 'true' : 'false'}
							>
								<span class="community-portrait">
									<Image
										src={community.logo}
										alt=""
										widths={logoWidths}
										sizes={logoSizes}
										format="webp"
										loading="lazy"
										decoding="async"
									/>
								</span>
							</button>
						))
					}
				</div>
			</div>

			<div class="community-focus" aria-live="polite" aria-atomic="true">
				<div class="community-focus-title">
					<p class="community-focus-kicker">
						<span data-community-qualifier>{communities[startIndex].qualifier}</span>
					</p>
					<h3 data-community-name>{communities[startIndex].name}</h3>
				</div>
				<p data-community-description>{communities[startIndex].description}</p>
				<a data-community-link href={communities[startIndex].href}>
					Visit {communities[startIndex].name}
				</a>
			</div>
			<div class="community-actions">
				<a class="site-button" href={LUMA_URL}>View upcoming events</a>
			</div>
		</div>
	</div>
</section>

<script>
	let cleanUpCommunity = () => {};

	function prepareCommunitySection() {
		const sectionElement = document.getElementById('communities');
		const stageElement = document.querySelector<HTMLElement>('#community-stage');
		const deck = document.querySelector<HTMLElement>('[data-community-deck]');
		const cards = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-community-card]'));
		const focusQualifier = document.querySelector<HTMLElement>('[data-community-qualifier]');
		const focusName = document.querySelector<HTMLElement>('[data-community-name]');
		const focusDescription = document.querySelector<HTMLElement>('[data-community-description]');
		const focusLink = document.querySelector<HTMLAnchorElement>('[data-community-link]');

		if (!sectionElement || !stageElement || !deck || !cards.length) return () => {};

		const section: HTMLElement = sectionElement;
		const stage: HTMLElement = stageElement;
		const count = cards.length;
		const motionPreference = matchMedia('(prefers-reduced-motion: reduce)');
		const autoplayMs = 6000;
		let reducedMotion = motionPreference.matches;
		let sectionIsVisible = false;
		const startIndex = 0;
		const state = {
			phase: startIndex,
			target: startIndex,
			hovering: false,
		};
		let lastActiveIndex = startIndex;
		let previousTime = performance.now();
		let frame = 0;
		let autoplayTimer = 0;

		function wrappedDelta(index: number, phase: number) {
			let delta = index - phase;
			while (delta > count / 2) delta -= count;
			while (delta < -count / 2) delta += count;
			return delta;
		}

		function nearestIndex() {
			return ((Math.round(state.phase) % count) + count) % count;
		}

		function clearAutoplay() {
			if (!autoplayTimer) return;
			window.clearTimeout(autoplayTimer);
			autoplayTimer = 0;
		}

		function autoplayPaused() {
			return (
				reducedMotion ||
				!sectionIsVisible ||
				document.hidden ||
				state.hovering ||
				section.contains(document.activeElement)
			);
		}

		function armAutoplay() {
			clearAutoplay();
			if (autoplayPaused()) return;
			// One timeout at a time. Never derive catch-up steps from wall-clock idle time.
			autoplayTimer = window.setTimeout(() => {
				autoplayTimer = 0;
				if (autoplayPaused()) return;
				state.target = Math.round(state.phase) + 1;
				scheduleRender();
				armAutoplay();
			}, autoplayMs);
		}

		function moveTo(index: number) {
			const current = nearestIndex();
			let delta = index - current;
			if (delta > count / 2) delta -= count;
			if (delta < -count / 2) delta += count;
			state.target = Math.round(state.phase) + delta;
			updateFocus(index);
			lastActiveIndex = index;
			scheduleRender();
			armAutoplay();
		}

		function updateFocus(index: number) {
			const card = cards[index];
			if (!card) return;
			const name = card.dataset.name ?? '';
			if (focusQualifier) focusQualifier.textContent = card.dataset.qualifier ?? '';
			if (focusName) focusName.textContent = name;
			if (focusDescription) focusDescription.textContent = card.dataset.description ?? '';
			if (focusLink) {
				focusLink.href = card.dataset.href ?? '';
				focusLink.textContent = `Visit ${name}`;
			}
		}

		function cardIndexAtPoint(clientX: number, clientY: number) {
			// Transformed cards share overlapping AABBs. Prefer the smallest box that
			// contains the point so the scaled-up center does not steal side clicks.
			let bestIndex = -1;
			let bestScore = Number.POSITIVE_INFINITY;
			cards.forEach((card, index) => {
				const rect = card.getBoundingClientRect();
				if (
					clientX < rect.left ||
					clientX > rect.right ||
					clientY < rect.top ||
					clientY > rect.bottom
				) {
					return;
				}
				const area = Math.max(1, rect.width * rect.height);
				const dx = clientX - (rect.left + rect.width / 2);
				const dy = clientY - (rect.top + rect.height / 2);
				const score = area + (dx * dx + dy * dy) * 0.2;
				if (score < bestScore) {
					bestScore = score;
					bestIndex = index;
				}
			});
			return bestIndex;
		}

		function handlePointerDown(event: PointerEvent) {
			if (event.button !== 0) return;
			const index = cardIndexAtPoint(event.clientX, event.clientY);
			if (index < 0 || index === nearestIndex()) return;
			event.preventDefault();
			moveTo(index);
		}

		function handleFocusIn(event: FocusEvent) {
			const target = event.target;
			if (!(target instanceof HTMLElement)) return;
			const index = cards.indexOf(target as HTMLButtonElement);
			if (index >= 0) moveTo(index);
			else armAutoplay();
		}

		function handleFocusOut() {
			window.queueMicrotask(() => armAutoplay());
		}

		function setHovering(next: boolean) {
			if (state.hovering === next) return;
			state.hovering = next;
			armAutoplay();
		}

		const onPointerEnter = () => setHovering(true);
		const onPointerLeave = () => setHovering(false);

		deck.addEventListener('pointerdown', handlePointerDown);
		stage.addEventListener('pointerenter', onPointerEnter);
		stage.addEventListener('pointerleave', onPointerLeave);
		section.addEventListener('focusin', handleFocusIn);
		section.addEventListener('focusout', handleFocusOut);

		function handleKeydown(event: KeyboardEvent) {
			const target = event.target;
			const inSection =
				target instanceof Node &&
				(stage.contains(target) || document.getElementById('communities')?.contains(target));
			if (!inSection) return;

			const forward = event.key === 'ArrowRight' || event.key === 'ArrowDown';
			const backward = event.key === 'ArrowLeft' || event.key === 'ArrowUp';
			if (!forward && !backward) return;
			event.preventDefault();
			state.target = Math.round(state.phase) + (forward ? 1 : -1);
			scheduleRender();
			armAutoplay();
		}

		window.addEventListener('keydown', handleKeydown);

		function render(time: number) {
			frame = 0;
			const deltaTime = Math.min(32, time - previousTime);
			previousTime = time;
			const ease = reducedMotion ? 1 : 1 - Math.pow(0.001, deltaTime / 1000);

			state.phase += (state.target - state.phase) * ease;
			const activeIndex = nearestIndex();
			// Outer cards sit just past the stage edge, so the blur runs off the card
			// instead of stopping in a cream margin. Perspective pulls distant cards inward.
			const outerDistance = count / 2 - 0.5;
			const projection = 1200 / (1200 + outerDistance * 72);
			const horizontalSpacing = Math.max(
				52,
				(stage.clientWidth / 2 + 28) / (outerDistance * projection),
			);

			if (activeIndex !== lastActiveIndex) {
				lastActiveIndex = activeIndex;
				updateFocus(activeIndex);
			}

			cards.forEach((card, index) => {
				const delta = wrappedDelta(index, state.phase);
				const distance = Math.abs(delta);
				const focus = Math.exp(-distance * distance * 1.28);
				const side = Math.max(0, 1 - distance / 5);
				const direction = Math.sign(delta) || 0;
				const x = delta * horizontalSpacing;
				const y = distance * 2;
				const z = focus * 64 - distance * 72;
				const scale = 0.7 + side * 0.08 + focus * 0.36;
				const rotateY = -direction * (distance > 0.2 ? 6 + Math.min(distance, 2) * 2 : 0);

				card.style.setProperty('--focus', focus.toFixed(4));
				card.style.zIndex = String(Math.round(1000 - distance * 100));
				card.style.opacity = '1';
				const blur = distance < 0.45 ? 0 : Math.min(3, (distance - 0.2) * (distance - 0.2) * 0.55);
				card.style.filter = blur === 0 ? 'none' : `blur(${blur.toFixed(2)}px)`;
				card.style.transform = [
					'translate(-50%, -50%)',
					`translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, ${z.toFixed(2)}px)`,
					`rotateY(${rotateY.toFixed(2)}deg)`,
					`rotateZ(${(delta * 0.28).toFixed(2)}deg)`,
					`scale(${scale.toFixed(4)})`,
				].join(' ');
				card.setAttribute('aria-current', index === activeIndex ? 'true' : 'false');
			});

			if (!reducedMotion && Math.abs(state.target - state.phase) > 0.001) scheduleRender();
		}

		function scheduleRender() {
			if (!frame && sectionIsVisible && !document.hidden) frame = requestAnimationFrame(render);
		}

		function updateVisibility() {
			cancelAnimationFrame(frame);
			frame = 0;
			previousTime = performance.now();
			scheduleRender();
			armAutoplay();
		}

		function updateMotionPreference() {
			reducedMotion = motionPreference.matches;
			updateVisibility();
		}

		const observer = new IntersectionObserver(([entry]) => {
			sectionIsVisible = entry.isIntersecting;
			updateVisibility();
		});
		observer.observe(stage);
		document.addEventListener('visibilitychange', updateVisibility);
		window.addEventListener('resize', scheduleRender);
		motionPreference.addEventListener('change', updateMotionPreference);
		armAutoplay();

		return () => {
			clearAutoplay();
			cancelAnimationFrame(frame);
			observer.disconnect();
			document.removeEventListener('visibilitychange', updateVisibility);
			window.removeEventListener('resize', scheduleRender);
			motionPreference.removeEventListener('change', updateMotionPreference);
			window.removeEventListener('keydown', handleKeydown);
			deck.removeEventListener('pointerdown', handlePointerDown);
			stage.removeEventListener('pointerenter', onPointerEnter);
			stage.removeEventListener('pointerleave', onPointerLeave);
			section.removeEventListener('focusin', handleFocusIn);
			section.removeEventListener('focusout', handleFocusOut);
		};
	}

	function prepareCommunity() {
		cleanUpCommunity();
		cleanUpCommunity = prepareCommunitySection();
	}

	document.addEventListener('astro:page-load', prepareCommunity);
	document.addEventListener('astro:before-swap', () => cleanUpCommunity());
</script>

<style>
	.community-chapter {
		display: grid;
		padding: var(--section-space) clamp(1.5rem, 4vw, 4rem) var(--section-space-half);
		color: var(--text-bright);
		background: var(--page-background);
	}

	.community-shell {
		display: grid;
		gap: clamp(1.25rem, 2.4vw, 1.75rem);
		width: min(92rem, 100%);
		margin: 0 auto;
	}

	.community-copy {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: center;
		width: min(40rem, 100%);
		margin: 0 auto;
		text-align: center;
	}

	.community-copy h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.2rem, 3.6vw, 3.4rem);
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 1.05;
		text-wrap: balance;
	}

	.community-lede {
		max-width: 36rem;
		margin: 0;
		color: var(--text-soft);
		font-size: clamp(0.92rem, 1.25vw, 1.08rem);
		line-height: var(--leading-body);
	}

	.community-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.1rem;
		align-items: center;
		justify-content: center;
		margin-top: 1.15rem;
	}

	.community-actions a:focus-visible {
		outline: 2px solid var(--focus-color);
		outline-offset: 4px;
	}

	.community-board {
		display: grid;
		gap: 0.15rem;
		width: min(68rem, 100%);
		margin: 0.75rem auto 0;
		padding: 1.35rem clamp(1.25rem, 2.8vw, 2.25rem) 2.1rem;
		overflow: hidden;
		border: 1px solid var(--hairline-soft);
		border-radius: 1.5rem;
		background: var(--card-raised);
	}

	.community-stage {
		position: relative;
		width: auto;
		height: clamp(11.5rem, 22dvh, 15rem);
		margin-inline: calc(clamp(1.25rem, 2.8vw, 2.25rem) * -1);
		overflow: hidden;
		isolation: isolate;
		perspective: 1200px;
		cursor: default;
		touch-action: pan-y;
	}

	.community-stage:focus-visible {
		outline: none;
	}

	.community-deck {
		position: absolute;
		inset: 0;
		z-index: 2;
		transform-style: preserve-3d;
		cursor: pointer;
	}

	.community-card {
		--focus: 0;
		position: absolute;
		top: 50%;
		left: 50%;
		width: clamp(104px, 11vw, 148px);
		aspect-ratio: 1.08;
		padding: 0;
		border: 0;
		border-radius: var(--radius-media);
		color: #0d1622;
		background: transparent;
		box-shadow: none;
		appearance: none;
		outline: none;
		transform-style: preserve-3d;
		will-change: transform, filter;
		cursor: pointer;
		/* Clicks hit the deck; JS picks the nearest visual card under the pointer. */
		pointer-events: none;
	}

	.community-card:focus-visible {
		outline: 2px solid var(--focus-color);
		outline-offset: 3px;
	}

	.community-portrait {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		overflow: hidden;
		border: 1px solid var(--hairline-soft);
		border-radius: var(--radius-media);
		background: #fffdf8;
	}

	.community-portrait img {
		display: block;
		width: 76%;
		height: 76%;
		object-fit: contain;
		transform: scale(calc(1.02 + (1 - var(--focus)) * 0.04));
	}

	.community-card.is-wide .community-portrait img {
		width: 86%;
	}

	.community-card.is-dark .community-portrait {
		background: #111;
	}

	.community-focus {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		align-items: center;
		width: min(36rem, 100%);
		margin: 0 auto;
		text-align: center;
	}

	.community-focus-kicker {
		margin: 0 0 0.85rem;
		color: var(--text-accent);
		font-size: 0.66rem;
		font-weight: 400;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.community-focus h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.55rem, 2.2vw, 2rem);
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.05;
	}

	.community-focus [data-community-description] {
		max-width: 34rem;
		min-height: 3lh;
		margin: 0 auto;
		color: var(--text-soft);
		font-size: clamp(0.9rem, 1.15vw, 1.02rem);
		line-height: var(--leading-body);
	}

	.community-focus [data-community-link] {
		color: var(--text-accent);
		font-size: 0.9rem;
		text-underline-offset: 0.22em;
	}

	.community-focus [data-community-link]:focus-visible {
		outline: 2px solid var(--focus-color);
		outline-offset: 4px;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 700px) {
		.community-chapter {
			padding: 4.75rem 0.65rem 3rem;
		}

		.community-copy h2 {
			font-size: clamp(2.3rem, 10vw, 3.25rem);
		}

		.community-board {
			padding: 1.65rem 1.75rem 2rem;
		}

		.community-stage {
			height: 12.5rem;
			margin-inline: -1.75rem;
		}

		.community-focus > p:last-child {
			min-height: 4lh;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.community-card {
			will-change: auto;
		}
	}
</style>
