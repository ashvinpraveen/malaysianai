---
import { Image, getImage } from 'astro:assets';
import { LUMA_URL } from '../consts';
import showAndTell from '../assets/events/show-and-tell-supabase-ceo.jpg';
import learnathon from '../assets/events/aimto-learnathon.jpg';
import hackathon from '../assets/events/anthropic-cursor-hackathon-malaysia.png';
import workshops from '../assets/events/workshops.jpg';
import allAges from '../assets/events/all-ages.jpg';

const sources = [
	{
		title: 'Show & Tell with the Supabase CEO',
		type: 'Founder show & tell',
		date: 'Ideas, demos, and conversation',
		image: showAndTell,
		position: 'center center',
	},
	{
		title: 'AIMTO Learnathon',
		type: 'Hands-on learnathon',
		date: 'AI Malaysia Takeover 2026',
		image: learnathon,
		position: 'center center',
	},
	{
		title: 'Anthropic × Cursor Hackathon Malaysia',
		type: 'Community hackathon',
		date: 'Built in Malaysia',
		image: hackathon,
		position: 'center 56%',
	},
	{
		title: 'Workshops',
		type: 'Hands-on learning',
		date: 'Learn with local builders',
		image: workshops,
		position: 'center 42%',
	},
	{
		title: 'AI for Every Age',
		type: 'Open to everyone',
		date: 'All ages, all experience levels',
		image: allAges,
		position: 'center center',
	},
];

// The background is swapped from JS, so pre-generate a responsive set for each event.
const events = await Promise.all(sources.map(async event => {
	// Cap at source width (~2200 for most JPGs; the Show & Tell original is 3840).
	const background = await getImage({
		src: event.image,
		widths: [960, 1440, 1920, 2560, 3840],
		format: 'webp',
		quality: 90,
	});
	return { ...event, background };
}));
const backgroundSizes = '100vw';
---

<section class="events-section" id="events" aria-labelledby="events-title" data-events>
	<div class="events-frame">
		<div class="events-copy-panel">
			<div class="events-header">
				<h2 id="events-title">There is always<br />something happening.</h2>
				<a class="events-calendar-link site-button" href={LUMA_URL}>
					See the event calendar
					<span aria-hidden="true">↗</span>
				</a>
			</div>

			<div class="events-selected" aria-live="polite" aria-atomic="true">
				<h3 data-event-title>{events[0].title}</h3>
				<p data-event-date>{events[0].date}</p>
			</div>
		</div>

		<div class="events-visual">
			<div class="events-background" aria-hidden="true">
				<img
					class="events-background-image is-visible"
					data-events-background="0"
					src={events[0].background.src}
					srcset={events[0].background.srcSet.attribute}
					sizes={backgroundSizes}
					width={events[0].background.attributes.width}
					height={events[0].background.attributes.height}
					alt=""
					loading="lazy"
					decoding="async"
					style={`object-position: ${events[0].position}`}
				/>
				<img
					class="events-background-image"
					data-events-background="1"
					sizes={backgroundSizes}
					width={events[1].background.attributes.width}
					height={events[1].background.attributes.height}
					alt=""
					loading="lazy"
					decoding="async"
					style={`object-position: ${events[1].position}`}
				/>
				<div class="events-background-wash"></div>
			</div>

			<svg
				class="events-outline"
				viewBox="0 0 1000 1000"
				preserveAspectRatio="none"
				aria-hidden="true"
			>
				<path class="events-outline-matte" fill-rule="evenodd" />
				<path class="events-outline-line" />
			</svg>

			<div class="events-deck" data-events-deck>
				{events.map((event, index) => (
					<button
						class:list={['event-card', { 'is-active': index === 0 }]}
						type="button"
						data-event-card
						data-index={index}
						data-title={event.title}
						data-type={event.type}
						data-date={event.date}
						data-image={event.background.src}
						data-srcset={event.background.srcSet.attribute}
						data-position={event.position}
						aria-label={`Show ${event.title}`}
						aria-pressed={index === 0 ? 'true' : 'false'}
					>
						<span class="event-card-image-wrap">
							<Image
								class="event-card-image"
								src={event.image}
								alt=""
								widths={[360, 720, 1080]}
								sizes="(max-width: 800px) 6rem, 7.5rem"
								format="webp"
								quality={90}
								loading="lazy"
								decoding="async"
								style={`object-position: ${event.position}`}
							/>
						</span>
						<span class="event-card-caption">
							<span>{String(index + 1).padStart(2, '0')}</span>
							<strong>{event.title}</strong>
						</span>
					</button>
				))}
			</div>
		</div>
	</div>
</section>

<script>
	let cleanUpEvents = () => {};

	function roundCoord(value: number) {
		return Math.round(value * 100) / 100;
	}

	function relativeBox(origin: DOMRect, element: Element) {
		const box = element.getBoundingClientRect();
		const transform = getComputedStyle(element).transform;
		let shiftX = 0;
		let shiftY = 0;
		if (transform && transform !== 'none') {
			const matrix = new DOMMatrixReadOnly(transform);
			shiftX = matrix.m41;
			shiftY = matrix.m42;
		}
		return {
			l: box.left - origin.left - shiftX,
			t: box.top - origin.top - shiftY,
			r: box.right - origin.left - shiftX,
			b: box.bottom - origin.top - shiftY,
		};
	}

	function pixelLength(element: HTMLElement, value: string) {
		const probe = document.createElement('div');
		probe.style.cssText = `position:absolute;visibility:hidden;pointer-events:none;width:${value};font-size:${getComputedStyle(element).fontSize}`;
		document.body.append(probe);
		const pixels = probe.getBoundingClientRect().width;
		probe.remove();
		return pixels;
	}

	function drawEventsOutline(section: HTMLElement) {
		const visual = section.querySelector<HTMLElement>('.events-visual');
		const background = section.querySelector<HTMLElement>('.events-background');
		const svg = section.querySelector<SVGSVGElement>('.events-outline');
		const matte = svg?.querySelector<SVGPathElement>('.events-outline-matte');
		const line = svg?.querySelector<SVGPathElement>('.events-outline-line');
		const header = section.querySelector<HTMLElement>('.events-header');
		const selected = section.querySelector<HTMLElement>('.events-selected');
		if (!visual || !background || !svg || !matte || !line || !header || !selected) return;

		const desktop = window.matchMedia('(min-width: 801px)').matches;
		if (!desktop) {
			svg.style.display = 'none';
			matte.removeAttribute('d');
			line.removeAttribute('d');
			background.style.clipPath = '';
			delete svg.dataset.headerBottom;
			delete svg.dataset.headerRight;
			delete svg.dataset.selectedLeft;
			delete svg.dataset.selectedBottom;
			return;
		}

		const origin = visual.getBoundingClientRect();
		const width = origin.width;
		const height = origin.height;
		if (width < 8 || height < 8) return;

		svg.style.display = '';
		const styles = getComputedStyle(section);
		const gap = pixelLength(section, styles.getPropertyValue('--events-gap').trim() || '1rem') || 16;
		const radius = Math.min(
			pixelLength(section, styles.getPropertyValue('--events-radius').trim() || '0.95rem') || 15,
			width / 6,
			height / 6,
		);
		const headerBox = relativeBox(origin, header);
		const selectedBox = relativeBox(origin, selected);
		const n = (value: number) => roundCoord(value).toString();
		const move = (x: number, y: number) => `M ${n(x)} ${n(y)}`;
		const lineTo = (x: number, y: number) => `L ${n(x)} ${n(y)}`;
		const quarter = (
			fromX: number,
			fromY: number,
			centerX: number,
			centerY: number,
			toX: number,
			toY: number,
		) => {
			const cross = (fromX - centerX) * (toY - centerY) - (fromY - centerY) * (toX - centerX);
			return `A ${n(radius)} ${n(radius)} 0 0 ${cross > 0 ? 1 : 0} ${n(toX)} ${n(toY)}`;
		};

		const g = gap;
		const r = radius;
		let hx = Math.max(headerBox.r, g + r * 2);
		const hy = Math.max(headerBox.b, g + r * 2);
		let sx = Math.min(selectedBox.l, width - g - r * 2);
		const sy = Math.max(selectedBox.b, g + r * 2);
		if (sx < hx + r * 2) {
			const mid = (hx + sx) / 2;
			hx = mid - r;
			sx = mid + r;
		}

		const hole = [
			move(hx + r, g),
			lineTo(sx - r, g),
			quarter(sx - r, g, sx - r, g + r, sx, g + r),
			lineTo(sx, sy - r),
			quarter(sx, sy - r, sx + r, sy - r, sx + r, sy),
			lineTo(width - g - r, sy),
			quarter(width - g - r, sy, width - g - r, sy + r, width - g, sy + r),
			lineTo(width - g, height - g - r),
			quarter(width - g, height - g - r, width - g - r, height - g - r, width - g - r, height - g),
			lineTo(g + r, height - g),
			quarter(g + r, height - g, g + r, height - g - r, g, height - g - r),
			lineTo(g, hy + r),
			quarter(g, hy + r, g + r, hy + r, g + r, hy),
			lineTo(hx - r, hy),
			quarter(hx - r, hy, hx - r, hy - r, hx, hy - r),
			lineTo(hx, g + r),
			quarter(hx, g + r, hx + r, g + r, hx + r, g),
			'Z',
		].join(' ');

		svg.setAttribute('viewBox', `0 0 ${n(width)} ${n(height)}`);
		matte.setAttribute('d', `M 0 0 H ${n(width)} V ${n(height)} H 0 Z ${hole}`);
		line.setAttribute('d', hole);
		background.style.clipPath = `path("${hole}")`;
		svg.dataset.headerBottom = n(hy);
		svg.dataset.headerRight = n(hx);
		svg.dataset.selectedLeft = n(sx);
		svg.dataset.selectedBottom = n(sy);
	}

	function prepareEventSection(section: HTMLElement) {
		const cards = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-event-card]'));
		const backgrounds = Array.from(
			section.querySelectorAll<HTMLImageElement>('[data-events-background]'),
		);
		const title = section.querySelector<HTMLElement>('[data-event-title]');
		const date = section.querySelector<HTMLElement>('[data-event-date]');
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const slots = [0, 1, 2, -2, -1];
		let selectedIndex = 0;
		let visibleBackground = 0;
		let changeSequence = 0;
		let sectionIsVisible = false;
		let hoveringCard = false;
		let rotationTimer: number | undefined;
		let outlineFrame = 0;
		const controller = new AbortController();
		const { signal } = controller;
		const warmedImages = new Map<string, HTMLImageElement>();
		const header = section.querySelector<HTMLElement>('.events-header');
		const selected = section.querySelector<HTMLElement>('.events-selected');
		const visual = section.querySelector<HTMLElement>('.events-visual');

		function scheduleOutline() {
			cancelAnimationFrame(outlineFrame);
			outlineFrame = requestAnimationFrame(() => drawEventsOutline(section));
		}

		function warmNextBackground() {
			if (reduceMotion.matches || document.hidden) return;
			const card = cards[(selectedIndex + 1) % cards.length];
			const src = card?.dataset.image;
			if (!src || warmedImages.has(src)) return;
			const image = new window.Image();
			image.sizes = backgrounds[0]?.sizes || '100vw';
			image.srcset = card.dataset.srcset ?? '';
			image.src = src;
			warmedImages.set(src, image);
		}

		function stopRotation() {
			if (rotationTimer === undefined) return;
			window.clearInterval(rotationTimer);
			rotationTimer = undefined;
		}

		function startRotation() {
			stopRotation();
			const keyboardFocus = cards.some(card => card.matches(':focus-visible'));
			if (!sectionIsVisible || document.hidden || reduceMotion.matches || hoveringCard || keyboardFocus || cards.length < 2) {
				return;
			}

			rotationTimer = window.setInterval(() => {
				void selectEvent((selectedIndex + 1) % cards.length);
			}, 4_000);
		}

		function layoutCards() {
			cards.forEach((card, index) => {
				const order = (index - selectedIndex + cards.length) % cards.length;
				const slot = slots[order] ?? order;
				const distance = Math.abs(slot);

				card.style.setProperty('--event-slot', String(slot));
				card.style.setProperty('--event-distance', String(distance));
				card.style.setProperty('--event-layer', String(cards.length - distance));
				card.classList.toggle('is-active', index === selectedIndex);
				card.setAttribute('aria-pressed', index === selectedIndex ? 'true' : 'false');
			});
		}

		async function selectEvent(index: number) {
			const card = cards[index];
			if (!card || index === selectedIndex) return;
			const currentChange = ++changeSequence;

			selectedIndex = index;
			layoutCards();

			if (title) title.textContent = card.dataset.title ?? '';
			if (date) date.textContent = card.dataset.date ?? '';
			scheduleOutline();

			const nextBackgroundIndex = visibleBackground === 0 ? 1 : 0;
			const nextBackground = backgrounds[nextBackgroundIndex];
			const currentBackground = backgrounds[visibleBackground];
			if (!nextBackground || !currentBackground || !card.dataset.image) return;

			nextBackground.srcset = card.dataset.srcset ?? '';
			nextBackground.src = card.dataset.image;
			nextBackground.style.objectPosition = card.dataset.position ?? 'center';
			try {
				await nextBackground.decode();
			} catch {
				return; // Keep the previous photo visible if the replacement fails.
			}
			if (currentChange !== changeSequence) return;

			nextBackground.classList.add('is-visible');
			currentBackground.classList.remove('is-visible');
			visibleBackground = nextBackgroundIndex;
			if (sectionIsVisible) warmNextBackground();
		}

		cards.forEach((card, index) => {
			card.addEventListener('pointerenter', event => {
				if (event.pointerType !== 'mouse') return;
				hoveringCard = true;
				startRotation();
			}, { signal });
			card.addEventListener('pointerleave', event => {
				if (event.pointerType !== 'mouse') return;
				hoveringCard = false;
				startRotation();
			}, { signal });
			card.addEventListener('click', () => {
				void selectEvent(index);
				startRotation();
			}, { signal });
		});

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					sectionIsVisible = entry.isIntersecting;
					if (entry.isIntersecting) {
						section.classList.add('is-in-view');
						startRotation();
						scheduleOutline();
					} else {
						stopRotation();
					}
				});
			},
			{ threshold: 0.18 },
		);
		// Give the next slide a head start near the section, without competing
		// with the hero on initial navigation.
		const preloadObserver = new IntersectionObserver(([entry]) => {
			if (!entry.isIntersecting) return;
			warmNextBackground();
			preloadObserver.disconnect();
		}, { rootMargin: '400px' });
		preloadObserver.observe(section);

		layoutCards();
		observer.observe(section);
		const outlineObserver = new ResizeObserver(scheduleOutline);
		outlineObserver.observe(section);
		if (visual) outlineObserver.observe(visual);
		if (header) outlineObserver.observe(header);
		if (selected) outlineObserver.observe(selected);
		window.addEventListener('resize', scheduleOutline, { signal });
		void document.fonts?.ready.then(scheduleOutline);
		window.setTimeout(scheduleOutline, 1400);
		scheduleOutline();
		document.addEventListener('visibilitychange', startRotation);
		reduceMotion.addEventListener('change', startRotation);
		section.addEventListener('focusin', startRotation, { signal });
		section.addEventListener('focusout', () => {
			// Wait until the browser has moved focus to the next element.
			window.queueMicrotask(() => {
				if (!signal.aborted) startRotation();
			});
		}, { signal });

		return () => {
			stopRotation();
			cancelAnimationFrame(outlineFrame);
			observer.disconnect();
			preloadObserver.disconnect();
			outlineObserver.disconnect();
			controller.abort();
			reduceMotion.removeEventListener('change', startRotation);
			changeSequence++;
			document.removeEventListener('visibilitychange', startRotation);
		};
	}

	function prepareEvents() {
		cleanUpEvents();
		const cleanups = Array.from(
			document.querySelectorAll<HTMLElement>('[data-events]'),
			prepareEventSection,
		);

		cleanUpEvents = () => cleanups.forEach(cleanup => cleanup());
	}

	document.addEventListener('astro:page-load', prepareEvents);
	document.addEventListener('astro:before-swap', () => cleanUpEvents());
</script>

<style>
	.events-section {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		color: var(--text-heading);
		background: var(--page-background);
		min-height: 100dvh;
		padding: 0;
		--events-gap: 1rem;
		--events-radius: 0.95rem;
	}

	.events-section.is-in-view .events-header {
		transform: translateY(0);
		opacity: 1;
	}

	.events-selected p,
	.events-selected h3 {
		margin: 0;
	}

	.events-selected p {
		text-transform: uppercase;
		color: var(--text-muted);
		font-size: 0.68rem;
		font-weight: 400;
		letter-spacing: 0.09em;
		text-shadow: 0 0.1rem 0.8rem var(--hero-copy-shadow-color);
	}

	.event-card {
		position: absolute;
		bottom: 0;
		left: 50%;
		z-index: var(--event-layer, 1);
		display: block;
		margin: 0;
		overflow: hidden;
		color: var(--color-white);
		font: inherit;
		text-align: left;
		cursor: pointer;
		pointer-events: auto;
		transform-origin: 50% 100%;
		opacity: 0;
		transition: transform 760ms cubic-bezier(0.2, 0.8, 0.2, 1),
			opacity 500ms ease,
			box-shadow 300ms ease,
			border-color 300ms ease;
		will-change: transform;
		aspect-ratio: 0.78;
		border: 1px solid rgb(115 152 207 / 0.52);
		--preview-lift: 0rem;
		--preview-scale: 1;
		width: clamp(5.75rem, 7.4vw, 7.5rem);
		padding: 0.25rem;
		border-color: rgb(151 184 231 / 0.42);
		border-radius: 0.6rem;
		background: rgb(6 9 15 / 0.82);
		box-shadow: 0 0.75rem 1.75rem rgb(0 0 0 / 0.34);
		transform: translateX(calc(-50% + var(--event-slot, 0) * min(8.4vw, 8.4rem)))
			translateY(calc(var(--event-distance, 0) * 0.45rem + var(--preview-lift)))
			rotate(calc(var(--event-slot, 0) * 1.5deg))
			scale(calc(var(--preview-scale) - var(--event-distance, 0) * 0.035));
	}

	.events-section.is-in-view .event-card:nth-child(1) {
		transition-delay: 60ms;
	}

	.events-section.is-in-view .event-card:nth-child(2) {
		transition-delay: 110ms;
	}

	.events-section.is-in-view .event-card:nth-child(3) {
		transition-delay: 160ms;
	}

	.events-section.is-in-view .event-card:nth-child(4) {
		transition-delay: 210ms;
	}

	.events-section.is-in-view .event-card:nth-child(5) {
		transition-delay: 260ms;
	}

	.event-card:hover,
	.event-card:focus-visible {
		box-shadow: 0 1.8rem 5rem rgb(0 0 0 / 0.55);
	}

	.event-card:focus-visible {
		outline-offset: 4px;
		outline: 2px solid var(--focus-color);
	}

	.event-card-image-wrap {
		display: block;
		overflow: hidden;
		width: 100%;
		background: var(--surface-background);
		height: 100%;
		border-radius: 0.4rem;
	}

	.event-card-image {
		display: block;
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
		transform: scale(1.04);
		transition: transform 900ms cubic-bezier(0.2, 0.75, 0.2, 1), filter 400ms ease;
	}

	.event-card:not(.is-active) .event-card-image {
		filter: saturate(72%) brightness(0.78);
	}

	.event-card:hover .event-card-image,
	.event-card:focus-visible .event-card-image,
	.event-card.is-active .event-card-image {
		transform: scale(1);
	}

	.events-frame {
		position: relative;
		overflow: hidden;
		background: var(--page-background);
		display: block;
		min-height: 100dvh;
		border: 0;
		border-radius: 0;
	}

	.events-copy-panel {
		min-width: 0;
		position: absolute;
		z-index: 4;
		inset: 0;
		display: block;
		padding: 0;
		border: 0;
		background: transparent;
		pointer-events: none;
	}

	.events-visual {
		isolation: isolate;
		min-width: 0;
		overflow: hidden;
		background: var(--page-background);
		position: absolute;
		inset: 0;
		min-height: 100dvh;
	}

	.events-background,
	.events-background-image,
	.events-background-wash {
		position: absolute;
		inset: 0;
	}

	.events-background {
		z-index: 0;
		overflow: hidden;
	}

	.events-background-image {
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
		filter: saturate(76%) contrast(1.03);
		transform: scale(1.025);
		opacity: 0;
		transition: opacity 700ms ease, transform 6s ease;
	}

	.events-background-image.is-visible {
		transform: scale(1);
		opacity: 1;
	}

	.events-background-wash {
		backdrop-filter: none;
		background: linear-gradient(180deg, rgb(4 8 14 / 0.66) 0%, rgb(4 8 14 / 0.08) 38%, rgb(4 8 14 / 0.9) 100%),
			linear-gradient(90deg, rgb(4 8 14 / 0.48), transparent 42%, rgb(4 8 14 / 0.36));
	}

	.events-header {
		z-index: auto;
		opacity: 0;
		transform: translateY(1rem);
		transition: opacity 650ms ease, transform 650ms cubic-bezier(0.2, 0.75, 0.2, 1);
		position: absolute;
		top: 0;
		right: auto;
		left: 0;
		max-width: min(32rem, 42vw);
		padding:
			calc(var(--events-gap) + clamp(2rem, 4vw, 3.25rem))
			clamp(1.4rem, 2vw, 2.1rem)
			1.2rem
			calc(var(--events-gap) + clamp(1.5rem, 2.2vw, 2.25rem));
		text-align: left;
		pointer-events: auto;
	}

	.events-header h2 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 400;
		letter-spacing: -0.035em;
