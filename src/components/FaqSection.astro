---
import { serializeJsonLd } from '../lib/seo';
import type { FaqItem } from '../data/faq';

interface Props {
	items: FaqItem[];
	title?: string;
	id?: string;
	/** Homepage immersive chapters use framed padding; info pages sit in article flow. */
	variant?: 'chapter' | 'page';
}

const {
	items,
	title = 'Questions and Answers',
	id = 'faq',
	variant = 'chapter',
} = Astro.props;

const titleId = `${id}-title`;

const faqStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: items.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.answer,
		},
	})),
};
---

<section
	class:list={['faq-section', 'light-nav-zone', `faq-${variant}`]}
	id={id}
	aria-labelledby={titleId}
>
	<div class="faq-shell">
		<h2 class="faq-title" id={titleId}>{title}</h2>

		<div class="faq-panel">
			{
				items.map((item) => (
					<details class="faq-item">
						<summary>
							<span class="faq-question">{item.question}</span>
							<span class="faq-chevron" aria-hidden="true">
								<svg viewBox="0 0 20 20" fill="none" width="18" height="18">
									<path
										d="M5 7.5L10 12.5L15 7.5"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
							</span>
						</summary>
						<div class="faq-answer">
							<p>{item.answer}</p>
						</div>
					</details>
				))
			}
		</div>
	</div>
</section>

<script is:inline type="application/ld+json" set:html={serializeJsonLd(faqStructuredData)} />

<style>
	.faq-section {
		color: var(--page-text);
		background: var(--page-background);
	}

	.faq-chapter {
		padding: clamp(0.75rem, 1.6vw, 1.5rem);
	}

	.faq-shell {
		display: grid;
		grid-template-columns: minmax(12rem, 0.9fr) minmax(0, 1.55fr);
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: start;
		width: min(100%, 72rem);
		margin-inline: auto;
		padding: clamp(3rem, 7vw, 5.5rem) clamp(1.25rem, 4vw, 3.25rem);
	}

	.faq-chapter .faq-shell {
		width: 100%;
		padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 3.5vw, 3.25rem);
	}

	.faq-page .faq-shell {
		padding: clamp(2.5rem, 5vw, 4rem) 0 0;
	}

	.faq-title {
		margin: 0;
		max-width: 12ch;
		font-family: var(--font-display);
		font-size: clamp(2.2rem, 3.6vw, 3.35rem);
		font-weight: 400;
		letter-spacing: -0.04em;
		line-height: 0.95;
		text-wrap: balance;
		color: var(--text-heading, var(--page-text));
	}

	.faq-panel {
		overflow: hidden;
		border: 1px solid var(--hairline-soft, var(--page-border));
		border-radius: 1.15rem;
		background: var(--card-background);
	}

	.faq-item {
		border-bottom: 1px solid var(--hairline-soft, var(--page-border));
	}

	.faq-item:last-child {
		border-bottom: 0;
	}

	.faq-item summary {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 1rem 1.25rem;
		padding: 1.2rem clamp(1.15rem, 2.5vw, 1.65rem);
		list-style: none;
		cursor: pointer;
		user-select: none;
		transition: background 160ms ease;
	}

	.faq-item summary::-webkit-details-marker {
		display: none;
	}

	.faq-item summary:hover {
		background: var(--card-raised, var(--card-background));
	}

	.faq-item summary:focus-visible {
		outline: 2px solid var(--focus-color);
		outline-offset: -2px;
	}

	.faq-question {
		font-size: clamp(0.95rem, 1.15vw, 1.08rem);
		font-weight: 500;
		line-height: 1.35;
		color: var(--text-bright, var(--page-text));
	}

	.faq-chevron {
		display: grid;
		place-items: center;
		width: 1.5rem;
		height: 1.5rem;
		color: var(--text-faint, var(--text-muted));
		transition: transform 220ms ease, color 160ms ease;
	}

	.faq-item[open] .faq-chevron {
		transform: rotate(180deg);
		color: var(--text-soft, var(--page-text));
	}

	.faq-answer {
		padding: 0 clamp(1.15rem, 2.5vw, 1.65rem) 1.25rem;
	}

	.faq-answer p {
		max-width: 42rem;
		margin: 0;
		padding-top: 0.15rem;
		color: var(--text-soft, var(--page-text));
		font-size: var(--text-sm);
		line-height: var(--leading-body);
	}

	@media (max-width: 820px) {
		.faq-shell {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}

		.faq-title {
			max-width: none;
			font-size: clamp(2rem, 8vw, 2.75rem);
		}

		.faq-chapter {
			padding: 0.65rem;
		}

		.faq-chapter .faq-shell {
			padding: 2.5rem 1rem 2.75rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.faq-item summary,
		.faq-chevron {
			transition: none;
		}
	}
</style>
