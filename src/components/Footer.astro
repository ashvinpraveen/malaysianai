---
import BrandLockup from './BrandLockup.astro';
import ThemeToggle from './ThemeToggle.astro';
import { GITHUB_URL, LUMA_URL } from '../consts';
import { BRAND_WORDMARK } from '../lib/brand';
const year = new Date().getFullYear();

const groups = [
	{
		title: 'Get involved',
		links: [
			{ label: 'View events', href: LUMA_URL },
			{ label: 'Communities', href: '/#communities' },
			{ label: 'Residency', href: '/residency' },
		],
	},
	{
		title: 'Explore',
		links: [
			{ label: 'Stories', href: '/blog' },
			{ label: 'Residents', href: '/residents' },
		],
	},
];
---

<footer class="site-footer" id="site-footer">
	<div class="footer-grid">
		<div class="footer-intro">
			<a class="footer-brand" href="/" aria-label="Malaysian AI home">
				<BrandLockup loading="lazy" />
			</a>
			<p>
				Discover weekly events with Malaysia's AI Communities, and take your projects further
				with an 8-week residency in Kuala Lumpur.
			</p>
			<div class="footer-actions">
				<a class="footer-cta site-button" href="/residency">Join residency</a>
				<a class="footer-events" href={LUMA_URL}>View events</a>
			</div>
		</div>

		{
			groups.map((group) => (
				<nav class="footer-link-group" aria-label={group.title}>
					<p>{group.title}</p>
					<ul>
						{group.links.map((link) => (
							<li><a href={link.href}>{link.label}</a></li>
						))}
					</ul>
				</nav>
			))
		}

		<div class="footer-company">
			<p>Malaysian AI</p>
			<a href="/about">About</a>
			<a href="/contact">Contact</a>
			<a href="/brand">Brand</a>
			<a href="/privacy">Privacy</a>
			<a href="/terms">Terms</a>
			<a href={GITHUB_URL}>GitHub</a>
			<div class="footer-meta">
				<span>© {year} Malaysian AI · Open source</span>
				<ThemeToggle />
			</div>
		</div>
	</div>

	<div class="footer-wordmark" aria-hidden="true">{BRAND_WORDMARK}</div>
</footer>

<style>
	.site-footer {
		position: relative;
		overflow: hidden;
		padding: var(--section-space) clamp(1.25rem, 4vw, 4rem) clamp(2.5rem, 5vw, 4rem);
		color: var(--footer-text);
		background: var(--site-background);
	}

	.footer-grid {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(16rem, 1.7fr) repeat(2, minmax(8rem, 0.72fr)) minmax(9rem, 0.8fr);
		gap: clamp(2.5rem, 6vw, 7rem);
		width: min(92rem, 100%);
		margin: 0 auto;
	}

	.footer-brand {
		display: inline-flex;
		height: 2.1rem;
		width: fit-content;
		color: var(--text-heading);
		text-decoration: none;
	}

	.footer-intro > p {
		max-width: 24rem;
		margin: 1.6rem 0;
		color: var(--footer-copy);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.footer-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem 1.1rem;
		align-items: center;
	}

	.footer-cta {
		width: fit-content;
		transition: background 180ms ease, transform 180ms ease;
	}

	.footer-events {
		color: var(--footer-link);
		font-size: 0.86rem;
		text-underline-offset: 0.22em;
	}

	.footer-events:hover,
	.footer-events:focus-visible {
		color: var(--text-hover);
	}

	.footer-events:focus-visible {
		outline: 2px solid var(--focus-color);
		outline-offset: 4px;
	}

	.footer-cta:hover,
	.footer-cta:focus-visible {
		transform: translateY(-2px);
	}

	.footer-link-group {
		display: block;
		min-width: 0;
		margin: 0;
	}

	.footer-link-group > p,
	.footer-company > p {
		margin: 0 0 1.5rem;
		color: var(--footer-label);
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.footer-link-group ul {
		display: grid;
		gap: 1.05rem;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.footer-link-group a,
	.footer-company a {
		color: var(--footer-link);
		font-size: 0.9rem;
		text-decoration: none;
		transition: color 180ms ease;
	}

	.footer-link-group a:hover,
	.footer-link-group a:focus-visible,
	.footer-company a:hover,
	.footer-company a:focus-visible {
		color: var(--text-hover);
	}

	.footer-company {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.footer-company a + a { margin-top: 1rem; }

	.footer-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.85rem 1.25rem;
		width: 100%;
		margin-top: 2rem;
	}

	.footer-meta span {
		color: var(--footer-meta);
		font-size: 0.76rem;
	}

	.footer-wordmark {
		position: relative;
		width: min(92rem, 100%);
		margin: clamp(2rem, 4vw, 3.5rem) auto 0;
		color: var(--footer-wordmark-color);
		font-family: var(--font-display);
		font-size: clamp(3.25rem, 11vw, 13rem);
		font-weight: 400;
		letter-spacing: -0.04em;
		line-height: 1.12;
		text-align: center;
		white-space: nowrap;
		user-select: none;
	}

	@media (max-width: 900px) {
		.footer-grid {
			grid-template-columns: 1.5fr 1fr 1fr;
		}

		.footer-company {
			grid-column: 2 / -1;
		}
	}

	@media (max-width: 620px) {
		.site-footer {
			padding: 3.5rem 1.25rem 2.5rem;
		}

		.footer-grid {
			grid-template-columns: 1fr 1fr;
			gap: 3rem 1.5rem;
		}

		.footer-intro {
			grid-column: 1 / -1;
		}

		.footer-company {
			grid-column: 1 / -1;
		}

		.footer-wordmark {
			margin-top: 1.75rem;
			font-size: clamp(2.4rem, 11.5vw, 3.4rem);
		}
	}
</style>
