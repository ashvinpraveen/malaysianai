---
import BrandLockup from './BrandLockup.astro';
import { LUMA_URL } from '../consts';

interface Props {
	home?: boolean;
	current?: 'home' | 'about' | 'residency' | 'residents' | 'apply' | 'stories';
	minimal?: boolean;
}

const { home = false, current, minimal = false } = Astro.props;
const links = [
	{ id: 'about', href: '/about', label: 'About' },
	{ id: 'events', href: home ? '#events' : '/#events', label: 'Events' },
	{ id: 'communities', href: home ? '#communities' : '/#communities', label: 'Communities' },
	{ id: 'residency', href: '/residency', label: 'Residency' },
	{ id: 'stories', href: '/blog', label: 'Stories' },
] as const;
---

<header class:list={['hero-header', { 'is-minimal': minimal }]}>
	<div class="mobile-navigation">
		<button type="button" class="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="site-mobile-menu">
			<span class="hamburger" aria-hidden="true">
				<span></span>
				<span></span>
				<span></span>
			</span>
		</button>
		<dialog id="site-mobile-menu" class="mobile-menu" aria-label="Menu">
			<button type="button" class="menu-toggle is-close" aria-label="Close menu">
				<span class="hamburger" aria-hidden="true">
					<span></span>
					<span></span>
					<span></span>
				</span>
			</button>
			<div class="mobile-menu-body">
				<nav aria-label="Mobile navigation">
					{links.map(link => (
						<a href={link.href} aria-current={current === link.id ? 'page' : undefined}>{link.label}</a>
					))}
					<a class="mobile-menu-events" href={LUMA_URL}>View events</a>
				</nav>
				<a class="mobile-menu-join site-button" href="/residency">Join residency</a>
			</div>
		</dialog>
	</div>

	<div class="brand-panel" transition:name="site-brand" transition:persist="site-brand">
		<a class="brand-mark" href="/" aria-label="Malaysian AI home">
			<BrandLockup />
		</a>
	</div>

	<nav class="hero-nav" aria-label="Primary navigation">
		{links.map(link => (
			<a href={link.href} aria-current={current === link.id ? 'page' : undefined}>{link.label}</a>
		))}
	</nav>
</header>

<div class:list={['hero-cta-panel', { 'is-minimal': minimal }]}>
	<a class="nav-cta site-button" href="/residency">Join residency</a>
</div>

<script>
	let navigationController: AbortController | undefined;

	function prepareNavigation() {
		navigationController?.abort();
		navigationController = new AbortController();
		const { signal } = navigationController;

		document.querySelectorAll<HTMLElement>('.mobile-navigation').forEach(root => {
			const toggle = root.querySelector<HTMLButtonElement>('.menu-toggle:not(.is-close)');
			const close = root.querySelector<HTMLButtonElement>('.is-close');
			const dialog = root.querySelector<HTMLDialogElement>('.mobile-menu');
			if (!toggle || !close || !dialog) return;

			const setExpanded = (open: boolean) => {
				toggle.setAttribute('aria-expanded', String(open));
			};

			toggle.addEventListener('click', () => {
				if (dialog.open) dialog.close();
				else void dialog.showModal();
			}, { signal });

			close.addEventListener('click', () => dialog.close(), { signal });

			dialog.addEventListener('click', event => {
				if ((event.target as Element).closest('a')) dialog.close();
			}, { signal });

			document.addEventListener('keydown', event => {
				if (event.key === 'Escape' && dialog.open) dialog.close();
			}, { signal });

			dialog.addEventListener('close', () => setExpanded(false), { signal });
			setExpanded(dialog.open);
		});
	}

	document.addEventListener('astro:page-load', prepareNavigation);
	document.addEventListener('astro:before-swap', () => {
		document.querySelectorAll<HTMLDialogElement>('.mobile-menu').forEach(dialog => {
			if (dialog.open) dialog.close();
		});
		navigationController?.abort();
	});
</script>

<style>
	.hero-header {
		position: absolute;
		z-index: 4;
		top: 0;
		left: 0;
		display: flex;
		align-items: center;
		width: max-content;
		max-width: calc(100% - 11rem);
		height: var(--hero-header-height, 4.25rem);
		padding-right: 1.2rem;
		pointer-events: none;
	}

	.hero-header::before {
		position: absolute;
		z-index: -1;
		top: 0;
		right: 0;
		bottom: auto;
		left: 0;
		height: var(--hero-header-height, 4.25rem);
		border-bottom-right-radius: var(--hero-radius, 0.95rem);
		background: #06090f;
		background: var(--hero-frame, var(--page-background));
		content: '';
	}

	.brand-panel {
		position: relative;
		display: grid;
		width: auto;
		height: 100%;
		place-items: center start;
		padding: 0 0 0 var(--hero-gap, 1rem);
		background: #06090f;
		background: var(--hero-frame, var(--page-background));
		pointer-events: auto;
	}

	.brand-mark {
		display: inline-flex;
		height: var(--hero-logo-width, 1.95rem);
		width: auto;
		min-width: 0;
		min-height: 0;
		color: var(--text-heading);
	}

	.hero-nav {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 1.15rem;
		height: var(--hero-control-height, 2.25rem);
		padding: 0 0.15rem 0 1.35rem;
		color: var(--text-heading);
		background: transparent;
		pointer-events: auto;
	}

	.hero-nav a {
		font: 400 0.82rem / 1.2 var(--font-body);
		text-decoration: none;
		white-space: nowrap;
	}

	.hero-nav a:hover,
	.hero-nav a[aria-current='page'] {
		text-decoration: underline;
		text-underline-offset: 0.3rem;
	}

	.hero-cta-panel {
		position: absolute;
		z-index: 4;
		top: 0;
		right: 0;
		display: flex;
		align-items: flex-start;
		gap: 0.45rem;
		padding: var(--hero-gap, 1rem);
		height: var(--hero-header-height, 4.25rem);
		border-bottom-left-radius: var(--hero-radius, 0.95rem);
		background: var(--hero-frame, var(--page-background));
	}

	.hero-header.is-minimal::before {
		display: none;
	}

	.nav-cta { position: relative; z-index: 1; height: var(--hero-control-height, 2.25rem); }
	.mobile-navigation { display: none; }
	a:focus-visible { outline: 2px solid var(--focus-color); outline-offset: 3px; }

	@media (max-width: 700px) {
		.hero-header {
			width: max-content;
			max-width: calc(100% - 8.5rem);
			padding-right: var(--hero-gap, 0.6rem);
		}
		.hero-nav { display: none; }
		.brand-panel { padding-left: 0.35rem; }
		.brand-mark {
			height: var(--hero-logo-width-mobile, 1.55rem);
		}
		.hero-cta-panel {
			top: var(--hero-gap, 0.6rem);
			right: calc(var(--hero-gap, 0.6rem) * 2);
			align-items: center;
			height: var(--hero-control-height, 2rem);
			padding: 0;
			background: transparent;
		}

		.mobile-navigation {
			position: relative;
			z-index: 1;
			display: flex;
			align-items: center;
			align-self: stretch;
			padding-left: var(--hero-gap, 0.6rem);
			pointer-events: auto;
		}

		.menu-toggle {
			display: grid;
			width: 2.5rem;
			height: 2.5rem;
			place-items: center;
			padding: 0;
			border: 0;
			border-radius: 0.4rem;
			color: var(--text-heading);
			background: transparent;
			cursor: pointer;
		}

		.menu-toggle:focus-visible {
			outline: 2px solid var(--focus-color);
			outline-offset: 3px;
		}

		.hamburger {
			position: relative;
			display: block;
			width: 1.15rem;
			height: 0.82rem;
		}

		.hamburger span {
			position: absolute;
			left: 0;
			display: block;
			width: 100%;
			height: 1.5px;
			border-radius: 1px;
			background: currentColor;
			transition: transform 180ms ease, opacity 180ms ease, top 180ms ease;
		}

		.hamburger span:nth-child(1) { top: 0; }
		.hamburger span:nth-child(2) { top: 50%; transform: translateY(-50%); }
		.hamburger span:nth-child(3) { top: calc(100% - 1.5px); }

		.is-close .hamburger span:nth-child(1),
		.mobile-menu[open] .is-close .hamburger span:nth-child(1) {
			top: 50%;
			transform: translateY(-50%) rotate(45deg);
		}

		.is-close .hamburger span:nth-child(2) {
			opacity: 0;
		}

		.is-close .hamburger span:nth-child(3) {
			top: 50%;
			transform: translateY(-50%) rotate(-45deg);
		}

		.mobile-menu {
			inset: 0;
			width: 100vw;
			height: 100svh;
			max-width: none;
			max-height: 100svh;
			margin: 0;
			padding:
				max(0.65rem, env(safe-area-inset-top, 0px))
				max(1.25rem, env(safe-area-inset-right, 0px))
				max(1.75rem, calc(env(safe-area-inset-bottom, 0px) + 1rem))
				max(0.65rem, env(safe-area-inset-left, 0px));
			border: 0;
			overflow: hidden;
			color: var(--text-heading);
			background: var(--page-background);
		}

		.mobile-menu[open] {
			display: flex;
			flex-direction: column;
			align-items: stretch;
		}

		.mobile-menu::backdrop {
			background: var(--page-background);
		}

		.mobile-menu-body {
			display: flex;
			flex: 1;
			flex-direction: column;
			justify-content: space-between;
			gap: 1.5rem;
			min-height: 0;
			padding: 0.85rem 0.6rem 0.35rem;
		}

		.mobile-menu-body nav {
			display: grid;
			align-content: start;
			gap: 0.1rem;
		}

		.mobile-menu-body nav a {
			padding: 0.7rem 0;
			font: 400 clamp(1.55rem, 7vw, 2rem) / 1.15 var(--font-display);
			letter-spacing: -0.03em;
			text-decoration: none;
		}

		.mobile-menu-body nav a:hover,
		.mobile-menu-body nav a[aria-current='page'] {
			text-decoration: underline;
			text-underline-offset: 0.22em;
		}

		.mobile-menu-events {
			margin-top: 0.55rem;
		}

		.mobile-menu-join {
			width: 100%;
			min-height: 3.1rem;
			font-size: 0.95rem;
		}
	}

	@media (max-width: 420px) {
		.hero-header {
			--hero-brand-width: 3.8rem;
			--hero-logo-width-mobile: 1.85rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hamburger span {
			transition: none;
		}
	}
</style>
