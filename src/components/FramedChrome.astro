---
import { LUMA_URL } from '../consts';

interface Props {
	home?: boolean;
	current?: 'home' | 'residency' | 'residents' | 'apply';
}

const { home = false, current } = Astro.props;

const links = [
	{ id: 'about', href: home ? '#about' : '/#about', label: 'About' },
	{ id: 'communities', href: home ? '#communities' : '/#communities', label: 'Communities' },
	{ id: 'residency', href: '/residency', label: 'Residency' },
] as const;
---

<header class="hero-header">
	<div class="brand-panel">
		<a class="brand-mark" href="/" aria-label="Malaysian AI home">
			<img src="/malaysian-ai-batik-logo-bw.svg" alt="" width="800" height="800" />
		</a>
	</div>

	<nav class="hero-nav" aria-label="Primary navigation">
		{
			links.map((link) => (
				<a
					class:list={[`nav-${link.id}`]}
					href={link.href}
					aria-current={current === link.id ? 'page' : undefined}
				>
					{link.label}
				</a>
			))
		}
	</nav>
</header>

<div class="hero-cta-panel">
	<a class="nav-cta" href={LUMA_URL}>Find an event</a>
</div>

<style>
	.hero-header {
		position: absolute;
		z-index: 4;
		top: 0;
		left: 0;
		width: 21rem;
		height: 7.3rem;
		pointer-events: none;
	}

	.hero-header::before {
		position: absolute;
		z-index: -1;
		top: 0;
		left: 7.2rem;
		width: 12.85rem;
		height: 4rem;
		border-bottom: 1.5px solid var(--hero-line, #7398cf);
		background: var(--hero-frame, #06090f);
		content: '';
		animation: frame-piece-in 0.65s 0.18s ease-out both;
	}

	.hero-header::after {
		position: absolute;
		top: var(--hero-gap, 1rem);
		left: 20.05rem;
		width: 0.95rem;
		height: 3rem;
		border-right: 1.5px solid var(--hero-line, #7398cf);
		border-bottom: 1.5px solid var(--hero-line, #7398cf);
		border-bottom-right-radius: 0.95rem;
		background: var(--hero-frame, #06090f);
		content: '';
		pointer-events: none;
		animation: frame-piece-in 0.65s 0.25s ease-out both;
	}

	.brand-panel {
		position: absolute;
		top: 0;
		left: 0;
		display: grid;
		width: 7.2rem;
		height: 7.2rem;
		place-items: center;
		border-bottom-right-radius: 0.95rem;
		background: var(--hero-frame, #06090f);
		pointer-events: auto;
		animation: panel-arrive 0.65s 0.15s ease-out both;
	}

	.brand-panel::after {
		position: absolute;
		top: 4rem;
		right: 0;
		bottom: 0;
		left: var(--hero-gap, 1rem);
		border-right: 1.5px solid var(--hero-line, #7398cf);
		border-bottom: 1.5px solid var(--hero-line, #7398cf);
		border-bottom-right-radius: 0.95rem;
		content: '';
		pointer-events: none;
	}

	.brand-mark {
		display: grid;
		width: 5.2rem;
		height: 5.2rem;
		place-items: center;
		animation: logo-stage-in 0.2s 1.3s ease-out both;
	}

	.brand-mark img {
		display: block;
		width: 100%;
		height: 100%;
	}

	.hero-nav {
		position: absolute;
		top: 0.85rem;
		left: 7.15rem;
		display: flex;
		align-items: center;
		gap: 0.9rem;
		min-height: 2.25rem;
		margin: 0;
		padding: 0.3rem 0.85rem;
		border-radius: 0.45rem;
		color: #121817;
		background: #f7f7f4;
		box-shadow: 0 1px 0 rgb(255 255 255 / 0.7);
		pointer-events: auto;
		animation: soft-rise 0.65s 0.55s ease-out both;
	}

	.hero-nav a {
		position: relative;
		font-size: 0.82rem;
		font-weight: 400;
		line-height: 1;
		text-decoration: none;
	}

	.hero-nav a::after {
		position: absolute;
		right: 0;
		bottom: -0.25rem;
		left: 0;
		height: 1px;
		background: currentColor;
		content: '';
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 180ms ease;
	}

	.hero-nav a:hover::after,
	.hero-nav a:focus-visible::after,
	.hero-nav a[aria-current='page']::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	.hero-cta-panel {
		position: absolute;
		z-index: 4;
		top: 0;
		right: 0;
		display: flex;
		align-items: flex-start;
		justify-content: flex-end;
		width: 8.6rem;
		height: 4rem;
		padding: 0.85rem 1rem 0 0;
		border-bottom-left-radius: 0.95rem;
		background: var(--hero-frame, #06090f);
		animation: panel-arrive 0.65s 0.25s ease-out both;
	}

	.hero-cta-panel::after {
		position: absolute;
		top: var(--hero-gap, 1rem);
		right: var(--hero-gap, 1rem);
		bottom: 0;
		left: 0;
		border-bottom: 1.5px solid var(--hero-line, #7398cf);
		border-left: 1.5px solid var(--hero-line, #7398cf);
		border-bottom-left-radius: 0.95rem;
		content: '';
		pointer-events: none;
	}

	.nav-cta {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.25rem;
		padding: 0.35rem 0.85rem;
		border-radius: 0.45rem;
		color: #f8fbff;
		background: #142b4d;
		font-size: 0.82rem;
		font-weight: 400;
		white-space: nowrap;
		text-decoration: none;
		animation: soft-rise 0.65s 0.7s ease-out both;
		transition: background 180ms ease, transform 180ms ease;
	}

	.nav-cta:hover,
	.nav-cta:focus-visible {
		color: #fff;
		background: #1b3b69;
		transform: translateY(-1px);
	}

	a:focus-visible {
		outline: 2px solid #97b8e7;
		outline-offset: 3px;
	}

	@keyframes logo-stage-in {
		from {
			opacity: 0;
		}
	}

	@keyframes soft-rise {
		from {
			opacity: 0;
			transform: translateY(0.55rem);
		}
	}

	@keyframes panel-arrive {
		from {
			opacity: 0;
			transform: translateY(0.7rem);
		}
	}

	@keyframes frame-piece-in {
		from {
			opacity: 0;
		}
	}

	@media (max-width: 700px) {
		.hero-header {
			width: 12.2rem;
			height: 4.5rem;
		}

		.hero-header::before {
			left: 4.4rem;
			width: 7.05rem;
			height: 3.1rem;
		}

		.hero-header::after {
			top: var(--hero-gap, 0.6rem);
			left: 11.45rem;
			width: 0.75rem;
			height: 2.5rem;
			border-bottom-right-radius: 0.75rem;
		}

		.brand-panel {
			width: 4.4rem;
			height: 4.4rem;
			border-bottom-right-radius: 0.75rem;
		}

		.brand-mark {
			width: 3.2rem;
			height: 3.2rem;
		}

		.brand-panel::after {
			top: 3.1rem;
			left: var(--hero-gap, 0.6rem);
			border-bottom-right-radius: 0.75rem;
		}

		.hero-nav {
			top: 0.55rem;
			left: 4.35rem;
			gap: 0.5rem;
			min-height: 2rem;
			padding: 0.28rem 0.55rem;
		}

		.hero-nav a {
			font-size: 0.68rem;
		}

		.nav-about {
			display: none;
		}

		.hero-cta-panel {
			width: 6.55rem;
			height: 3.1rem;
			padding: 0.55rem 0.55rem 0 0;
			border-bottom-left-radius: 0.75rem;
		}

		.hero-cta-panel::after {
			top: var(--hero-gap, 0.6rem);
			right: var(--hero-gap, 0.6rem);
			border-bottom-left-radius: 0.75rem;
		}

		.nav-cta {
			min-height: 2rem;
			padding: 0.3rem 0.6rem;
			font-size: 0.68rem;
		}
	}

	@media (max-width: 390px) {
		.hero-nav {
			gap: 0.5rem;
			padding-inline: 0.55rem;
		}

		.hero-nav a {
			font-size: 0.64rem;
		}

		.hero-cta-panel {
			width: 6.4rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.brand-mark,
		.brand-panel,
		.hero-header::before,
		.hero-header::after,
		.hero-nav,
		.hero-cta-panel,
		.nav-cta {
			animation: none;
		}
	}
</style>
