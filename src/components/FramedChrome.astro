---
import { LUMA_URL } from '../consts';

interface Props {
	home?: boolean;
	current?: 'home' | 'residency' | 'residents' | 'apply' | 'stories';
	minimal?: boolean;
}

const { home = false, current, minimal = false } = Astro.props;
const links = [
	{ id: 'about', href: home ? '#about' : '/#about', label: 'About' },
	{ id: 'events', href: home ? '#events' : '/#events', label: 'Events' },
	{ id: 'communities', href: home ? '#communities' : '/#communities', label: 'Communities' },
	{ id: 'residency', href: home ? '#residency' : '/#residency', label: 'Residency' },
	{ id: 'stories', href: '/blog', label: 'Stories' },
] as const;
---

<header class:list={['hero-header', { 'is-minimal': minimal }]}>
	<div class="brand-panel" transition:name="site-brand" transition:persist="site-brand">
		<a class="brand-mark" href="/" aria-label="Malaysian AI home">
			<img src="/malaysian-ai-batik-logo-bw.svg" alt="" width="800" height="800" />
		</a>
	</div>

	<nav class="hero-nav" aria-label="Primary navigation">
		{links.map(link => (
			<a href={link.href} aria-current={current === link.id ? 'page' : undefined}>{link.label}</a>
		))}
	</nav>

	<details class="mobile-navigation">
		<summary class="site-button">Menu <span aria-hidden="true">⌄</span></summary>
		<nav aria-label="Mobile navigation">
			{links.map(link => (
				<a href={link.href} aria-current={current === link.id ? 'page' : undefined}>{link.label}</a>
			))}
		</nav>
	</details>
</header>

<div class:list={['hero-cta-panel', { 'is-minimal': minimal }]}>
	<a class="nav-cta site-button" href={LUMA_URL}>Find an event</a>
</div>

<script>
	function prepareNavigation() {
		document.querySelectorAll<HTMLDetailsElement>('.mobile-navigation').forEach(menu => {
			if (menu.dataset.ready === 'true') return;
			menu.dataset.ready = 'true';

		menu.addEventListener('click', event => {
			if ((event.target as Element).closest('a')) menu.open = false;
		});
		menu.addEventListener('keydown', event => {
			if (event.key === 'Escape') {
				menu.open = false;
				menu.querySelector('summary')?.focus();
			}
		});
		document.addEventListener('click', event => {
			if (!menu.contains(event.target as Node)) menu.open = false;
		});
		});
	}

	document.addEventListener('astro:page-load', prepareNavigation);
</script>

<style>
	.hero-header {
		position: absolute;
		z-index: 4;
		top: 0;
		left: 0;
		width: var(--hero-panel-width, 29rem);
		height: var(--hero-brand-width, 7.2rem);
		pointer-events: none;
	}

	.hero-header::before {
		position: absolute;
		z-index: -1;
		top: 0;
		right: 0.95rem;
		bottom: auto;
		left: var(--hero-brand-width, 7.2rem);
		height: var(--hero-header-height, 4.25rem);
		border-bottom: 1.5px solid var(--hero-line, #7398cf);
		background: var(--hero-frame, #06090f);
		content: '';
	}

	.hero-header::after {
		position: absolute;
		top: var(--hero-gap, 1rem);
		right: 0;
		width: 0.95rem;
		height: calc(var(--hero-header-height, 4.25rem) - var(--hero-gap, 1rem));
		border-right: 1.5px solid var(--hero-line, #7398cf);
		border-bottom: 1.5px solid var(--hero-line, #7398cf);
		border-bottom-right-radius: 0.95rem;
		background: var(--hero-frame, #06090f);
		content: '';
	}

	.brand-panel {
		position: absolute;
		top: 0;
		left: 0;
		display: grid;
		width: var(--hero-brand-width, 7.2rem);
		height: var(--hero-brand-width, 7.2rem);
		place-items: center;
		border-bottom-right-radius: 0.95rem;
		background: var(--hero-frame, #06090f);
		pointer-events: auto;
	}

	.brand-panel::after {
		position: absolute;
		top: var(--hero-header-height, 4.25rem);
		right: 0;
		bottom: 0;
		left: var(--hero-gap, 1rem);
		border-right: 1.5px solid var(--hero-line, #7398cf);
		border-bottom: 1.5px solid var(--hero-line, #7398cf);
		border-bottom-right-radius: 0.95rem;
		content: '';
		pointer-events: none;
	}

	.brand-mark {
		display: grid;
		width: var(--hero-logo-width, 5.2rem);
		height: var(--hero-logo-width, 5.2rem);
		place-items: center;
	}

	.brand-mark img { display: block; width: 100%; height: 100%; }

	.hero-nav {
		position: absolute;
		top: var(--hero-gap, 1rem);
		right: var(--hero-gap, 1rem);
		left: var(--hero-brand-width, 7.2rem);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.9rem;
		height: var(--hero-control-height, 2.25rem);
		padding: 0.35rem 0.85rem;
		border-radius: var(--button-radius);
		color: var(--button-text);
		background: var(--button-background);
		pointer-events: auto;
	}

	.hero-nav a,
	.mobile-navigation a {
		font: 400 0.82rem / 1.2 'Atkinson', system-ui, sans-serif;
		text-decoration: none;
		white-space: nowrap;
	}

	.hero-nav a:hover,
	.hero-nav a[aria-current='page'],
	.mobile-navigation a:hover,
	.mobile-navigation a[aria-current='page'] {
		text-decoration: underline;
		text-underline-offset: 0.3rem;
	}

	.hero-cta-panel {
		position: absolute;
		z-index: 4;
		top: 0;
		right: 0;
		display: flex;
		align-items: flex-start;
		padding: var(--hero-gap, 1rem);
		height: var(--hero-header-height, 4.25rem);
		border-bottom-left-radius: 0.95rem;
		background: var(--hero-frame, #06090f);
	}

	.hero-cta-panel::after {
		position: absolute;
		top: var(--hero-gap, 1rem);
		right: var(--hero-gap, 1rem);
		bottom: 0;
		left: 0;
		border-bottom: 1.5px solid var(--hero-line, #7398cf);
		border-left: 1.5px solid var(--hero-line, #7398cf);
		border-bottom-left-radius: 0.95rem;
		content: '';
		pointer-events: none;
	}

	.hero-header.is-minimal::before,
	.hero-header.is-minimal::after,
	.hero-header.is-minimal .brand-panel::after,
	.hero-cta-panel.is-minimal::after {
		display: none;
	}

	.nav-cta { position: relative; z-index: 1; height: var(--hero-control-height, 2.25rem); }
	.mobile-navigation { display: none; }
	a:focus-visible { outline: 2px solid #97b8e7; outline-offset: 3px; }

	@media (max-width: 700px) {
		.hero-header { width: var(--hero-panel-width, calc(100% - 0.6rem)); }
		.hero-nav { display: none; }
		.brand-mark {
			width: var(--hero-logo-width-mobile, 3.2rem);
			height: var(--hero-logo-width-mobile, 3.2rem);
		}
		.hero-cta-panel {
			top: var(--hero-gap, 0.6rem);
			right: calc(var(--hero-gap, 0.6rem) * 2);
			height: var(--hero-control-height, 2rem);
			padding: 0;
			background: transparent;
		}
		.hero-cta-panel::after { display: none; }
		.mobile-navigation {
			position: absolute;
			top: var(--hero-gap, 0.6rem);
			left: var(--hero-brand-width, 4.4rem);
			display: block;
			pointer-events: auto;
		}
		.mobile-navigation summary { height: var(--hero-control-height, 2rem); list-style: none; }
		.mobile-navigation summary::-webkit-details-marker { display: none; }
		.mobile-navigation summary span { transition: transform 150ms ease; }
		.mobile-navigation[open] summary span { transform: rotate(180deg); }
		.mobile-navigation nav {
			position: absolute;
			top: calc(100% + 1rem);
			left: 0;
			display: grid;
			gap: 0.25rem;
			width: min(18rem, calc(100vw - var(--hero-brand-width, 4.4rem) - 2rem));
			padding: 0.5rem;
			border: 1px solid #7398cf;
			border-radius: var(--button-radius);
			color: var(--button-text);
			background: var(--button-background);
			box-shadow: 0 10px 30px #0005;
		}
		.mobile-navigation a { padding: 0.75rem; }
	}
</style>
