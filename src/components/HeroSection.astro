---
import { Image, getImage } from 'astro:assets';
import heroArt from '../assets/hero-fibonacci.png';
import heroArtDay from '../assets/hero-fibonacci-day.png';
import FramedChrome from './FramedChrome.astro';
import HibiscusPetals from './HibiscusPetals.astro';
import { APPLY_FORM_URL, LUMA_URL } from '../consts';

const dayFallback = await getImage({ src: heroArtDay, widths: [640, 1024, 1672], format: 'webp', quality: 85 });
---

<div class="hero-shell">
	<div class="hero-media">
		<template data-hero-theme="dark">
			<Image
				class="hero-art hero-art-night"
				src={heroArt}
				format="webp"
				widths={[640, 1024, 1672]}
				sizes="max(100vw, 178svh)"
				quality={85}
				alt=""
				width="1672"
				height="941"
				fetchpriority="high"
				loading="eager"
				decoding="async"
			/>
		</template>
		<template data-hero-theme="light">
			<Image
				class="hero-art hero-art-day"
				src={heroArtDay}
				format="webp"
				widths={[640, 1024, 1672]}
				sizes="max(100vw, 178svh)"
				quality={85}
				alt=""
				width="1672"
				height="941"
				fetchpriority="high"
				loading="eager"
				decoding="async"
			/>
		</template>
		<noscript>
			<picture>
				<source media="(prefers-color-scheme: light)" srcset={dayFallback.srcSet.attribute} sizes="max(100vw, 178svh)" />
				<Image class="hero-art" src={heroArt} format="webp" widths={[640, 1024, 1672]} sizes="max(100vw, 178svh)" quality={85} alt="" fetchpriority="high" loading="eager" />
			</picture>
		</noscript>
		<script is:inline data-astro-rerun>
			(() => {
				// Templates keep the inactive theme out of the preload scanner. Run here,
				// during parsing, so the active hero need not wait for the page-load event.
				const media = document.currentScript.parentElement;
				let selectedTheme;
				let sequence = 0;
				const update = async () => {
					const theme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
					if (theme === selectedTheme) return;
					selectedTheme = theme;
					const change = ++sequence;
					const next = document.importNode(media.querySelector(`[data-hero-theme="${theme}"]`).content.querySelector('img'), true);
					const current = media.querySelector(':scope > .hero-art');
					if (!current) {
						media.append(next);
						return;
					}
					// Leave the old artwork visible while the requested theme downloads.
					try {
						await next.decode();
					} catch {
						if (change === sequence) selectedTheme = undefined;
						return;
					}
					if (change !== sequence || !media.isConnected) return;
					next.style.animation = 'none';
					current.replaceWith(next);
				};
				void update();
				const observer = new MutationObserver(update);
				observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
				document.addEventListener('astro:before-swap', () => {
					sequence++;
					observer.disconnect();
				}, { once: true });
			})();
		</script>
		<div class="hero-shade" aria-hidden="true"></div>
		<div class="hero-dim" aria-hidden="true"></div>
	</div>

	<FramedChrome home />

	<svg class="hero-outline" aria-hidden="true" focusable="false" preserveAspectRatio="none">
		<path />
	</svg>
	<div class="hero-mobile-frame" hidden aria-hidden="true"></div>

	<div class="hero-announcement">
		<p>
			<span>Our first ever cohort is open.</span>
			<a class="hero-announcement-link" href={APPLY_FORM_URL}>Join our Residency.</a>
		</p>
		<a class="site-button hero-apply" href={APPLY_FORM_URL}>Apply now</a>
	</div>

	<section class="hero-card" aria-labelledby="hero-title">
		<HibiscusPetals
			petals={[
				{ x: '9%', y: '1.5rem', row: 0, size: 42, delay: 0.3 },
				{ x: '58%', y: '4.25rem', row: 2, size: 30, flip: true, delay: 1.1, speed: 1.4 },
				{ x: '31%', y: '8.75rem', row: 1, size: 36, delay: 0.7 },
				{ x: '83%', y: '10.5rem', row: 3, size: 28, flip: true, delay: 1.6, speed: 1 },
				{ x: '71%', y: '18.25rem', row: 0, size: 34, flip: true, delay: 0.2, speed: 1.3, appearAt: 0.72 },
				{ x: '14%', y: '20.75rem', row: 2, size: 40, delay: 0.9, appearAt: 0.6 },
				{ x: '46%', y: '23.5rem', row: 3, size: 24, delay: 1.4, speed: 1.1, appearAt: 0.8 },
			]}
		/>
		<div class="hero-copy">
			<h1 id="hero-title" data-word-reveal>Come learn, build and<br /> experience Malaysian AI.</h1>
			<p class="intro" data-word-reveal>
				Discover Malaysia's AI communities and events. Join weekly meetups, AI learning
				sessions and workshops.
			</p>
		</div>
		<div class="hero-actions">
			<a class="card-link site-button" href={LUMA_URL}>View upcoming events</a>
		</div>
	</section>
</div>

<script>
	function roundCoord(value: number) {
		return Math.round(value * 100) / 100;
	}

	function relativeBox(mediaBox: DOMRect, element: Element) {
		const box = element.getBoundingClientRect();
		return {
			l: box.left - mediaBox.left,
			t: box.top - mediaBox.top,
			r: box.right - mediaBox.left,
			b: box.bottom - mediaBox.top,
		};
	}

	function drawHeroOutline() {
		const shell = document.querySelector<HTMLElement>('.hero-shell');
		const svg = shell?.querySelector<SVGSVGElement>('.hero-outline');
		const path = svg?.querySelector('path');
		const frame = shell?.querySelector<HTMLElement>('.hero-mobile-frame');
		const media = shell?.querySelector<HTMLElement>('.hero-media');
		const header = shell?.querySelector<HTMLElement>('.hero-header');
		const cta = shell?.querySelector<HTMLElement>('.hero-cta-panel');
		const card = shell?.querySelector<HTMLElement>('.hero-card');
		if (!shell || !svg || !path || !frame || !media || !header || !cta || !card) return;

		const mediaBox = media.getBoundingClientRect();
		const width = mediaBox.width;
		const height = mediaBox.height;
		if (width < 8 || height < 8) return;

		const radius = Math.min(parseFloat(getComputedStyle(media).borderTopLeftRadius) || 15, width / 4, height / 4);
		const headerBox = relativeBox(mediaBox, header);
		const ctaBox = relativeBox(mediaBox, cta);
		const cardBox = relativeBox(mediaBox, card);
		const desktop = window.matchMedia('(min-width: 701px)').matches;

		const n = (value: number) => roundCoord(value).toString();
		const move = (x: number, y: number) => `M ${n(x)} ${n(y)}`;
		const line = (x: number, y: number) => `L ${n(x)} ${n(y)}`;
		const quarter = (
			fromX: number,
			fromY: number,
			centerX: number,
			centerY: number,
			toX: number,
			toY: number,
		) => {
			const cross = (fromX - centerX) * (toY - centerY) - (fromY - centerY) * (toX - centerX);
			return `A ${n(radius)} ${n(radius)} 0 0 ${cross > 0 ? 1 : 0} ${n(toX)} ${n(toY)}`;
		};

		if (!desktop) {
			// Mobile is just a rounded photo window between the header and card.
			const top = Math.max(headerBox.b, 0);
			const bottom = Math.min(Math.max(cardBox.t, top), height);
			const gap = parseFloat(getComputedStyle(shell).paddingTop) || 0;
			svg.style.display = 'none';
			path.removeAttribute('d');
			media.style.clipPath = `inset(${n(top)}px 0 ${n(Math.max(height - bottom, 0))}px 0 round ${n(radius)}px)`;
			frame.hidden = false;
			frame.style.top = `${n(gap + top)}px`;
			frame.style.left = `${n(gap)}px`;
			frame.style.right = `${n(gap)}px`;
			frame.style.height = `${n(Math.max(bottom - top, 0))}px`;
			frame.style.borderRadius = `${n(radius)}px`;
			return;
		}

		svg.style.display = '';
		frame.hidden = true;
		frame.removeAttribute('style');

		const hy = headerBox.b;
		const hx = headerBox.r;
		const cx = Math.max(ctaBox.l, hx + radius * 2);
		const cy = cardBox.t;
		const cr = cardBox.r;
		const r = radius;
		const outline = [
			move(hx + r, 0),
			line(cx - r, 0),
			quarter(cx - r, 0, cx - r, r, cx, r),
			line(cx, hy - r),
			quarter(cx, hy - r, cx + r, hy - r, cx + r, hy),
			line(width - r, hy),
			quarter(width - r, hy, width - r, hy + r, width, hy + r),
			line(width, height - r),
			quarter(width, height - r, width - r, height - r, width - r, height),
			line(cr + r, height),
			quarter(cr + r, height, cr + r, height - r, cr, height - r),
			line(cr, cy + r),
			quarter(cr, cy + r, cr - r, cy + r, cr - r, cy),
			line(r, cy),
			quarter(r, cy, r, cy - r, 0, cy - r),
			line(0, hy + r),
			quarter(0, hy + r, r, hy + r, r, hy),
			line(hx - r, hy),
			quarter(hx - r, hy, hx - r, hy - r, hx, hy - r),
			line(hx, r),
			quarter(hx, r, hx + r, r, hx + r, 0),
			'Z',
		].join(' ');

		svg.setAttribute('viewBox', `0 0 ${n(width)} ${n(height)}`);
		svg.setAttribute('preserveAspectRatio', 'none');
		path.setAttribute('d', outline);
		media.style.clipPath = `path("${outline}")`;
	}

	let outlineFrame = 0;
	let outlineCleanup: (() => void) | undefined;

	function scheduleHeroOutline() {
		cancelAnimationFrame(outlineFrame);
		outlineFrame = requestAnimationFrame(drawHeroOutline);
	}

	function mountHeroOutline() {
		outlineCleanup?.();
		const shell = document.querySelector('.hero-shell');
		const header = shell?.querySelector('.hero-header');
		const card = shell?.querySelector('.hero-card');
		if (!shell) return;
		const observer = new ResizeObserver(scheduleHeroOutline);
		observer.observe(shell);
		if (header) observer.observe(header);
		if (card) observer.observe(card);
		window.addEventListener('resize', scheduleHeroOutline);
		card?.addEventListener('animationend', scheduleHeroOutline);
		void document.fonts?.ready.then(scheduleHeroOutline);
		window.setTimeout(scheduleHeroOutline, 1400);
		scheduleHeroOutline();
		outlineCleanup = () => {
			observer.disconnect();
			window.removeEventListener('resize', scheduleHeroOutline);
			card?.removeEventListener('animationend', scheduleHeroOutline);
		};
	}

	document.addEventListener('astro:page-load', mountHeroOutline);
	document.addEventListener('astro:before-swap', () => outlineCleanup?.());
</script>

<style>
	.hero-card > * {
		position: relative;
		z-index: 1;
	}

	a:focus-visible {
		outline: 2px solid var(--hero-focus);
		outline-offset: 4px;
	}

	.hero-shell {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		color: var(--hero-copy);
		--hero-frame: var(--page-background);
		--hero-line: var(--border-color);
		--hero-accent: #315d9f;
		--hero-gap: 1rem;
		--hero-radius: 0.95rem;
		--hero-panel-width: 38rem;
		--hero-brand-width: 12.15rem;
		--hero-logo-width: 1.95rem;
		--hero-control-height: 2.25rem;
		--hero-header-height: calc(var(--hero-gap) * 2 + var(--hero-control-height));
		min-height: max(46rem, calc(100svh - var(--announcement-height)));
		padding: var(--hero-gap);
		background: var(--hero-frame);
	}

	.hero-media {
		position: absolute;
		z-index: 0;
		top: var(--hero-gap);
		right: var(--hero-gap);
		bottom: var(--hero-gap);
		left: var(--hero-gap);
		overflow: hidden;
		border-radius: var(--hero-radius);
		background: var(--image-background);
		animation: media-reveal 1.2s 0.05s cubic-bezier(0.2, 0.75, 0.2, 1) both;
	}

	.hero-outline {
		position: absolute;
		z-index: 5;
		top: var(--hero-gap);
		right: var(--hero-gap);
		bottom: var(--hero-gap);
		left: var(--hero-gap);
		width: auto;
		height: auto;
		overflow: visible;
		pointer-events: none;
	}

	.hero-outline path {
		fill: none;
		stroke: var(--hero-line);
		stroke-width: 1.5;
		stroke-linejoin: round;
		stroke-linecap: round;
		vector-effect: non-scaling-stroke;
	}

	.hero-mobile-frame {
		position: absolute;
		z-index: 5;
		box-sizing: border-box;
		border: 1.5px solid var(--hero-line);
		pointer-events: none;
	}

	.hero-mobile-frame[hidden] {
		display: none;
	}

	.hero-art,
	.hero-shade {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 100%;
	}

	.hero-art {
		z-index: 0;
		max-width: none;
		object-fit: cover;
		object-position: center;
		/* Mirror the artwork. `scale` stays independent of hero-settle's transform. */
		scale: -1 1;
		animation: hero-settle 1.8s 0.05s cubic-bezier(0.2, 0.72, 0.2, 1) both;
	}

	/* Mobile only: dims to black as the first paragraph scrolls in (src/lib/scroll-fades.ts). */
	.hero-dim {
		position: absolute;
		z-index: 2;
		inset: 0;
		display: none;
		background: #000;
		opacity: calc(var(--hero-dim, 0) * 0.88);
		pointer-events: none;
	}

	.hero-shade {
		z-index: 1;
		background:
			linear-gradient(180deg, rgb(10 13 22 / 0.12), rgb(10 13 22 / 0.03) 35%, rgb(9 10 14 / 0.6) 100%),
			linear-gradient(90deg, rgb(4 9 20 / 0.28), transparent 55%);
	}

	:global(html[data-theme='light']) .hero-shade {
		background:
			linear-gradient(180deg, rgb(20 52 73 / 0.06), transparent 42%, rgb(16 43 42 / 0.16) 100%),
			linear-gradient(90deg, rgb(9 35 53 / 0.12), transparent 48%);
	}

	.hero-announcement {
		position: absolute;
		z-index: 2;
		top: 28%;
		right: calc(var(--hero-gap) + clamp(1.5rem, 3.5vw, 4.5rem));
		margin: 0;
		color: #fffdf8;
		font-family: var(--font-display);
		font-size: clamp(3rem, 5.4vw, 7rem);
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 0.95;
		text-align: right;
		text-shadow: 0 3px 28px rgb(13 32 77 / 0.6);
		animation: soft-rise 0.75s 0.9s ease-out both;
	}

	.hero-announcement p {
		margin: 0;
	}

	.hero-announcement p > * {
		display: block;
		width: fit-content;
		margin-left: auto;
		white-space: nowrap;
	}

	.hero-announcement-link {
		color: inherit;
		text-decoration: none;
		background: linear-gradient(currentColor, currentColor) left bottom / 0% 0.045em no-repeat;
		padding-bottom: 0.04em;
		-webkit-box-decoration-break: clone;
		box-decoration-break: clone;
		transition: background-size 450ms cubic-bezier(0.2, 0.75, 0.2, 1);
	}

	.hero-announcement-link:hover,
	.hero-announcement-link:focus-visible {
		background-size: 100% 0.045em;
	}

	/* Touch screens can't hover the link, so mobile gets an explicit button. */
	.hero-apply {
		display: none;
		letter-spacing: normal;
		text-shadow: none;
	}

	:global(html[data-theme='light']) .hero-announcement {
		color: #102b2a;
		text-shadow: 0 1px 20px rgb(255 255 255 / 0.7);
	}

	@media (prefers-color-scheme: light) {
		:global(html:not([data-theme='dark'])) .hero-announcement {
			color: #102b2a;
			text-shadow: 0 1px 20px rgb(255 255 255 / 0.7);
		}

		:global(html:not([data-theme='dark'])) .hero-shade {
			background:
				linear-gradient(180deg, rgb(20 52 73 / 0.06), transparent 42%, rgb(16 43 42 / 0.16) 100%),
				linear-gradient(90deg, rgb(9 35 53 / 0.12), transparent 48%);
		}
	}

	.hero-card {
		isolation: isolate;
		position: absolute;
		z-index: 3;
		bottom: 0;
		left: 0;
		overflow: visible;
		width: fit-content;
		max-width: calc(100% - var(--hero-gap));
		padding: 2.1rem 3rem 2rem;
		border: 0;
		border-radius: 0 var(--hero-radius) 0 0;
		color: #fffdf6;
		color: var(--hero-copy);
		background: #06090f;
		background: var(--hero-frame);
		box-shadow: none;
		-webkit-backdrop-filter: none;
		backdrop-filter: none;
		animation: panel-arrive 0.8s 0.35s ease-out both;
	}

	.hero-copy {
		width: fit-content;
		max-width: 100%;
	}
	.hero-copy .intro {
		width: 0;
		min-width: 100%;
		max-width: none;
	}

	.hero-card h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: calc(clamp(2.55rem, 3.1vw, 3.45rem) - 4px);
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 0.88;
		text-wrap: balance;
		text-shadow: 0 2px 24px var(--hero-title-shadow-color);
		animation: soft-rise 0.7s 0.7s ease-out both;
	}

	.intro {
		max-width: 30rem;
		margin: 1.2rem 0 1.3rem;
		color: var(--hero-muted);
		font-size: clamp(0.86rem, 1vw, 0.94rem);
		line-height: 1.42;
		text-shadow: 0 1px 14px var(--hero-copy-shadow-color);
		animation: soft-rise 0.7s 0.85s ease-out both;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem 1.1rem;
		align-items: center;
	}

	.card-link {
		width: fit-content;
		transition: background 180ms ease, transform 180ms ease;
		animation: soft-rise 0.65s 1s ease-out both;
	}

	.card-link:hover,
	.card-link:focus-visible {
		transform: translateY(-2px);
	}

	@keyframes soft-rise {
		from {
			opacity: 0;
			transform: translateY(0.55rem);
		}
	}

	@keyframes panel-arrive {
		from {
			opacity: 0;
			transform: translateY(0.7rem);
		}
	}

	@keyframes media-reveal {
		from {
			opacity: 0;
			clip-path: inset(2.5% 2.5% 2.5% 2.5% round 1.2rem);
		}
	}

	@keyframes hero-settle {
		from {
			opacity: 0.72;
			transform: scale(1.025);
		}
	}

	@media (max-width: 700px) {
		.hero-shell {
			--hero-gap: 0.6rem;
			--hero-radius: 0.75rem;
			--hero-panel-width: calc(100% - var(--hero-gap));
			--hero-brand-width: 9.6rem;
			--hero-logo-width-mobile: 1.6rem;
			--hero-control-height: 2rem;
			/* The photo fills the first screen; the card flows in below it. */
			--hero-screen: max(36rem, calc(100svh - var(--announcement-height)));
			min-height: 0;
			padding: var(--hero-gap);
		}

		.hero-media {
			top: var(--hero-gap);
			right: var(--hero-gap);
			bottom: auto;
			left: var(--hero-gap);
			height: calc(var(--hero-screen) - var(--hero-gap) * 2);
			border-radius: var(--hero-radius);
		}

		.hero-outline {
			display: none;
		}

		.hero-dim {
			display: block;
		}

		/* The headline and button sink into the same black. */
		.hero-announcement {
			opacity: calc(1 - var(--hero-dim, 0) * 0.88);
		}

		/* Drop the towers below the headline; the sky colour fills the gap above. */
		.hero-media:has(.hero-art-night) {
			background: rgb(1 23 72);
		}

		.hero-media:has(.hero-art-day) {
			background: rgb(99 168 239);
		}

		.hero-art {
			object-position: 61.8% 38.2%;
			translate: 0 29%;
			-webkit-mask-image: linear-gradient(transparent, #000 12%);
			mask-image: linear-gradient(transparent, #000 12%);
		}


		.hero-announcement {
			/* A sixth of the way down the photo window. */
			top: calc(var(--hero-header-height) + (var(--hero-screen) - var(--hero-header-height) - var(--hero-gap)) / 6);
			right: calc(var(--hero-gap) + 1rem);
			left: calc(var(--hero-gap) + 1rem);
			font-size: min(7.2vw, 2.4rem);
			text-align: center;
		}

		.hero-announcement p > * {
			margin-inline: auto;
		}

		.hero-apply {
			display: flex;
			width: fit-content;
			min-height: 2.5rem;
			margin: 0.9rem auto 0;
			padding: 0.45rem 1.1rem;
		}

		/* The Apply now button takes over here, so the headline is plain text. */
		.hero-announcement-link {
			background: none;
			pointer-events: none;
		}

		.hero-card {
			position: relative;
			width: auto;
			max-width: 38rem;
			margin: calc(var(--hero-screen) - var(--hero-gap)) auto 0;
			padding: 14rem 0.65rem 0;
			border-radius: 0;
			text-align: center;
			animation: none;
		}

		.hero-copy {
			width: auto;
		}

		/* The hero headline size less 2px; MissionSection's h2 matches. */
		.hero-card h1,
		.hero-copy .intro {
			margin: 0;
			color: var(--text-heading);
			font-family: var(--font-display);
			font-size: calc(min(7.2vw, 2.4rem) - 2px);
			font-weight: 400;
			letter-spacing: -0.035em;
			line-height: 0.95;
			text-shadow: none;
			animation: none;
		}

		.hero-copy .intro {
			width: auto;
			max-width: none;
			margin-top: 9rem;
		}

		.hero-card h1 br {
			display: none;
		}

