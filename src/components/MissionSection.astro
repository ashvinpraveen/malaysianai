---
import { Image } from 'astro:assets';
import bungaRaya from '../assets/malaysian-ai-bunga-raya-pixel.png';
import { LUMA_URL } from '../consts';
import HibiscusPetals from './HibiscusPetals.astro';
---

<section class="mission-section light-nav-zone" id="about" aria-labelledby="mission-title">
	<div class="mission-events">
		<HibiscusPetals
			petals={[
				{ x: '86%', y: '-7.5rem', row: 1, size: 38, delay: 0.9, speed: 1.1, appearAt: 0.78 },
				{ x: '24%', y: '-5.25rem', row: 0, size: 30, flip: true, delay: 0.4, appearAt: 0.55 },
				{ x: '59%', y: '-2.75rem', row: 2, size: 24, delay: 1.3, speed: 1.4, appearAt: 0.68 },
				{ x: '6%', y: '3.5rem', row: 3, size: 36, delay: 0.1, speed: 1, appearAt: 0.82 },
				{ x: '67%', y: '5.75rem', row: 1, size: 44, flip: true, delay: 0.6, appearAt: 0.62 },
				{ x: '37%', y: '9.5rem', row: 0, size: 28, delay: 1.8, speed: 1.2, appearAt: 0.74 },
			]}
		/>
		<h2 id="mission-title" data-word-reveal>Your first step into AI starts here.</h2>
		<figure class="mission-flower">
			<Image
				class="mission-flower-image"
				src={bungaRaya}
				alt="A pixel-art bunga raya plant with a red hibiscus bloom"
				widths={[240, 480, 640, 960]}
				sizes="(max-width: 900px) min(45vw, 14rem), 30rem"
				format="webp"
				quality={90}
				loading="lazy"
				decoding="async"
			/>
		</figure>

		<div class="mission-calendar">
			<a class="site-button mission-events-link" href={LUMA_URL}>View all upcoming events</a>
			<div class="luma-frame">
				<iframe
					src="https://luma.com/embed/calendar/cal-pPgkuwCFrycSv1Z/events"
					title="Malaysian AI upcoming events on Luma"
					loading="lazy"
					allow="clipboard-write; payment"
				></iframe>
			</div>
		</div>
	</div>
</section>

<script>
	import { mountWordReveal } from '../lib/word-reveal';
	import { mountScrollFades } from '../lib/scroll-fades';

	let cleanups: (() => void)[] = [];
	const unmount = () => {
		cleanups.forEach(cleanup => cleanup());
		cleanups = [];
	};
	document.addEventListener('astro:page-load', () => {
		unmount();
		cleanups = [mountWordReveal(), mountScrollFades()];
	});
	document.addEventListener('astro:before-swap', unmount);
</script>

<style>

	.mission-section {
		position: relative;
		display: grid;
		min-height: 100dvh;
		padding: var(--section-space) clamp(1.25rem, 6vw, 6rem);
		overflow: hidden;
		color: var(--text-heading);
		background: var(--page-background);
	}

	.mission-events {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		align-content: center;
		align-items: center;
		gap: clamp(2.5rem, 5vw, 5rem);
		width: min(100%, 82rem);
		height: 100%;
		margin: auto;
	}

	.mission-flower {
		display: grid;
		align-self: center;
		min-width: 0;
		margin: 0;
		place-items: center;
	}

	.mission-flower-image {
		display: block;
		width: min(100%, 30rem);
		aspect-ratio: 1122 / 1402;
		image-rendering: pixelated;
		transform-origin: 50% 88%;
		animation: flower-sway 5.5s ease-in-out infinite alternate;
	}

	.mission-calendar {
		display: grid;
		align-self: center;
		gap: clamp(1.5rem, 3vh, 2.25rem);
		min-width: 0;
	}

	.mission-events h2 {
		grid-column: 1 / -1;
		justify-self: center;
		max-width: 36rem;
		margin: 0;
		text-align: center;
		font-family: var(--font-display);
		font-size: clamp(2.4rem, 3.4vw, 3.6rem);
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 0.9;
		text-wrap: balance;
	}

	/* Mobile only: replaces the hero card's events button. */
	.mission-events-link {
		display: none;
	}

	.luma-frame {
		overflow: hidden;
		width: 100%;
		height: min(56dvh, 32rem);
		padding: 0.35rem;
		border: 1px solid var(--hairline);
		border-radius: 1rem;
		background: var(--page-background);
		content-visibility: auto;
		contain-intrinsic-size: 720px;
	}

	.luma-frame iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
		border-radius: 0.75rem;
		background: var(--page-background);
	}

	@media (max-width: 900px) {
		.mission-section {
			height: auto;
			max-height: none;
			overflow: visible;
		}

		.mission-events {
			grid-template-columns: 1fr;
			gap: 2rem;
			max-width: 38rem;
			height: auto;
		}

		.mission-flower-image {
			width: min(45vw, 14rem);
		}

		.mission-events h2 {
			font-size: clamp(2.8rem, 13vw, 4.2rem);
		}

		.luma-frame iframe {
			height: 100%;
		}

		.luma-frame {
			height: min(62dvh, 32rem);
		}
	}

	@keyframes flower-sway {
		0% {
			transform: translate3d(-0.2rem, 0.1rem, 0) rotate(-0.75deg);
		}
		55% {
			transform: translate3d(0.12rem, -0.28rem, 0) rotate(0.2deg);
		}
		100% {
			transform: translate3d(0.35rem, 0, 0) rotate(0.8deg);
		}
	}

	@media (max-width: 700px) {

		.mission-section {
			min-height: auto;
			padding: 9rem 1.25rem 7rem;
		}

		.mission-events {
			position: relative;
		}

		.mission-events > :not(.petals) {
			position: relative;
			z-index: 1;
		}

		/* Room below the last paragraph before the hibiscus rises out of black. */
		.mission-flower {
			margin-top: 12rem;
		}

		.mission-flower-image {
			opacity: var(--flower-reveal, 1);
			filter: brightness(var(--flower-reveal, 1));
		}

		.mission-calendar {
			gap: 0.75rem;
		}

		/* Same size as the hero's centred copy above. */
		.mission-events h2 {
			font-size: calc(min(7.2vw, 2.4rem) - 2px);
			line-height: 0.95;
		}

		.mission-events-link {
			display: inline-flex;
			justify-self: end;
		}

	}
</style>
