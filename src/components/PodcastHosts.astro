---
interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;

const ashvin = {
	name: 'Ashvin Praveen',
	href: 'https://ashvinpraveen.com',
};
const ken = {
	name: 'Ken Ooi',
	href: 'https://www.linkedin.com/in/ken-ooi-00926b218/',
	instagram: 'https://instagram.com/kenbuilds.mp4',
};
---

<p class:list={['hosts', { compact }]}>
	Hosted by <a href={ashvin.href} target="_blank" rel="noopener noreferrer">{ashvin.name}</a>{' & '}<span class="host"><a href={ken.href} target="_blank" rel="noopener noreferrer">{ken.name}</a>
		<a class="instagram" href={ken.instagram} target="_blank" rel="noopener noreferrer" aria-label="Ken Ooi on Instagram">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8" />
				<circle cx="12" cy="12" r="4.1" fill="none" stroke="currentColor" stroke-width="1.8" />
				<circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" />
			</svg>
		</a>
	</span>
</p>

<style>
	.hosts {
		margin: 1rem 0 0;
		color: var(--text-heading);
		font-size: var(--text-base);
		line-height: var(--leading-body);
	}

	.hosts.compact {
		margin: 0.85rem 0 0;
		color: var(--text-soft);
		font-size: var(--text-sm);
	}

	.host {
		white-space: nowrap;
	}

	.hosts a {
		color: inherit;
	}

	.hosts a:not(.instagram) {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
	}

	.instagram {
		display: inline-flex;
		margin-inline-start: 0.28rem;
		text-decoration: none;
		vertical-align: -0.15em;
	}

	.instagram svg {
		width: 0.95em;
		height: 0.95em;
	}

	.hosts a:hover,
	.hosts a:focus-visible {
		color: var(--link-bright);
	}

	.hosts a:focus-visible {
		outline: 2px solid var(--link-bright);
		outline-offset: 3px;
	}
</style>
