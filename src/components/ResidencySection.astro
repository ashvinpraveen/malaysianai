---
import { Image } from 'astro:assets';
import showAndTell from '../assets/events/show-and-tell-supabase-ceo.png';
import { residents } from '../data/residents';
import { APPLY_FORM_URL, LUMA_URL } from '../consts';
---

<section class="residency-chapter light-nav-zone" id="residency" aria-labelledby="residency-title">
	<div class="residency-shell">
		<div class="residency-hero">
			<div class="residency-copy">
				<h2 id="residency-title">Join the Malaysian.ai<br />residency.</h2>
				<p class="residency-term">1 October – 30 November 2026 · Full-time, in person</p>
				<p class="residency-lede">
					For founders, builders, marketers, designers and creators looking to go
					all-in on companies, products, research or projects — built with AI. Apply
					to join our 8-week residency at the Malaysian.ai space.
				</p>
				<div class="residency-actions">
					<a class="residency-cta site-button" href="/residency">Learn more</a>
					<a class="residency-apply" href={APPLY_FORM_URL}>Apply now</a>
				</div>
			</div>

			<figure class="residency-photo">
				<Image
					src={showAndTell}
					alt="Builders gathered for a Show & Tell at the Malaysian.ai space"
					widths={[540, 810, 1080]}
					sizes="(max-width: 860px) calc(100vw - 3rem), min(38rem, 48vw)"
					format="webp"
					quality={85}
					loading="lazy"
					decoding="async"
				/>
				<figcaption>
					<a href={LUMA_URL}>Thursday Show &amp; Tell</a>
					— come meet the community and get a feel for the residency.
				</figcaption>
			</figure>
		</div>

		<div class="residency-panel">
			<p class="residency-residents-kicker">Current residents</p>
			<div class="residency-frame">
				<div class="residency-marquee" aria-label="Current resident startups">
					{
						[false, true].map((isClone) => (
							<ul class="residency-track" aria-hidden={isClone ? 'true' : undefined}>
								{residents.map((resident) => (
									<li>
										<a
											class="resident-tile"
											href={resident.website}
											target="_blank"
											rel="noopener"
											tabindex={isClone ? -1 : undefined}
										>
											<span class="resident-face">
												{resident.logo ? (
													<img
														class:list={['resident-logo', resident.logoClass]}
														src={resident.logo}
														alt=""
														width="160"
														height="160"
														loading="lazy"
														decoding="async"
													/>
												) : (
													<span class="resident-wordmark">{resident.wordmark}</span>
												)}
											</span>
											<span class="resident-name">{resident.name}</span>
										</a>
									</li>
								))}
							</ul>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.residency-chapter {
		padding: var(--section-space) clamp(1.5rem, 4vw, 4rem) var(--section-space-half);
		color: var(--text-bright);
		background: var(--page-background);
	}

	.residency-shell {
		display: grid;
		gap: clamp(2.25rem, 4.5vw, 3.75rem);
		width: min(72rem, 100%);
		margin: 0 auto;
	}

	.residency-hero {
		display: grid;
		grid-template-columns: minmax(18rem, 0.92fr) minmax(20rem, 1.08fr);
		gap: clamp(1.75rem, 4vw, 3.5rem);
		align-items: center;
	}

	.residency-copy {
		display: grid;
		gap: 1.35rem;
		align-content: center;
		min-width: 0;
	}

	.residency-copy h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.3rem, 3.8vw, 3.6rem);
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 0.9;
		text-wrap: balance;
	}

	.residency-term {
		margin: 0;
		color: var(--text-accent);
		font-size: 0.78rem;
		letter-spacing: 0.04em;
		line-height: 1.4;
	}

	.residency-lede {
		max-width: 34rem;
		margin: 0;
		color: var(--text-soft);
		font-size: clamp(0.92rem, 1.25vw, 1.08rem);
		line-height: var(--leading-body);
	}

	.residency-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.15rem 1.35rem;
	}

	.residency-cta {
		transition: background 180ms ease, transform 180ms ease;
	}

	.residency-cta:hover,
	.residency-cta:focus-visible {
		transform: translateY(-2px);
	}

	.residency-apply {
		color: var(--text-accent);
		font-size: 0.84rem;
		line-height: 1;
		text-underline-offset: 0.22em;
	}

	.residency-apply:hover,
	.residency-apply:focus-visible {
		color: var(--link-bright);
	}

	.residency-apply:focus-visible,
	.residency-cta:focus-visible {
		outline: 2px solid var(--focus-color);
		outline-offset: 4px;
	}

	.residency-photo {
		min-width: 0;
		margin: 0;
	}

	.residency-photo :global(img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		object-position: 50% 28%;
		border-radius: var(--radius-media);
		background: var(--image-background);
	}

	.residency-photo figcaption {
		margin-top: 0.7rem;
		color: var(--text-softer);
		font-size: 0.78rem;
		line-height: 1.5;
	}

	.residency-photo figcaption a {
		color: var(--text-accent);
		text-underline-offset: 0.2em;
	}

	.residency-photo figcaption a:hover,
	.residency-photo figcaption a:focus-visible {
		color: var(--link-bright);
	}

	.residency-photo figcaption a:focus-visible {
		outline: 2px solid var(--focus-color);
		outline-offset: 3px;
	}

	.residency-panel {
		min-width: 0;
		overflow: hidden;
	}

	.residency-residents-kicker {
		margin: 0 0 0.85rem;
		color: var(--text-softer);
		font-size: 0.68rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.residency-frame {
		min-width: 0;
		overflow: hidden;
	}

	.residency-marquee {
		display: flex;
		overflow: hidden;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
	}

	.residency-track {
		display: flex;
		flex: 0 0 auto;
		gap: clamp(1rem, 2vw, 1.6rem);
		min-width: 100%;
		margin: 0;
		padding: 0;
		list-style: none;
		animation: residency-scroll 42s linear infinite;
	}

	.residency-marquee:hover .residency-track,
	.residency-marquee:focus-within .residency-track {
		animation-play-state: paused;
	}

	.resident-tile {
		display: grid;
		gap: 0.55rem;
		width: clamp(5.75rem, 8vw, 7.25rem);
		justify-items: center;
		text-align: center;
		text-decoration: none;
	}

	.resident-face {
		display: grid;
		width: 100%;
		aspect-ratio: 1.15;
		place-items: center;
		overflow: hidden;
		border: 1px solid var(--hairline-soft);
		border-radius: var(--radius-media);
		background:
			radial-gradient(circle at 50% 40%, rgb(255 255 255 / 0.9), transparent 62%),
			#e9edf3;
		transition: transform 200ms ease;
	}

	.resident-tile:hover .resident-face,
	.resident-tile:focus-visible .resident-face {
		transform: translateY(-2px);
	}

	.resident-tile:focus-visible {
		outline: 2px solid var(--focus-color);
		outline-offset: 4px;
		border-radius: var(--radius-media);
	}

	.resident-logo {
		width: 52%;
		height: 52%;
		object-fit: contain;
	}

	.resident-logo.is-wide {
		width: 74%;
	}

	.resident-wordmark {
		padding: 0.4rem 0.7rem;
		border: 1.5px solid #12233d;
		border-radius: 0.9rem 0.9rem 0.9rem 0.2rem;
		color: #12233d;
		font: 700 clamp(0.62rem, 0.8vw, 0.74rem) / 1 ui-monospace, 'SFMono-Regular', monospace;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.resident-name {
		color: var(--text-softer);
		font-size: 0.7rem;
		letter-spacing: 0.02em;
	}

	@keyframes residency-scroll {
		to {
			transform: translateX(-100%);
		}
	}

	@media (max-width: 860px) {
		.residency-hero {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.residency-copy {
			display: contents;
		}

		.residency-copy h2 {
			order: 1;
		}

		.residency-term {
			order: 2;
		}

		.residency-photo {
			order: 3;
		}

		.residency-lede {
			order: 4;
			max-width: 40rem;
		}

		.residency-actions {
			order: 5;
		}
	}

	@media (max-width: 700px) {
		.residency-chapter {
			padding: 3.25rem 1rem var(--section-space-half);
		}

		.residency-shell {
			gap: 2.25rem;
		}

		.residency-copy h2 {
			font-size: clamp(2.3rem, 10vw, 3.25rem);
		}

		.residency-actions {
			gap: 1rem 1.15rem;
		}

		.resident-tile {
			width: clamp(5.5rem, 26vw, 6.75rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.residency-track {
			animation: none;
		}

		.residency-marquee {
			overflow-x: auto;
			-webkit-mask-image: none;
			mask-image: none;
		}

		.residency-track[aria-hidden='true'] {
			display: none;
		}
	}
</style>
