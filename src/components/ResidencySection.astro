---
import { residents } from '../data/residents';
---

<section class="residency-chapter light-nav-zone" id="residency" aria-labelledby="residency-title">
	<div class="residency-intro">
		<div class="residency-heading">
			<p class="residency-kicker">The Residency</p>
			<h2 id="residency-title">Home to ambitious<br />Malaysian AI startups.</h2>
		</div>

		<div class="residency-grip">
			<p class="residency-lede">
				A working home for founders building serious AI products. Residents win
				hackathons, organise regional movements, raise venture capital, and ship at
				the edge of the technology &mdash; together, from Kuala Lumpur.
			</p>
			<div class="residency-actions">
				<a class="residency-cta site-button" href="/residency">Explore the residency</a>
				<a class="residency-directory" href="/residents">
					Meet the residents
					<span aria-hidden="true">&#8599;</span>
				</a>
			</div>
		</div>
	</div>

	<div class="residency-panel">
		<div class="residency-frame">
			<div class="residency-marquee" aria-label="Current resident startups">
			{
				[false, true].map((isClone) => (
					<ul class="residency-track" aria-hidden={isClone ? 'true' : undefined}>
						{residents.map((resident) => (
							<li>
								<a
									class="resident-tile"
									href={resident.website}
									target="_blank"
									rel="noopener"
									tabindex={isClone ? -1 : undefined}
								>
									<span class="resident-face">
										{resident.logo ? (
											<img
												class:list={['resident-logo', resident.logoClass]}
												src={resident.logo}
												alt=""
												width="160"
												height="160"
												loading="lazy"
												decoding="async"
											/>
										) : (
											<span class="resident-wordmark">{resident.wordmark}</span>
										)}
									</span>
									<span class="resident-meta">
										<span class="resident-name">{resident.name}</span>
										<span class="resident-tag">{resident.tag}</span>
									</span>
								</a>
							</li>
						))}
					</ul>
				))
			}
			</div>
		</div>
	</div>
</section>

<style>
	.residency-chapter {
		padding: clamp(0.75rem, 1.6vw, 1.5rem);
		color: var(--text-bright);
		background: var(--page-background);
	}

	.residency-heading {
		padding: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 3.5vw, 3.25rem) clamp(1.75rem, 3vw, 2.5rem);
	}

	.residency-kicker {
		margin: 0 0 1.1rem;
		color: var(--text-accent);
		font-size: 0.7rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.residency-heading h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.3rem, 3.8vw, 3.6rem);
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 0.9;
		text-wrap: balance;
	}

	.residency-frame {
		overflow: hidden;
		border: 1.5px solid rgb(115 152 207 / 0.55);
		border-radius: 0.95rem 0.95rem 0 0.95rem;
		background: var(--page-background);
	}

	/* Hangs below the strip; its background hides the strip's bottom border
	   underneath it so the outline reads as one continuous shape. */
	.residency-grip {
		position: relative;
		z-index: 1;
		display: grid;
		gap: 1.5rem;
		justify-items: end;
		width: min(36rem, 100%);
		margin-top: -1.5px;
		margin-left: auto;
		padding: clamp(1.5rem, 2.5vw, 2.25rem);
		border: 1.5px solid rgb(115 152 207 / 0.55);
		border-top: 0;
		border-radius: 0 0 0.95rem 0.95rem;
		background: var(--page-background);
		text-align: right;
	}

	.residency-lede {
		max-width: 31rem;
		margin: 0;
		color: rgb(224 232 244 / 0.72);
		font-size: clamp(0.92rem, 1.25vw, 1.08rem);
		line-height: var(--leading-body);
	}

	.residency-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.35rem;
	}

	.residency-cta {
		transition: background 180ms ease, transform 180ms ease;
	}

	.residency-cta:hover,
	.residency-cta:focus-visible {
		transform: translateY(-2px);
	}

	.residency-directory {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding-bottom: 0.2rem;
		border-bottom: 1px solid rgb(169 199 239 / 0.45);
		color: var(--text-accent);
		font-size: 0.84rem;
		line-height: 1;
		text-decoration: none;
		transition: color 180ms ease, border-color 180ms ease;
	}

	.residency-directory:hover,
	.residency-directory:focus-visible {
		border-color: #dce9fb;
		color: #dce9fb;
	}

	.residency-marquee {
		display: flex;
		overflow: hidden;
		padding: clamp(1.5rem, 2.5vw, 2.25rem) 0;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
	}

	.residency-track {
		display: flex;
		flex: 0 0 auto;
		gap: clamp(1.5rem, 3vw, 2.75rem);
		min-width: 100%;
		margin: 0;
		padding: 0 clamp(0.75rem, 1.5vw, 1.4rem);
		list-style: none;
		animation: residency-scroll 36s linear infinite;
	}

	.residency-marquee:hover .residency-track,
	.residency-marquee:focus-within .residency-track {
		animation-play-state: paused;
	}

	.resident-tile {
		display: grid;
		gap: 0.85rem;
		width: clamp(9.5rem, 12.5vw, 12rem);
		justify-items: center;
		text-align: center;
		text-decoration: none;
	}

	.resident-face {
		display: grid;
		width: 100%;
		aspect-ratio: 1.35;
		place-items: center;
		overflow: hidden;
		border-radius: var(--radius-media);
		background:
			radial-gradient(circle at 50% 40%, rgb(255 255 255 / 0.9), transparent 62%),
			#e9edf3;
		transition: transform 200ms ease;
	}

	.resident-tile:hover .resident-face,
	.resident-tile:focus-visible .resident-face {
		transform: translateY(-3px);
	}

	.resident-tile:focus-visible {
		outline: 2px solid #9bbbe7;
		outline-offset: 4px;
		border-radius: var(--radius-media);
	}

	.resident-logo {
		width: 52%;
		height: 52%;
		object-fit: contain;
	}

	.resident-logo.is-wide {
		width: 74%;
	}

	.resident-wordmark {
		padding: 0.5rem 0.85rem;
		border: 1.5px solid #12233d;
		border-radius: 0.9rem 0.9rem 0.9rem 0.2rem;
		color: #12233d;
		font: 700 clamp(0.72rem, 0.9vw, 0.85rem) / 1 ui-monospace, 'SFMono-Regular', monospace;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.resident-meta {
		display: grid;
		gap: 0.3rem;
	}

	.resident-name {
		color: var(--text-bright);
		font-size: 0.82rem;
		letter-spacing: 0.02em;
	}

	.resident-tag {
		color: rgb(224 232 244 / 0.55);
		font-size: 0.7rem;
		line-height: 1.35;
	}

	@keyframes residency-scroll {
		to {
			transform: translateX(-100%);
		}
	}

	@media (max-width: 700px) {
		.residency-chapter {
			padding: 0.65rem;
		}

		.residency-heading {
			padding: 2rem 1rem 1.5rem;
		}

		.residency-heading h2 {
			font-size: clamp(2.3rem, 10vw, 3.25rem);
		}

		.residency-frame {
			border-radius: 0.95rem 0.95rem 0 0;
		}

		.residency-grip {
			justify-items: start;
			width: 100%;
			padding: 1.5rem 1.25rem;
			text-align: left;
		}

		.resident-tile {
			width: clamp(8.5rem, 40vw, 10rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.residency-track {
			animation: none;
		}

		.residency-marquee {
			overflow-x: auto;
			-webkit-mask-image: none;
			mask-image: none;
		}

		.residency-track[aria-hidden='true'] {
			display: none;
		}
	}

	/* Minimal centered residency composition. */
	.residency-chapter {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(3rem, 6vw, 5rem);
		min-height: 100dvh;
		padding: clamp(4rem, 7vw, 6rem) clamp(1.5rem, 4vw, 4rem);
		align-content: center;
		overflow: hidden;
	}

	.residency-intro,
	.residency-panel,
	.residency-frame {
		min-width: 0;
		max-width: 100%;
	}

	.residency-intro {
		display: grid;
		gap: 1.75rem;
		width: min(47rem, 100%);
		margin: 0 auto;
		text-align: center;
	}

	.residency-heading {
		padding: 0;
	}

	.residency-panel {
		width: 100%;
		overflow: hidden;
	}

	.residency-frame {
		width: min(72rem, 100%);
		margin: 0 auto;
		border: 0;
		border-radius: 0;
		background: transparent;
	}

	.residency-grip {
		position: static;
		display: grid;
		gap: 1.35rem;
		justify-items: center;
		width: 100%;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		text-align: center;
	}

	.residency-lede {
		max-width: 40rem;
	}

	.residency-actions {
		justify-content: center;
		gap: 1.25rem;
	}

	.residency-marquee {
		padding: 1rem 0;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
	}

	.residency-track {
		gap: clamp(1.25rem, 2.5vw, 2rem);
		animation-duration: 42s;
	}

	.resident-tile {
		gap: 0.65rem;
		width: clamp(7.5rem, 10vw, 9.5rem);
	}

	.resident-face {
		aspect-ratio: 1.2;
	}

	.resident-meta {
		display: block;
	}

	.resident-name {
		font-size: 0.76rem;
	}

	.resident-tag {
		display: none;
	}

	@media (max-width: 700px) {
		.residency-chapter {
			gap: 2.75rem;
			min-height: auto;
			padding: 3.5rem 1rem;
		}

		.residency-heading {
			padding: 0;
		}

		.residency-grip {
			justify-items: center;
			padding: 0;
			text-align: center;
		}

		.resident-tile {
			width: clamp(7.25rem, 34vw, 8.75rem);
		}
	}
</style>
