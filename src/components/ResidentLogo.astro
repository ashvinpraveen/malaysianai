---
import type { Resident } from '../data/residents';
interface Props { resident: Resident }
const { resident } = Astro.props;
---
<span class="resident-logo" aria-hidden="true">
	{resident.logo ? (
		<img
			class:list={{
				wide: resident.logoClass?.includes('is-wide'),
				mono: resident.logoClass?.includes('is-mono'),
			}}
			src={resident.logo}
			alt=""
			width="100"
			height="48"
			loading="lazy"
			decoding="async"
		/>
	) : (
		<span class="wordmark">{resident.wordmark ?? resident.name}</span>
	)}
</span>
<style>
	.resident-logo { display: flex; align-items: center; justify-content: center; width: 100%; max-width: 6.25rem; height: 3rem; color: var(--text-heading); }
	img { display: block; width: 3rem; height: 3rem; object-fit: contain; }
	img.wide { width: 6.25rem; filter: brightness(0) invert(1); }
	img.mono:not(.wide) { filter: invert(1); }
	:global(html[data-theme='light']) img.wide,
	:global(html[data-theme='light']) img.mono { filter: brightness(0); }
	@media (prefers-color-scheme: light) {
		:global(html:not([data-theme='dark'])) img.wide,
		:global(html:not([data-theme='dark'])) img.mono { filter: brightness(0); }
	}
	.wordmark { font-size: var(--text-base); font-weight: 700; letter-spacing: -0.04em; white-space: nowrap; }
</style>
