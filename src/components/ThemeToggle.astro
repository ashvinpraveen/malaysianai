<div class="theme-toggle" role="radiogroup" aria-label="Appearance">
	<button type="button" role="radio" data-theme-option="system" aria-label="System" aria-checked="true" tabindex="0" title="System">
		<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
			<rect x="2.5" y="2.5" width="11" height="8" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.25" />
			<path d="M5.5 13.5h5M8 10.5v3" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
		</svg>
	</button>
	<button type="button" role="radio" data-theme-option="light" aria-label="Light" aria-checked="false" tabindex="-1" title="Light">
		<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
			<circle cx="8" cy="8" r="2.4" fill="none" stroke="currentColor" stroke-width="1.25" />
			<path
				d="M8 2.2v1.4M8 12.4v1.4M2.2 8h1.4M12.4 8h1.4M3.9 3.9l1 1M11.1 11.1l1 1M12.1 3.9l-1 1M4.9 11.1l-1 1"
				fill="none"
				stroke="currentColor"
				stroke-width="1.25"
				stroke-linecap="round"
			/>
		</svg>
	</button>
	<button type="button" role="radio" data-theme-option="dark" aria-label="Dark" aria-checked="false" tabindex="-1" title="Dark">
		<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
			<path
				d="M9.4 2.6A5.4 5.4 0 1 0 13.4 9 4.2 4.2 0 0 1 9.4 2.6Z"
				fill="none"
				stroke="currentColor"
				stroke-width="1.25"
				stroke-linejoin="round"
			/>
		</svg>
	</button>
</div>

<script>
	import { systemTheme, type Theme } from '../lib/theme';

	type ThemePreference = 'light' | 'dark' | 'system';
	const STORAGE_KEY = 'malaysianai-theme';
	const LIGHT_THEME_COLOR = '#f4efe6';
	const DARK_THEME_COLOR = '#06090f';

	function isPreference(value: string | null | undefined): value is ThemePreference {
		return value === 'light' || value === 'dark' || value === 'system';
	}

	function currentPreference(): ThemePreference {
		const stored = document.documentElement.dataset.themePreference;
		return isPreference(stored) ? stored : 'system';
	}

	function resolveTheme(preference: ThemePreference): Theme {
		switch (preference) {
			case 'light':
			case 'dark':
				return preference;
			case 'system':
				return systemTheme();
			default: {
				const exhaustive: never = preference;
				return exhaustive;
			}
		}
	}

	function optionFromButton(button: HTMLButtonElement): ThemePreference {
		return isPreference(button.dataset.themeOption) ? button.dataset.themeOption : 'system';
	}

	function applyPreference(preference: ThemePreference) {
		const theme = resolveTheme(preference);
		const root = document.documentElement;
		root.dataset.theme = theme;
		root.dataset.themePreference = preference;
		root.style.colorScheme = theme;
		localStorage.setItem(STORAGE_KEY, preference);
		document.querySelector('meta[name="theme-color"]')?.setAttribute(
			'content',
			theme === 'light' ? LIGHT_THEME_COLOR : DARK_THEME_COLOR,
		);
		document.querySelectorAll<HTMLButtonElement>('[data-theme-option]').forEach(button => {
			const selected = button.dataset.themeOption === preference;
			button.setAttribute('aria-checked', selected ? 'true' : 'false');
			button.tabIndex = selected ? 0 : -1;
		});
	}

	function moveSelection(event: KeyboardEvent) {
		const keys = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End'] as const;
		type MoveKey = (typeof keys)[number];
		if (!keys.includes(event.key as MoveKey)) return;

		const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-option]')];
		if (buttons.length === 0) return;

		const current = buttons.findIndex(button => button.getAttribute('aria-checked') === 'true');
		const key = event.key as MoveKey;
		let next: number;
		switch (key) {
			case 'ArrowLeft':
			case 'ArrowUp':
				next = current <= 0 ? buttons.length - 1 : current - 1;
				break;
			case 'ArrowRight':
			case 'ArrowDown':
				next = current >= buttons.length - 1 ? 0 : current + 1;
				break;
			case 'Home':
				next = 0;
				break;
			case 'End':
				next = buttons.length - 1;
				break;
			default: {
				const exhaustive: never = key;
				return exhaustive;
			}
		}

		const nextButton = buttons[next];
		if (!nextButton) return;

		event.preventDefault();
		applyPreference(optionFromButton(nextButton));
		nextButton.focus();
	}

	let themeController: AbortController | undefined;

	function prepareThemeToggle() {
		themeController?.abort();
		const controller = new AbortController();
		themeController = controller;
		applyPreference(currentPreference());
		document.querySelectorAll<HTMLButtonElement>('[data-theme-option]').forEach(button => {
			button.addEventListener('click', () => applyPreference(optionFromButton(button)), { signal: controller.signal });
		});
		document.querySelectorAll('.theme-toggle').forEach(group => {
			group.addEventListener('keydown', event => moveSelection(event as KeyboardEvent), { signal: controller.signal });
		});
	}

	document.addEventListener('astro:page-load', prepareThemeToggle);
	document.addEventListener('astro:before-swap', event => {
		themeController?.abort();
		const preference = currentPreference();
		const theme = resolveTheme(preference);
		event.newDocument.documentElement.dataset.theme = theme;
		event.newDocument.documentElement.dataset.themePreference = preference;
		event.newDocument.documentElement.style.colorScheme = theme;
		event.newDocument.querySelector('meta[name="theme-color"]')?.setAttribute(
			'content',
			theme === 'light' ? LIGHT_THEME_COLOR : DARK_THEME_COLOR,
		);
	});
	window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
		if (currentPreference() === 'system') applyPreference('system');
	});
</script>

<style>
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.15rem;
	}

	.theme-toggle button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.7rem;
		height: 1.7rem;
		padding: 0;
		border: 0;
		border-radius: 0.3rem;
		color: var(--footer-meta);
		background: transparent;
		cursor: pointer;
		transition: color 160ms ease, background 160ms ease;
	}

	.theme-toggle button svg {
		width: 0.95rem;
		height: 0.95rem;
	}

	.theme-toggle button:hover,
	.theme-toggle button:focus-visible {
		color: var(--footer-text);
	}

	.theme-toggle button[aria-checked='true'] {
		color: var(--footer-text);
		background: var(--card-background);
	}

	.theme-toggle button:focus-visible {
		outline: 2px solid var(--focus-color);
		outline-offset: 2px;
	}
</style>
