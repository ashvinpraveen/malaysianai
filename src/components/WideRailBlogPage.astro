---
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featuredPost, ...otherPosts] = posts;
---

<Layout title={`Stories | ${SITE_TITLE}`} description="Stories from Malaysian AI.">
	<section class="split-blog" aria-labelledby="split-title">
		<header class="page-heading">
			<h1 id="split-title">Malaysian AI Blog</h1>
		</header>

		{featuredPost && (
			<article class="lead-story">
				<a class="lead-image" href={`/blog/${featuredPost.id}`} aria-label={`Read ${featuredPost.data.title}`}>
					{featuredPost.data.image ? (
						<img
							src={featuredPost.data.image}
							alt={featuredPost.data.imageAlt ?? ''}
							width="1200"
							height="800"
							loading="eager"
							fetchpriority="high"
						/>
					) : null}
				</a>

				<div class="lead-copy">
					<p class="eyebrow">
						Latest story <span aria-hidden="true">/</span> <FormattedDate date={featuredPost.data.pubDate} />
					</p>
					<h2><a href={`/blog/${featuredPost.id}`}>{featuredPost.data.title}</a></h2>
					<p class="description">{featuredPost.data.description}</p>
					<a class="text-link" href={`/blog/${featuredPost.id}`}>Read the story <span aria-hidden="true">↗</span></a>
				</div>
			</article>
		)}

		{otherPosts.length > 0 && (
			<section class="archive" aria-label="More stories">
				<div class="archive-grid">
					{otherPosts.map((post) => (
						<article class="archive-row">
							<h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
							<FormattedDate date={post.data.pubDate} />
						</article>
					))}
				</div>
			</section>
		)}
	</section>
</Layout>

<style>
	.split-blog {
		min-height: 80svh;
		padding: clamp(1.25rem, 2vw, 2rem) clamp(1.25rem, 5vw, 4rem) clamp(6rem, 10vw, 10rem);
		color: var(--text-heading);
		background: var(--page-background);
	}

	.page-heading,
	.lead-story,
	.archive {
		width: min(100%, 82rem);
		margin-inline: auto;
	}

	.page-heading {
		padding: 0.25rem 0 clamp(2rem, 4vw, 3.5rem);
		text-align: center;
	}

	.page-heading h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-page-title);
		font-weight: 400;
		letter-spacing: -0.04em;
		line-height: 1;
	}

	.lead-story {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
		gap: clamp(2rem, 4.5vw, 5rem);
		align-items: center;
	}

	.lead-image {
		display: block;
		overflow: hidden;
		aspect-ratio: 2 / 1;
		border-radius: var(--radius-media);
		background: var(--image-background);
	}

	.lead-image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: saturate(0.78) contrast(1.04);
		transition: transform 380ms ease, filter 380ms ease;
	}

	.lead-image:hover img,
	.lead-image:focus-visible img {
		filter: saturate(1) contrast(1);
		transform: scale(1.018);
	}

	.eyebrow {
		margin: 0;
		color: var(--text-muted);
		font-size: var(--text-xs);
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.eyebrow {
		display: flex;
		gap: 0.5rem;
		align-items: center;
	}

	.lead-copy h2 {
		margin: 1.1rem 0 0;
		font-family: var(--font-display);
		font-size: clamp(2rem, 3.35vw, 3.35rem);
		font-weight: 400;
		letter-spacing: -0.04em;
		line-height: 1;
	}

	.lead-copy h2 a,
	.archive-row h3 a,
	.text-link {
		text-decoration: none;
	}

	.description {
		max-width: 31rem;
		margin: 1.5rem 0 0;
		color: rgb(224 232 244 / 0.66);
		font-size: var(--text-base);
		line-height: var(--leading-body);
	}

	.text-link {
		display: inline-flex;
		gap: 0.55rem;
		margin-top: 1.75rem;
		padding-bottom: 0.25rem;
		border-bottom: 1px solid var(--border-color);
		color: #dce7f7;
		font-size: 0.85rem;
	}

	.archive {
		margin-top: clamp(2rem, 4vw, 3.5rem);
	}

	.archive-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(2rem, 5vw, 5rem);
	}

	.archive-row {
		padding: 0;
	}

	.archive-row > :global(time) {
		display: block;
		margin-top: 0.75rem;
		color: rgb(224 232 244 / 0.38);
		font-size: var(--text-xs);
	}

	.archive-row h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-section-title);
		font-weight: 400;
		line-height: 1.05;
	}

	.lead-copy h2 a:hover,
	.lead-copy h2 a:focus-visible,
	.archive-row h3 a:hover,
	.archive-row h3 a:focus-visible,
	.text-link:hover,
	.text-link:focus-visible {
		color: var(--text-link);
	}

	.lead-image:focus-visible,
	.lead-copy h2 a:focus-visible,
	.archive-row h3 a:focus-visible,
	.text-link:focus-visible {
		outline: 2px solid var(--focus-color);
		outline-offset: 4px;
	}

	@media (max-width: 820px) {
		.lead-story {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.lead-copy {
			max-width: 39rem;
		}
	}

	@media (max-width: 620px) {
		.archive-grid {
			grid-template-columns: 1fr;
		}

		.archive-row {
			padding: 0;
		}
	}
</style>
