---
import Layout from './Layout.astro';
import { SITE_TITLE } from '../consts';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<Layout title={`${title} | ${SITE_TITLE}`} description={description} neutral>
	<article class="info-page">
		<header><h1>{title}</h1><p>{description}</p></header>
		<slot />
	</article>
</Layout>
<style>
	.info-page { max-width: 72rem; min-height: 65svh; margin: auto; padding: 3rem 1.5rem 6rem; color: var(--page-text); }
	header { max-width: 48rem; margin-bottom: 3rem; }
	h1 { margin: 0; font: 400 clamp(2rem, 3.5vw, 3rem) / 1 'Instrument Serif', Baskerville, 'Iowan Old Style', 'Times New Roman', serif; letter-spacing: -0.04em; }
	p, .info-page :global(p), .info-page :global(li) { font-size: 1rem; line-height: 1.6; }
	.info-page :global(h2) { font: 400 clamp(1.3rem, 1.8vw, 1.7rem) / 1.05 'Instrument Serif', Baskerville, 'Iowan Old Style', 'Times New Roman', serif; margin-top: 2.5rem; }
	.info-page :global(a:not(.site-button)) { color: var(--page-text); text-underline-offset: 0.2em; }
	.info-page :global(a:focus-visible) { outline: 2px solid var(--focus-color); outline-offset: 4px; }
	.info-page :global(.actions) { display: flex; flex-wrap: wrap; gap: 1rem; margin-block: 1.5rem; align-items: center; }
</style>
