---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import featuredPlaceholder from '../../assets/blog-placeholder-2.jpg';
import FormattedDate from '../../components/FormattedDate.astro';
import Layout from '../../layouts/Layout.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featuredPost, ...otherPosts] = posts;
---

<Layout title={`Malaysian AI Blog | ${SITE_TITLE}`} description="Updates from Malaysian AI.">
	<section class="blog" aria-labelledby="blog-title">
		<div class="blog-inner">
			<h1 id="blog-title">Malaysian AI Blog</h1>

			{
				featuredPost && (
					<article class="featured-story">
						<a class="featured-image" href={`/blog/${featuredPost.id}/`} aria-label={`Read ${featuredPost.data.title}`}>
							{
								featuredPost.data.image ? (
									<img
										src={featuredPost.data.image}
										alt={featuredPost.data.imageAlt ?? ''}
										width="960"
										height="480"
										loading="eager"
										fetchpriority="high"
									/>
								) : (
									<Image
										src={featuredPlaceholder}
										alt=""
										width={960}
										height={480}
										loading="eager"
									/>
								)
							}
						</a>
						<div class="featured-copy">
							<p class="featured-meta">
								Featured
								<span aria-hidden="true">·</span>
								<FormattedDate date={featuredPost.data.pubDate} />
							</p>
							<h2><a href={`/blog/${featuredPost.id}/`}>{featuredPost.data.title}</a></h2>
							<p class="featured-description">{featuredPost.data.description}</p>
							<a class="read-link" href={`/blog/${featuredPost.id}/`}>
								Read story <span aria-hidden="true">→</span>
							</a>
						</div>
					</article>
				)
			}

			{
				otherPosts.length > 0 && (
					<section class="all-stories" aria-labelledby="all-stories-title">
						<h2 id="all-stories-title">All stories</h2>
						<div class="compact-list">
							{otherPosts.map((post) => (
								<article class="compact-story">
									<div>
										<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
										<p>{post.data.category.replaceAll('-', ' ')}</p>
									</div>
									<FormattedDate date={post.data.pubDate} />
								</article>
							))}
						</div>
					</section>
				)
			}
		</div>
	</section>
</Layout>

<style>
	.blog {
		min-height: 75svh;
		padding: clamp(1.25rem, 2vw, 2rem) clamp(1.25rem, 5vw, 4rem) clamp(6rem, 10vw, 10rem);
		color: #f4f7fc;
		background: #06090f;
	}

	.blog-inner {
		width: min(100%, 64rem);
		margin-inline: auto;
	}

	.blog h1 {
		margin: 0 0 clamp(1.25rem, 2vw, 1.75rem);
		font-family: 'Instrument Serif', Baskerville, 'Iowan Old Style', 'Times New Roman', serif;
		font-size: clamp(1.45rem, 2.2vw, 2rem);
		font-weight: 400;
		letter-spacing: -0.04em;
		line-height: 0.94;
		text-align: center;
	}

	.featured-story {
		width: min(100%, 40rem);
		margin-inline: auto;
	}

	.featured-image {
		display: block;
		overflow: hidden;
		aspect-ratio: 2 / 1;
		border-radius: 0.9rem;
		background: #121a29;
	}

	.featured-image :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 300ms ease;
	}

	.featured-image:hover :global(img),
	.featured-image:focus-visible :global(img) {
		transform: scale(1.015);
	}

	.featured-copy {
		max-width: 40rem;
		padding-top: 1rem;
	}

	.featured-meta {
		display: flex;
		gap: 0.55rem;
		margin: 0 0 0.75rem;
		color: #8da7ca;
		font-size: 0.75rem;
		letter-spacing: 0.04em;
	}

	.featured-copy h2 {
		max-width: none;
		margin: 0;
		font-family: 'Instrument Serif', Baskerville, 'Iowan Old Style', 'Times New Roman', serif;
		font-size: clamp(1.4rem, 1.9vw, 1.55rem);
		font-weight: 400;
		letter-spacing: -0.025em;
		line-height: 1.1;
	}

	.featured-copy h2 a,
	.compact-story h3 a {
		text-decoration: none;
	}

	.featured-copy h2 a:hover,
	.featured-copy h2 a:focus-visible,
	.compact-story h3 a:hover,
	.compact-story h3 a:focus-visible {
		color: #b7c9e2;
	}

	.featured-description {
		max-width: 38rem;
		margin: 1rem 0 0;
		color: rgb(224 232 244 / 0.7);
		font-size: 0.95rem;
		line-height: 1.55;
	}

	.read-link {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		min-height: 2.25rem;
		padding: 0.35rem 0.75rem;
		margin-top: 1.35rem;
		border: 1px solid #7398cf;
		border-radius: var(--button-radius);
		color: #dce7f7;
		font-size: 0.8rem;
		text-decoration: none;
		transition: color 160ms ease, background 160ms ease, transform 160ms ease;
	}

	.read-link:hover,
	.read-link:focus-visible {
		color: #07101a;
		background: #dce7f7;
		transform: translateY(-2px);
	}

	.all-stories {
		width: min(100%, 40rem);
		margin: clamp(3rem, 5vw, 4.5rem) auto 0;
	}

	.all-stories > h2 {
		margin: 0 0 1.25rem;
		font-family: 'Instrument Serif', Baskerville, 'Iowan Old Style', 'Times New Roman', serif;
		font-size: clamp(1.35rem, 2.2vw, 1.75rem);
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 1;
	}

	.compact-list {
		display: grid;
		gap: 0.35rem;
	}

	.compact-story {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 2rem;
		align-items: center;
		padding: 1rem 1.1rem;
		border-radius: 0.6rem;
		transition: background 160ms ease;
	}

	.compact-story:hover {
		background: rgb(115 152 207 / 0.1);
	}

	.compact-story h3 {
		margin: 0;
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.35;
	}

	.compact-story p {
		margin: 0.3rem 0 0;
		color: #8da7ca;
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.compact-story > :global(time) {
		color: rgb(224 232 244 / 0.5);
		font-size: 0.875rem;
		white-space: nowrap;
	}

	.featured-image:focus-visible,
	.featured-copy h2 a:focus-visible,
	.compact-story h3 a:focus-visible,
	.read-link:focus-visible {
		outline: 2px solid #97b8e7;
		outline-offset: 4px;
	}

	@media (max-width: 620px) {
		.blog {
			padding-top: 1.25rem;
		}

		.blog h1 {
			margin-bottom: 1.5rem;
		}

		.featured-copy h2 {
			font-size: clamp(1.35rem, 5.5vw, 1.55rem);
		}

		.all-stories {
			margin-top: 3.5rem;
		}

		.compact-story {
			grid-template-columns: 1fr;
			gap: 0.5rem;
			padding: 0.9rem 0;
		}
	}
</style>
