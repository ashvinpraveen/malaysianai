---
import { getCollection } from 'astro:content';
import BlogLayoutNav from '../../components/BlogLayoutNav.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Layout from '../../layouts/Layout.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featuredPost, ...otherPosts] = posts;
---

<Layout title={`Malaysian AI Blog, centered layout | ${SITE_TITLE}`} description="A centered editorial variation of the Malaysian AI blog.">
	<section class="centered-blog" aria-labelledby="centered-title">
		<BlogLayoutNav current="index" />

		<div class="centered-inner">
			<header class="page-heading">
				<p>Stories from the community</p>
				<h1 id="centered-title">Malaysian AI Blog</h1>
			</header>

			{featuredPost && (
				<article class="featured-story">
					<div class="featured-copy">
						<p class="featured-meta">
							Featured <span aria-hidden="true">·</span> <FormattedDate date={featuredPost.data.pubDate} />
						</p>
						<h2><a href={`/blog/${featuredPost.id}/`}>{featuredPost.data.title}</a></h2>
						<p class="featured-description">{featuredPost.data.description}</p>
					</div>

					<a class="featured-image" href={`/blog/${featuredPost.id}/`} aria-label={`Read ${featuredPost.data.title}`}>
						{featuredPost.data.image ? (
							<img
								src={featuredPost.data.image}
								alt={featuredPost.data.imageAlt ?? ''}
								width="960"
								height="600"
								loading="eager"
								fetchpriority="high"
							/>
						) : null}
					</a>

					<a class="read-link" href={`/blog/${featuredPost.id}/`}>
						Read story <span aria-hidden="true">→</span>
					</a>
				</article>
			)}

			{otherPosts.length > 0 && (
				<section class="story-index" aria-labelledby="story-index-title">
					<div class="index-heading">
						<h2 id="story-index-title">All stories</h2>
						<span>{posts.length.toString().padStart(2, '0')} total</span>
					</div>

					{otherPosts.map((post, index) => (
						<article class="story-row">
							<span>{String(index + 2).padStart(2, '0')}</span>
							<div>
								<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
								<p>{post.data.category.replaceAll('-', ' ')}</p>
							</div>
							<FormattedDate date={post.data.pubDate} />
						</article>
					))}
				</section>
			)}
		</div>
	</section>
</Layout>

<style>
	.centered-blog {
		min-height: 80svh;
		padding: clamp(1.25rem, 2vw, 2rem) clamp(1.25rem, 5vw, 4rem) clamp(6rem, 10vw, 10rem);
		color: #f4f7fc;
		background: #06090f;
	}

	.centered-inner {
		width: min(100%, 48rem);
		margin-inline: auto;
	}

	.page-heading {
		padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
		text-align: center;
	}

	.page-heading p {
		margin: 0 0 0.75rem;
		color: #8da7ca;
		font-size: 0.75rem;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.page-heading h1 {
		margin: 0;
		font-family: 'Instrument Serif', Baskerville, 'Iowan Old Style', 'Times New Roman', serif;
		font-size: clamp(2rem, 4vw, 3.4rem);
		font-weight: 400;
		letter-spacing: -0.045em;
		line-height: 0.95;
	}

	.featured-story {
		text-align: center;
	}

	.featured-copy {
		width: min(100%, 42rem);
		margin-inline: auto;
	}

	.featured-meta {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		margin: 0 0 1rem;
		color: #8da7ca;
		font-size: 0.75rem;
		letter-spacing: 0.04em;
	}

	.featured-copy h2 {
		margin: 0;
		font-family: 'Instrument Serif', Baskerville, 'Iowan Old Style', 'Times New Roman', serif;
		font-size: clamp(2.35rem, 5vw, 4.9rem);
		font-weight: 400;
		letter-spacing: -0.05em;
		line-height: 0.95;
	}

	.featured-copy h2 a,
	.story-row h3 a,
	.read-link {
		text-decoration: none;
	}

	.featured-description {
		max-width: 37rem;
		margin: 1.25rem auto 0;
		color: rgb(224 232 244 / 0.62);
		font-size: 0.96rem;
		line-height: 1.55;
	}

	.featured-image {
		display: block;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		margin-top: clamp(2rem, 4vw, 3rem);
		border-radius: 0.75rem;
		background: #121a29;
	}

	.featured-image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: saturate(0.84) contrast(1.03);
		transition: transform 360ms ease, filter 360ms ease;
	}

	.featured-image:hover img,
	.featured-image:focus-visible img {
		filter: saturate(1) contrast(1);
		transform: scale(1.016);
	}

	.read-link {
		display: inline-flex;
		gap: 0.55rem;
		margin-top: 1.35rem;
		padding-bottom: 0.2rem;
		border-bottom: 1px solid #7398cf;
		color: #dce7f7;
		font-size: 0.82rem;
	}

	.story-index {
		margin-top: clamp(4rem, 8vw, 7rem);
	}

	.index-heading {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid rgb(141 167 202 / 0.32);
	}

	.index-heading h2,
	.index-heading span {
		margin: 0;
		font-size: 0.75rem;
		font-weight: 400;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.index-heading span {
		color: rgb(224 232 244 / 0.38);
	}

	.story-row {
		display: grid;
		grid-template-columns: 2.5rem minmax(0, 1fr) auto;
		gap: 1.25rem;
		align-items: center;
		padding: 1.25rem 0;
		border-bottom: 1px solid rgb(141 167 202 / 0.16);
		text-align: left;
	}

	.story-row > span,
	.story-row > :global(time) {
		color: rgb(224 232 244 / 0.38);
		font-size: 0.78rem;
	}

	.story-row h3 {
		margin: 0;
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.35;
	}

	.story-row p {
		margin: 0.35rem 0 0;
		color: #8da7ca;
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.featured-copy h2 a:hover,
	.featured-copy h2 a:focus-visible,
	.story-row h3 a:hover,
	.story-row h3 a:focus-visible,
	.read-link:hover,
	.read-link:focus-visible {
		color: #b7c9e2;
	}

	.featured-image:focus-visible,
	.featured-copy h2 a:focus-visible,
	.story-row h3 a:focus-visible,
	.read-link:focus-visible {
		outline: 2px solid #97b8e7;
		outline-offset: 4px;
	}

	@media (max-width: 620px) {
		.page-heading {
			padding-bottom: 2.75rem;
		}

		.story-row {
			grid-template-columns: 2rem minmax(0, 1fr);
			gap: 1rem;
		}

		.story-row > :global(time) {
			grid-column: 2;
		}
	}
</style>
