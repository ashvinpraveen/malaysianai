---
import { getCollection } from 'astro:content';
import BlogLayoutNav from '../../components/BlogLayoutNav.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Layout from '../../layouts/Layout.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featuredPost, ...otherPosts] = posts;
---

<Layout title={`Stories, reading rail | ${SITE_TITLE}`} description="An image-led reading rail for Malaysian AI stories.">
	<section class="rail-blog" aria-labelledby="rail-title">
		<BlogLayoutNav current="rail" />
		<h1 class="sr-only" id="rail-title">Malaysian AI stories</h1>

		<div class="rail-layout">
			{featuredPost && (
				<article class="visual-story">
					<a class="visual-image" href={`/blog/${featuredPost.id}/`} aria-label={`Read ${featuredPost.data.title}`}>
						{featuredPost.data.image ? (
							<img
								src={featuredPost.data.image}
								alt={featuredPost.data.imageAlt ?? ''}
								width="900"
								height="1200"
								loading="eager"
								fetchpriority="high"
							/>
						) : null}
					</a>
					<div class="visual-caption">
						<p>Latest <span aria-hidden="true">/</span> <FormattedDate date={featuredPost.data.pubDate} /></p>
						<p>01</p>
					</div>
				</article>

				<div class="reading-rail">
					<article class="lead-copy">
						<p>{featuredPost.data.category.replaceAll('-', ' ')}</p>
						<h2><a href={`/blog/${featuredPost.id}/`}>{featuredPost.data.title}</a></h2>
						<p class="lead-summary">{featuredPost.data.description}</p>
						<a class="read-link" href={`/blog/${featuredPost.id}/`}>Open story <span aria-hidden="true">↗</span></a>
					</article>

					{otherPosts.length > 0 && (
						<section class="rail-index" aria-labelledby="rail-index-title">
							<h2 id="rail-index-title">Keep reading</h2>
							{otherPosts.map((post, index) => (
								<article class="rail-row">
									<span>{String(index + 2).padStart(2, '0')}</span>
									<div>
										<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
										<FormattedDate date={post.data.pubDate} />
									</div>
								</article>
							))}
						</section>
					)}
				</div>
			)}
		</div>
	</section>
</Layout>

<style>
	.rail-blog {
		min-height: 80svh;
		padding: clamp(1.25rem, 2vw, 2rem) clamp(1.25rem, 5vw, 4rem) clamp(6rem, 10vw, 10rem);
		color: #f4f7fc;
		background: #06090f;
	}

	.rail-layout {
		display: grid;
		grid-template-columns: minmax(22rem, 1.2fr) minmax(19rem, 0.8fr);
		gap: clamp(2rem, 5vw, 6rem);
		width: min(100%, 68rem);
		margin-inline: auto;
	}

	.lead-copy > p:first-child,
	.visual-caption,
	.rail-index > h2 {
		margin: 0;
		color: #8da7ca;
		font-size: 0.75rem;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.visual-image {
		display: block;
		overflow: hidden;
		aspect-ratio: 4 / 5;
		border-radius: 0.75rem;
		background: #121a29;
	}

	.visual-image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 52% center;
		filter: saturate(0.82) contrast(1.05);
		transition: transform 420ms ease, filter 420ms ease;
	}

	.visual-image:hover img,
	.visual-image:focus-visible img {
		filter: saturate(1) contrast(1);
		transform: scale(1.02);
	}

	.visual-caption {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 0.8rem;
	}

	.visual-caption p {
		display: flex;
		gap: 0.45rem;
		margin: 0;
	}

	.reading-rail {
		display: flex;
		flex-direction: column;
	}

	.lead-copy {
		padding-top: clamp(1rem, 4vw, 4.5rem);
	}

	.lead-copy h2 {
		margin: 1rem 0 0;
		font-family: 'Instrument Serif', Baskerville, 'Iowan Old Style', 'Times New Roman', serif;
		font-size: clamp(2.4rem, 4vw, 4.35rem);
		font-weight: 400;
		letter-spacing: -0.05em;
		line-height: 0.96;
	}

	.lead-copy h2 a,
	.read-link,
	.rail-row h3 a {
		text-decoration: none;
	}

	.lead-summary {
		max-width: 30rem;
		margin: 1.35rem 0 0;
		color: rgb(224 232 244 / 0.62);
		font-size: 0.95rem;
		line-height: 1.58;
	}

	.read-link {
		display: inline-flex;
		gap: 0.55rem;
		margin-top: 1.6rem;
		color: #dce7f7;
		font-size: 0.82rem;
	}

	.rail-index {
		margin-top: auto;
		padding-top: clamp(3.5rem, 7vw, 7rem);
	}

	.rail-index > h2 {
		padding-bottom: 0.9rem;
		border-bottom: 1px solid rgb(141 167 202 / 0.32);
		font-weight: 400;
	}

	.rail-row {
		display: grid;
		grid-template-columns: 2rem minmax(0, 1fr);
		gap: 1rem;
		padding: 1rem 0;
		border-bottom: 1px solid rgb(141 167 202 / 0.16);
	}

	.rail-row > span,
	.rail-row :global(time) {
		color: rgb(224 232 244 / 0.38);
		font-size: 0.75rem;
	}

	.rail-row h3 {
		margin: 0 0 0.45rem;
		font-size: 0.95rem;
		font-weight: 400;
		line-height: 1.35;
	}

	.lead-copy h2 a:hover,
	.lead-copy h2 a:focus-visible,
	.read-link:hover,
	.read-link:focus-visible,
	.rail-row h3 a:hover,
	.rail-row h3 a:focus-visible {
		color: #b7c9e2;
	}

	.visual-image:focus-visible,
	.lead-copy h2 a:focus-visible,
	.read-link:focus-visible,
	.rail-row h3 a:focus-visible {
		outline: 2px solid #97b8e7;
		outline-offset: 4px;
	}

	@media (max-width: 980px) {
		.rail-layout {
			grid-template-columns: minmax(20rem, 1fr) minmax(17rem, 0.8fr);
			gap: 2.5rem;
		}
	}

	@media (max-width: 680px) {
		.rail-layout {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.visual-story,
		.reading-rail {
			grid-column: 1;
		}

		.reading-rail {
			display: block;
		}

		.lead-copy {
			padding-top: 0.5rem;
		}

		.rail-index {
			padding-top: 4rem;
		}
	}
</style>
