---
import ResidentLogo from '../../components/ResidentLogo.astro';
import { residents, type Resident } from '../../data/residents';
import { residentSlug } from '../../lib/directory';
import InfoPage from '../../layouts/InfoPage.astro';

export function getStaticPaths() {
	const seen = new Set<string>();
	return residents.map(resident => {
		const slug = residentSlug(resident.name);
		if (seen.has(slug)) throw new Error(`Duplicate resident slug: ${slug}`);
		seen.add(slug);
		return { params: { slug }, props: { resident } };
	});
}

interface Props {
	resident: Resident;
}

const { resident } = Astro.props;
const founders = resident.founders ?? [];
---

<InfoPage
	title={resident.name}
	description={resident.description}
	keywords={['Malaysian AI', resident.name, resident.focus, 'AI startups Malaysia']}
>
	<p slot="before" class="back"><a href="/directory">All companies</a></p>
	<div class="identity">
		<ResidentLogo resident={resident} />
		<p class="tagline">{resident.tag}</p>
	</div>
	<dl class="meta">
		<div><dt>Location</dt><dd>{resident.location}</dd></div>
		<div><dt>Cohort</dt><dd>{resident.cohort}</dd></div>
		<div><dt>Industry</dt><dd>{resident.focus}</dd></div>
	</dl>
	<ul class="tags">
		{resident.tags.map(tag => <li>{tag}</li>)}
	</ul>
	<p class="actions"><a class="site-button" href={resident.website}>Visit {resident.name} <span aria-hidden="true">↗</span></a></p>
	{founders.length > 0 && (
		<section aria-labelledby="founders-heading">
			<h2 id="founders-heading">Founders</h2>
			<ul class="founder-list">
				{founders.map(founder => (
					<li>
						{founder.photo && <img class="founder-photo" src={founder.photo} alt="" width="48" height="48" />}
						<p class="founder-name">{founder.name}</p>
						<p class="founder-role">{founder.role}</p>
						{(founder.linkedin || founder.x) && (
							<p class="founder-links">
								{founder.linkedin && <a href={founder.linkedin}>LinkedIn</a>}
								{founder.x && <a href={founder.x}>X</a>}
							</p>
						)}
					</li>
				))}
			</ul>
		</section>
	)}
</InfoPage>

<style>
	.back { margin: 0 0 1.25rem; font-size: var(--text-sm); }
	.identity { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin-bottom: 1.5rem; }
	.tagline { margin: 0; color: var(--text-muted); }
	.meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 0.75rem; margin: 0 0 1.25rem; }
	.meta div { padding: 0.85rem 1rem; border: 1px solid var(--page-border); border-radius: 0.7rem; background: var(--card-background); }
	.meta dt { margin: 0 0 0.25rem; color: var(--text-muted); font-size: var(--text-xs); letter-spacing: 0.04em; text-transform: uppercase; }
	.meta dd { margin: 0; }
	.tags { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0; margin: 0 0 1.5rem; list-style: none; }
	.tags li { padding: 0.2rem 0.55rem; border: 1px solid var(--page-border); border-radius: 999px; font-size: var(--text-xs); }
	.founder-list { display: grid; gap: 0.75rem; padding: 0; margin: 0; list-style: none; }
	.founder-list li { display: grid; gap: 0.15rem; padding: 1rem; border: 1px solid var(--page-border); border-radius: 0.75rem; background: var(--card-background); }
	.founder-photo { width: 3rem; height: 3rem; margin-bottom: 0.4rem; object-fit: cover; border-radius: 999px; }
	.founder-name, .founder-role, .founder-links { margin: 0; }
	.founder-role { color: var(--text-muted); }
	.founder-links { display: flex; gap: 0.9rem; margin-top: 0.45rem; }
</style>
