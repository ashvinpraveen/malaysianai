---
import { Image } from 'astro:assets';
import heroArt from '../assets/hero-fibonacci.png';
import Layout from '../layouts/Layout.astro';
import FramedChrome from '../components/FramedChrome.astro';
import EventsSection from '../components/EventsSection.astro';
import CommunitySection from '../components/CommunitySection.astro';
import ResidencySection from '../components/ResidencySection.astro';
import VoicesSection from '../components/VoicesSection.astro';
import AboutHostSection from '../components/AboutHostSection.astro';
import { LUMA_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<Layout
	title={SITE_TITLE}
	description={SITE_DESCRIPTION}
	image="/images/malaysian-ai-kl-hero-restored-3840.webp"
	immersive
>
	<div class="hero-shell">
		<div class="hero-media">
			<Image
				class="hero-art"
				src={heroArt}
				format="webp"
				widths={[640, 1024, 1672]}
				sizes="max(100vw, 178svh)"
				quality={85}
				alt=""
				width="1672"
				height="941"
				fetchpriority="high"
				decoding="async"
			/>
			<div class="hero-shade" aria-hidden="true"></div>
		</div>

		<FramedChrome home />

		<a class="sky-wordmark" href="/" aria-label="Malaysian AI home">Malaysian AI</a>

		<section class="hero-card" aria-labelledby="hero-title">
			<div class="hero-copy">
				<h1 id="hero-title">Driving Malaysia's<br />AI progress.</h1>
				<p class="intro">
					The home of AI builders in Malaysia. Start with a workshop, meet the people building
					around you, and make something of your own.
				</p>
			</div>
			<a class="card-link site-button" href={LUMA_URL}>Explore Malaysian AI</a>
		</section>
	</div>

	<section class="mission-section light-nav-zone" id="about" aria-labelledby="mission-title">
		<div class="mission-events">
			<h2 id="mission-title">Your first step into AI starts here.</h2>
			<figure class="mission-flower">
				<img
					class="mission-flower-image"
					src="/images/malaysian-ai-bunga-raya-pixel.png"
					alt="A pixel-art bunga raya plant with a red hibiscus bloom"
					width="1122"
					height="1402"
					loading="lazy"
					decoding="async"
				/>
			</figure>

			<div class="mission-calendar">
				<div class="luma-frame">
					<iframe
						src="https://luma.com/embed/calendar/cal-pPgkuwCFrycSv1Z/events"
						title="Malaysian AI upcoming events on Luma"
						loading="lazy"
						allow="clipboard-write; payment"
					></iframe>
				</div>
			</div>
		</div>
	</section>

	<EventsSection />
	<CommunitySection />
	<ResidencySection />
	<VoicesSection />
	<AboutHostSection />
</Layout>

<style>
	.hero-shell {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		color: #fffdf6;
	}

	.sky-wordmark {
		position: absolute;
		left: 50%;
		color: #fffdf8;
		font-family: 'Mondwest', 'Times New Roman', Times, serif;
		font-weight: 400;
		line-height: 1;
		text-align: center;
		text-decoration: none;
		text-shadow:
			0 0 7px rgb(255 255 255 / 0.42),
			0 3px 20px rgb(13 32 77 / 0.7);
		transform: translateX(-50%);
	}

	.hero-card {
		isolation: isolate;
	}

	.hero-card::before {
		position: absolute;
		z-index: 0;
		inset: 0;
		border-radius: inherit;
		background:
			linear-gradient(118deg, rgb(255 255 255 / 0.18), transparent 24%, transparent 70%, rgb(255 212 149 / 0.07)),
			radial-gradient(circle at 12% 0%, rgb(255 255 255 / 0.16), transparent 34%);
		content: '';
		pointer-events: none;
	}

	.hero-card > * {
		position: relative;
		z-index: 1;
	}

	h1 {
		margin: 0;
		font-family: 'Mondwest', 'Times New Roman', Times, serif;
		font-size: clamp(1.9rem, 2.8vw, 2.35rem);
		font-weight: 400;
		letter-spacing: 0;
		line-height: 1.04;
		text-wrap: balance;
	}

	.card-link {
		width: fit-content;
	}

	.mission-section {
		position: relative;
		display: grid;
		height: 100dvh;
		max-height: 100dvh;
		padding: clamp(2.5rem, 5vh, 4.5rem) clamp(1.25rem, 6vw, 6rem);
		overflow: hidden;
		color: #f4f7fc;
		background: #06090f;
	}

	.mission-events {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		align-content: center;
		align-items: center;
		gap: clamp(2.5rem, 5vw, 5rem);
		width: min(100%, 82rem);
		height: 100%;
		margin: auto;
	}

	.mission-flower {
		display: grid;
		align-self: center;
		min-width: 0;
		margin: 0;
		place-items: center;
	}

	.mission-flower-image {
		display: block;
		width: min(100%, 30rem);
		aspect-ratio: 1122 / 1402;
		image-rendering: pixelated;
		transform-origin: 50% 88%;
		animation: flower-sway 5.5s ease-in-out infinite alternate;
	}

	.mission-calendar {
		display: grid;
		align-self: center;
		gap: clamp(1.5rem, 3vh, 2.25rem);
		min-width: 0;
	}

	.mission-events h2 {
		grid-column: 1 / -1;
		justify-self: center;
		max-width: 36rem;
		margin: 0;
		text-align: center;
		font-family: 'Instrument Serif', Baskerville, 'Iowan Old Style', 'Times New Roman', serif;
		font-size: clamp(2.4rem, 3.4vw, 3.6rem);
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 0.9;
		text-wrap: balance;
	}

	.luma-frame {
		overflow: hidden;
		width: 100%;
		height: min(56dvh, 32rem);
		padding: 0.35rem;
		border: 1px solid rgb(115 152 207 / 0.55);
		border-radius: 1rem;
		background: #06090f;
		content-visibility: auto;
		contain-intrinsic-size: 720px;
	}

	.luma-frame iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
		border-radius: 0.75rem;
		background: #06090f;
	}

	@media (max-width: 900px) {
		.mission-section {
			height: auto;
			max-height: none;
			overflow: visible;
		}

		.mission-events {
			grid-template-columns: 1fr;
			gap: 2rem;
			max-width: 38rem;
			height: auto;
		}

		.mission-flower-image {
			width: min(45vw, 14rem);
		}

		.mission-events h2 {
			font-size: clamp(2.8rem, 13vw, 4.2rem);
		}

		.luma-frame iframe {
			height: 100%;
		}

		.luma-frame {
			height: min(62dvh, 32rem);
		}
	}

	a:focus-visible {
		outline: 2px solid #ffd29a;
		outline-offset: 4px;
	}

	@keyframes settle {
		from {
			opacity: 0.75;
			transform: scale(1.025);
		}
	}

	@keyframes flower-sway {
		0% {
			transform: translate3d(-0.2rem, 0.1rem, 0) rotate(-0.75deg);
		}
		55% {
			transform: translate3d(0.12rem, -0.28rem, 0) rotate(0.2deg);
		}
		100% {
			transform: translate3d(0.35rem, 0, 0) rotate(0.8deg);
		}
	}

	@media (max-width: 700px) {

		.sky-wordmark {
			width: calc(100% - 2rem);
		}

		h1 {
			font-size: clamp(1.85rem, 8vw, 2.2rem);
		}

		.intro {
			margin-block: 1.1rem;
		}

		.mission-section {
			min-height: auto;
			padding: 7rem 1.25rem 5rem;
		}

	}

	@media (max-height: 760px) and (min-width: 701px) {

		h1 {
			font-size: 2.25rem;
		}

		.intro {
			margin-block: 1rem;
		}

	}
	.hero-shell {
		--hero-frame: #06090f;
		--hero-line: #7398cf;
		--hero-accent: #315d9f;
		--hero-gap: 1rem;
		--hero-panel-width: 29rem;
		--hero-brand-width: 7.2rem;
		--hero-control-height: 2.25rem;
		--hero-header-height: calc(var(--hero-gap) * 2 + var(--hero-control-height));
		min-height: max(46rem, 100svh);
		padding: var(--hero-gap);
		background: var(--hero-frame);
	}

	.hero-media {
		position: absolute;
		z-index: 0;
		inset: var(--hero-gap);
		overflow: hidden;
		border: 1.5px solid var(--hero-line);
		border-radius: 0.95rem;
		background: #121a29;
		animation: media-reveal 1.2s 0.05s cubic-bezier(0.2, 0.75, 0.2, 1) both;
	}

	.hero-art,
	.hero-shade {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.hero-art {
		z-index: 0;
		max-width: none;
		object-fit: cover;
		object-position: center;
		animation: hero-settle 1.8s 0.05s cubic-bezier(0.2, 0.72, 0.2, 1) both;
	}

	.hero-shade {
		z-index: 1;
		background:
			linear-gradient(180deg, rgb(10 13 22 / 0.12), rgb(10 13 22 / 0.03) 35%, rgb(9 10 14 / 0.6) 100%),
			linear-gradient(90deg, rgb(4 9 20 / 0.28), transparent 55%);
	}

	.sky-wordmark {
		z-index: 2;
		top: clamp(6.5rem, 14vh, 8.5rem);
		font-size: clamp(1.35rem, 1.8vw, 1.7rem);
		animation: soft-rise 0.75s 0.8s ease-out both;
	}

	.hero-card {
		position: absolute;
		z-index: 3;
		bottom: 0;
		left: 0;
		overflow: visible;
		width: var(--hero-panel-width);
		max-width: calc(100% - var(--hero-gap));
		padding: 2.1rem 3rem 2rem;
		border: 0;
		border-radius: 0 1rem 0 0;
		background: var(--hero-frame);
		box-shadow: none;
		-webkit-backdrop-filter: none;
		backdrop-filter: none;
		animation: panel-arrive 0.8s 0.35s ease-out both;
	}

	.hero-card::before {
		display: none;
	}

	.hero-card::after {
		position: absolute;
		z-index: 0;
		top: 0;
		right: 0;
		bottom: var(--hero-gap);
		left: var(--hero-gap);
		display: block;
		width: auto;
		height: auto;
		border-top: 1.5px solid var(--hero-line);
		border-right: 1.5px solid var(--hero-line);
		border-top-right-radius: 1rem;
		background: none;
		content: '';
		pointer-events: none;
	}

	.hero-copy {
		width: fit-content;
		max-width: 100%;
	}
	.hero-copy .intro {
		width: 0;
		min-width: 100%;
		max-width: none;
	}

	.hero-card h1 {
		margin: 0;
		font-family: 'Instrument Serif', Baskerville, 'Iowan Old Style', 'Times New Roman', serif;
		font-size: clamp(2.55rem, 3.1vw, 3.45rem);
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 0.88;
		text-wrap: balance;
		text-shadow: 0 2px 24px rgb(2 12 13 / 0.35);
		animation: soft-rise 0.7s 0.7s ease-out both;
	}

	.intro {
		max-width: 27rem;
		margin: 1.2rem 0 1.3rem;
		color: rgb(255 255 255 / 0.9);
		font-size: clamp(0.86rem, 1vw, 0.94rem);
		line-height: 1.42;
		text-shadow: 0 1px 14px rgb(2 12 13 / 0.5);
		animation: soft-rise 0.7s 0.85s ease-out both;
	}

	.card-link {
		transition: background 180ms ease, transform 180ms ease;
		animation: soft-rise 0.65s 1s ease-out both;
	}

	.card-link:hover,
	.card-link:focus-visible {
		transform: translateY(-2px);
	}

	@keyframes soft-rise {
		from {
			opacity: 0;
			transform: translateY(0.55rem);
		}
	}

	@keyframes panel-arrive {
		from {
			opacity: 0;
			transform: translateY(0.7rem);
		}
	}

	@keyframes media-reveal {
		from {
			opacity: 0;
			clip-path: inset(2.5% 2.5% 2.5% 2.5% round 1.2rem);
		}
	}

	@keyframes hero-settle {
		from {
			opacity: 0.72;
			transform: scale(1.025);
		}
	}

	@media (max-width: 700px) {
		.hero-shell {
			--hero-gap: 0.6rem;
			--hero-panel-width: calc(100% - var(--hero-gap));
			--hero-brand-width: 4.4rem;
			--hero-control-height: 2rem;
			min-height: max(42rem, 100svh);
			padding: var(--hero-gap);
		}

		.hero-media {
			inset: var(--hero-gap);
			border-radius: 0.75rem;
		}

		.hero-art {
			object-position: 51% center;
		}

		.sky-wordmark {
			top: 6.5rem;
			font-size: 1.25rem;
		}

		.hero-card {
			right: auto;
			bottom: 0;
			left: 0;
			width: var(--hero-panel-width);
			padding: 1.5rem 2rem 1.4rem;
			border-radius: 0 0.85rem 0 0;
		}

		.hero-card::after {
			border-top-right-radius: 0.85rem;
		}

		.hero-card h1 {
			font-size: clamp(2.15rem, 10vw, 2.75rem);
			line-height: 0.86;
		}

		.intro {
			max-width: 20rem;
			margin: 0.95rem 0 1.05rem;
			font-size: 0.8rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-media,
		.sky-wordmark,
		.hero-card,
		.hero-card h1,
		.intro,
		.card-link,
		.hero-art {
			animation: none;
		}
	}
</style>
