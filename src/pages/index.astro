---
import Layout from '../layouts/Layout.astro';
import EventsSection from '../components/EventsSection.astro';
import CommunitySection from '../components/CommunitySection.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<Layout
	title={SITE_TITLE}
	description={SITE_DESCRIPTION}
	image="/images/malaysian-ai-kl-hero-restored-3840.webp"
	immersive
>
	<header class="floating-nav">
		<a class="brand-mark" href="/" aria-label="Malaysian AI home">
			<img src="/logo-ai-residency.png" alt="" width="42" height="42" />
		</a>

		<nav aria-label="Primary navigation">
			<a class="nav-about" href="#about">About</a>
			<a href="#communities">Communities</a>
			<a href="/blog">Stories</a>
			<a class="nav-residency" href="/residency">Residency</a>
		</nav>

		<a
			class="nav-cta"
			href="https://luma.com/malaysianai"
			aria-label="Find an AI event"
		>
			<span>Find an event</span>
			<span class="round-arrow" aria-hidden="true">↗</span>
		</a>
	</header>

	<div class="hero-shell">
		<img
			class="hero-art"
			src="/images/malaysian-ai-kl-hero-restored-3840.webp"
			srcset="/images/malaysian-ai-kl-hero-restored-1920.webp 1920w, /images/malaysian-ai-kl-hero-restored-3840.webp 3840w, /images/malaysian-ai-kl-hero-restored-7680.webp 7680w"
			sizes="100vw"
			alt=""
			width="7680"
			height="4320"
			fetchpriority="high"
			decoding="async"
		/>
		<div class="hero-shade" aria-hidden="true"></div>

		<a class="sky-wordmark" href="/" aria-label="Malaysian AI home">Malaysian AI</a>

		<section class="hero-card" aria-labelledby="hero-title">
			<h1 id="hero-title">Driving Malaysia's<br />AI progress.</h1>
			<p class="intro">
				The home of AI builders in Malaysia. Start with a workshop, meet the people building
				around you, and make something of your own.
			</p>
			<a class="card-link" href="https://luma.com/malaysianai">
				Join the next AI event
				<span class="round-arrow" aria-hidden="true">↗</span>
			</a>
		</section>

		<div class="malaysia-clock" aria-label="Current time in Malaysia">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<circle cx="12" cy="12" r="8.5"></circle>
				<path d="M12 7.5v5l3 2"></path>
			</svg>
			<time id="malaysia-time" aria-live="off">--:-- --</time>
			<span class="clock-zone">MYT</span>
		</div>
	</div>

	<section class="mission-section light-nav-zone" id="about" aria-labelledby="mission-title">
		<div class="mission-inner">
			<figure class="mission-art-wrap">
				<img
					class="mission-flower-slot"
					src="/images/malaysian-ai-bunga-raya-pixel.png"
					alt="A pixel-art bunga raya plant with a red hibiscus bloom"
					width="1122"
					height="1402"
					loading="lazy"
					decoding="async"
				/>
			</figure>

			<div class="mission-copy">
				<div class="mission-intro">
					<p>
						We believe anyone in Malaysia should have a place to take their first step
						into AI.
					</p>
					<p>
						A place to join a workshop, meet builders at every level, and turn a new
						idea into something real.
					</p>
				</div>

				<div class="mission-action">
					<h2 id="mission-title">Your first step into AI starts here.</h2>
					<a class="mission-cta" href="https://luma.com/malaysianai">
						Join the next AI event
						<span class="round-arrow" aria-hidden="true">↗</span>
					</a>
				</div>
			</div>
		</div>
	</section>

	<EventsSection />
	<CommunitySection />
</Layout>

<script>
	const malaysiaTime = document.querySelector<HTMLTimeElement>('#malaysia-time');
	const floatingNav = document.querySelector<HTMLElement>('.floating-nav');
	const lightNavZones = Array.from(document.querySelectorAll<HTMLElement>('.light-nav-zone'));
	let scrollFrame: number | undefined;
	const malaysiaTimeFormatter = new Intl.DateTimeFormat('en-MY', {
		timeZone: 'Asia/Kuala_Lumpur',
		hour: 'numeric',
		minute: '2-digit',
		hour12: true,
	});

	function updateMalaysiaTime() {
		if (!malaysiaTime) return;

		const now = new Date();
		malaysiaTime.textContent = malaysiaTimeFormatter.format(now).toUpperCase();
		malaysiaTime.dateTime = now.toISOString();
	}

	updateMalaysiaTime();
	window.setInterval(updateMalaysiaTime, 30_000);

	function updateNavTheme() {
		if (!floatingNav) return;

		const navBounds = floatingNav.getBoundingClientRect();
		const isOverLightSection = lightNavZones.some((zone) => {
			const bounds = zone.getBoundingClientRect();
			return bounds.top <= navBounds.bottom && bounds.bottom >= navBounds.top;
		});

		floatingNav.classList.toggle('is-over-light', isOverLightSection);
	}

	function updateScrollScene() {
		scrollFrame = undefined;
		updateNavTheme();
	}

	function requestScrollUpdate() {
		if (scrollFrame !== undefined) return;
		scrollFrame = window.requestAnimationFrame(updateScrollScene);
	}

	requestScrollUpdate();
	window.addEventListener('scroll', requestScrollUpdate, { passive: true });
	window.addEventListener('resize', requestScrollUpdate);
</script>

<style>
	.hero-shell {
		position: relative;
		isolation: isolate;
		min-height: 100svh;
		overflow: hidden;
		color: #fffdf6;
		background: #0b2741;
	}

	.hero-art,
	.hero-shade {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.hero-art {
		z-index: -3;
		max-width: none;
		object-fit: cover;
		object-position: center;
		animation: settle 1.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}

	.hero-shade {
		z-index: -2;
		background:
			linear-gradient(180deg, rgb(4 16 34 / 0.28) 0%, transparent 34%, rgb(3 19 28 / 0.32) 100%),
			radial-gradient(circle at 50% 35%, transparent 25%, rgb(2 16 26 / 0.26) 100%);
	}

	.floating-nav {
		position: fixed;
		z-index: 20;
		top: clamp(1rem, 3vw, 2rem);
		left: 50%;
		display: flex;
		align-items: center;
		gap: 0.35rem;
		width: min(94vw, 570px);
		padding: 0.3rem;
		border: 1px solid rgb(255 255 255 / 0.3);
		border-radius: 1.05rem;
		color: #fffdf6;
		background: linear-gradient(105deg, rgb(35 43 58 / 0.52), rgb(85 105 143 / 0.5));
		box-shadow: 0 18px 60px rgb(3 12 28 / 0.23), inset 0 1px rgb(255 255 255 / 0.16);
		backdrop-filter: blur(18px) saturate(125%);
		transform: translateX(-50%);
		transition: color 220ms ease, background 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
		animation: nav-in 0.75s 0.08s ease-out both;
	}

	.floating-nav.is-over-light {
		border-color: rgb(23 58 56 / 0.1);
		color: #173a38;
		background: rgb(250 247 238 / 0.82);
		box-shadow: 0 14px 35px rgb(62 73 48 / 0.12), inset 0 1px rgb(255 255 255 / 0.8);
	}

	.brand-mark {
		display: grid;
		flex: 0 0 auto;
		width: 2.4rem;
		height: 2.4rem;
		place-items: center;
		border: 1px solid rgb(255 255 255 / 0.1);
		border-radius: 0.72rem;
		background: rgb(255 255 255 / 0.13);
		transition: background 220ms ease, border-color 220ms ease;
	}

	.floating-nav.is-over-light .brand-mark {
		border-color: rgb(23 58 56 / 0.1);
		background: rgb(23 58 56 / 0.07);
	}

	.brand-mark img {
		width: 1.7rem;
		height: 1.7rem;
		filter: drop-shadow(0 2px 6px rgb(0 0 0 / 0.25));
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: clamp(0.7rem, 1.5vw, 1rem);
		min-width: 0;
		margin-inline: auto;
	}

	nav a {
		position: relative;
		font-size: 0.82rem;
		text-decoration: none;
		text-shadow: 0 1px 10px rgb(0 0 0 / 0.26);
	}

	nav a::after {
		position: absolute;
		right: 0;
		bottom: -0.28rem;
		left: 0;
		height: 1px;
		background: currentColor;
		content: '';
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 180ms ease;
	}

	nav a:hover::after,
	nav a:focus-visible::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	.nav-cta,
	.card-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		color: #fff;
		text-decoration: none;
	}

	.nav-cta {
		flex: 0 0 auto;
		min-height: 2.4rem;
		padding: 0.32rem 0.4rem 0.32rem 0.72rem;
		border: 1px solid rgb(255 255 255 / 0.09);
		border-radius: 0.75rem;
		background: rgb(10 16 31 / 0.82);
		box-shadow: inset 0 1px rgb(255 255 255 / 0.1);
		font-size: 0.82rem;
		transition: background 180ms ease, transform 180ms ease;
	}

	.nav-cta:hover,
	.nav-cta:focus-visible {
		background: rgb(19 29 49 / 0.94);
		transform: translateY(-1px);
	}

	.sky-wordmark {
		position: absolute;
		z-index: 1;
		top: clamp(6.5rem, 14vh, 8.5rem);
		left: 50%;
		color: #fffdf8;
		font-family: 'Mondwest', 'Times New Roman', Times, serif;
		font-size: clamp(1.55rem, 2.4vw, 2.15rem);
		font-weight: 400;
		line-height: 1;
		text-align: center;
		text-decoration: none;
		text-shadow:
			0 0 7px rgb(255 255 255 / 0.42),
			0 3px 20px rgb(13 32 77 / 0.7);
		transform: translateX(-50%);
		animation: wordmark-in 0.85s 0.16s ease-out both;
	}

	.round-arrow {
		display: grid;
		width: 1.2rem;
		height: 1.2rem;
		place-items: center;
		border: 1px solid rgb(255 255 255 / 0.42);
		border-radius: 50%;
		font-family: system-ui, sans-serif;
		font-size: 0.68rem;
	}

	.hero-card {
		position: absolute;
		z-index: 1;
		isolation: isolate;
		bottom: clamp(1.5rem, 4vw, 3.5rem);
		left: clamp(1rem, 3vw, 2.5rem);
		overflow: hidden;
		width: min(86vw, 510px);
		padding: clamp(1.65rem, 3vw, 2.35rem);
		border: 1px solid rgb(238 250 255 / 0.18);
		border-radius: 1.4rem;
		background:
			linear-gradient(135deg, rgb(158 194 215 / 0.2), rgb(13 37 55 / 0.38) 34%, rgb(4 20 34 / 0.22) 72%, rgb(238 192 125 / 0.11));
		box-shadow:
			0 28px 80px rgb(1 12 22 / 0.28),
			inset 0 1px rgb(255 255 255 / 0.22),
			inset 0 -1px rgb(255 255 255 / 0.1);
		-webkit-backdrop-filter: blur(26px) saturate(155%) contrast(104%);
		backdrop-filter: blur(26px) saturate(155%) contrast(104%);
		animation: card-in 0.85s 0.2s ease-out both;
	}

	.hero-card::before {
		position: absolute;
		z-index: 0;
		inset: 0;
		border-radius: inherit;
		background:
			linear-gradient(118deg, rgb(255 255 255 / 0.18), transparent 24%, transparent 70%, rgb(255 212 149 / 0.07)),
			radial-gradient(circle at 12% 0%, rgb(255 255 255 / 0.16), transparent 34%);
		content: '';
		pointer-events: none;
	}

	.hero-card::after {
		position: absolute;
		z-index: 0;
		top: 0;
		left: 9%;
		width: 54%;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.45), transparent);
		content: '';
		pointer-events: none;
	}

	.hero-card > * {
		position: relative;
		z-index: 1;
	}

	h1 {
		margin: 0;
		font-family: 'Mondwest', 'Times New Roman', Times, serif;
		font-size: clamp(1.9rem, 2.8vw, 2.35rem);
		font-weight: 400;
		letter-spacing: 0;
		line-height: 1.04;
		text-wrap: balance;
	}

	.intro {
		max-width: 27rem;
		margin: 1.25rem 0 1.35rem;
		color: rgb(255 255 255 / 0.55);
		font-size: 0.93rem;
		line-height: 1.5;
	}

	.card-link {
		justify-content: flex-start;
		width: fit-content;
		padding-bottom: 0.22rem;
		border-bottom: 1px solid rgb(255 255 255 / 0.68);
		font-size: 0.95rem;
		transition: gap 180ms ease, color 180ms ease;
	}

	.card-link:hover,
	.card-link:focus-visible {
		gap: 1.1rem;
		color: #ffd8a6;
	}

	.card-link .round-arrow {
		width: 1.4rem;
		height: 1.4rem;
	}

	.malaysia-clock {
		position: absolute;
		z-index: 1;
		top: clamp(0.85rem, 3vw, 2rem);
		right: clamp(0.85rem, 3vw, 2rem);
		display: flex;
		align-items: center;
		gap: 0.55rem;
		color: rgb(255 255 255 / 0.68);
		font-size: clamp(0.72rem, 1vw, 0.82rem);
		font-variant-numeric: tabular-nums;
		line-height: 1;
		text-shadow: 0 1px 8px rgb(0 0 0 / 0.75);
	}

	.malaysia-clock svg {
		width: 1.2rem;
		height: 1.2rem;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
	}

	.clock-zone {
		color: rgb(255 255 255 / 0.42);
	}

	.mission-section {
		position: relative;
		display: grid;
		min-height: max(48rem, 100svh);
		padding: clamp(6rem, 10vw, 9rem) clamp(1.25rem, 6vw, 6rem);
		color: #173a38;
		background:
			radial-gradient(circle at 18% 32%, rgb(210 223 157 / 0.2), transparent 27rem),
			#f0eadb;
	}

	.mission-inner {
		display: grid;
		grid-template-columns: minmax(18rem, 0.82fr) minmax(24rem, 1.18fr);
		gap: clamp(3rem, 8vw, 9rem);
		width: min(100%, 82rem);
		margin: auto;
	}

	.mission-art-wrap {
		display: grid;
		align-self: center;
		min-width: 0;
		margin: 0;
		place-items: center;
	}

	.mission-flower-slot {
		display: block;
		width: min(100%, 32rem);
		aspect-ratio: 1122 / 1402;
		filter: drop-shadow(0 1rem 1.25rem rgb(67 78 36 / 0.18));
		image-rendering: pixelated;
		transform-origin: 50% 88%;
		animation: flower-sway 5.5s ease-in-out infinite alternate;
	}

	.mission-copy {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-width: 0;
		padding-block: clamp(1rem, 5vw, 5rem);
	}

	.mission-intro {
		max-width: 37rem;
		color: rgb(23 58 56 / 0.7);
		font-size: clamp(1.05rem, 1.35vw, 1.3rem);
		line-height: 1.55;
	}

	.mission-intro p {
		margin: 0;
	}

	.mission-intro p + p {
		margin-top: 1.6rem;
	}

	.mission-copy h2 {
		max-width: 48rem;
		margin: 0;
		font-family: 'Mondwest', 'Times New Roman', Times, serif;
		font-size: clamp(2.65rem, 4.3vw, 4.6rem);
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 0.96;
		text-wrap: balance;
	}

	.mission-action {
		margin-top: clamp(3.5rem, 10vh, 7rem);
	}

	.mission-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		width: fit-content;
		margin-top: 1.75rem;
		padding: 0.72rem 0.75rem 0.72rem 1rem;
		border-radius: 0.9rem;
		color: #fffdf6;
		background: #173a38;
		box-shadow: 0 0.8rem 2rem rgb(23 58 56 / 0.14);
		font-size: 0.95rem;
		text-decoration: none;
		transition: background 180ms ease, transform 180ms ease;
	}

	.mission-cta:hover,
	.mission-cta:focus-visible {
		background: #23504d;
		transform: translateY(-2px);
	}

	.mission-cta .round-arrow {
		width: 1.35rem;
		height: 1.35rem;
	}

	a:focus-visible {
		outline: 2px solid #ffd29a;
		outline-offset: 4px;
	}

	@keyframes nav-in {
		from {
			opacity: 0;
			transform: translate(-50%, -0.8rem);
		}
	}

	@keyframes card-in {
		from {
			opacity: 0;
			transform: translateY(1.2rem);
		}
	}

	@keyframes wordmark-in {
		from {
			opacity: 0;
			transform: translate(-50%, 0.6rem);
		}
	}

	@keyframes settle {
		from {
			opacity: 0.75;
			transform: scale(1.025);
		}
	}

	@keyframes flower-sway {
		0% {
			transform: translate3d(-0.2rem, 0.1rem, 0) rotate(-0.75deg);
		}
		55% {
			transform: translate3d(0.12rem, -0.28rem, 0) rotate(0.2deg);
		}
		100% {
			transform: translate3d(0.35rem, 0, 0) rotate(0.8deg);
		}
	}

	@media (max-width: 700px) {
		.hero-shell {
			min-height: max(44rem, 100svh);
		}

		.hero-art {
			object-position: 49% center;
		}

		.floating-nav {
			top: 0.85rem;
			width: min(calc(100vw - 1.5rem), 28rem);
			border-radius: 1rem;
		}

		.sky-wordmark {
			top: 8.15rem;
			width: calc(100% - 2rem);
			font-size: clamp(1.5rem, 6.5vw, 1.9rem);
		}

		.malaysia-clock {
			top: 5.75rem;
			right: 1rem;
			font-size: 0.72rem;
		}

		.brand-mark {
			width: 2.35rem;
			height: 2.35rem;
			border-radius: 0.75rem;
		}

		.brand-mark img {
			width: 1.7rem;
			height: 1.7rem;
		}

		nav {
			gap: 1rem;
		}

		nav a {
			font-size: 0.92rem;
		}

		.nav-residency {
			display: none;
		}

		.nav-about {
			display: none;
		}

		.nav-cta {
			min-height: 2.35rem;
			padding: 0.38rem;
		}

		.nav-cta span:first-child {
			display: none;
		}

		.hero-card {
			right: 0.75rem;
			bottom: 0.75rem;
			left: 0.75rem;
			width: auto;
			padding: 1.6rem;
			border-radius: 1.3rem;
		}

		h1 {
			font-size: clamp(1.85rem, 8vw, 2.2rem);
		}

		.intro {
			margin-block: 1.1rem;
			font-size: 0.9rem;
		}

		.mission-section {
			min-height: auto;
			padding: 7rem 1.25rem 5rem;
		}

		.mission-inner {
			grid-template-columns: 1fr;
			gap: 2.75rem;
		}

		.mission-art-wrap {
			order: 2;
		}

		.mission-flower-slot {
			width: min(88vw, 25rem);
		}

		.mission-copy {
			order: 1;
			padding: 0;
		}

		.mission-intro {
			font-size: 1.05rem;
		}

		.mission-copy h2 {
			font-size: clamp(2.65rem, 11.5vw, 3.6rem);
		}

		.mission-action {
			margin-top: 3rem;
		}

		.mission-cta {
			margin-top: 1.5rem;
		}

	}

	@media (max-height: 760px) and (min-width: 701px) {
		.hero-card {
			bottom: 1rem;
			padding: 1.6rem 2rem;
		}

		h1 {
			font-size: 2.25rem;
		}

		.intro {
			margin-block: 1rem;
		}

	}

	@media (prefers-reduced-motion: reduce) {
		.hero-art,
		.floating-nav,
		.sky-wordmark,
		.hero-card,
		.mission-flower-slot {
			animation: none;
		}
	}
</style>
