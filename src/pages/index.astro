---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import MissionSection from '../components/MissionSection.astro';
import EventsSection from '../components/EventsSection.astro';
import CommunitySection from '../components/CommunitySection.astro';
import ResidencySection from '../components/ResidencySection.astro';
import VoicesSection from '../components/VoicesSection.astro';
import AboutHostSection from '../components/AboutHostSection.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<Layout
	title={SITE_TITLE}
	description={SITE_DESCRIPTION}
	immersive
>
	<HeroSection />
	<MissionSection />
	<EventsSection />
	<CommunitySection />
	<ResidencySection />
	<VoicesSection />
	<AboutHostSection />
</Layout>
