---
import { Image } from 'astro:assets';
import showAndTell from '../../public/images/events/show-and-tell-supabase-ceo.png';
import ResidentLogo from '../components/ResidentLogo.astro';
import { residents } from '../data/residents';
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE, APPLY_FORM_URL, VENUE_ADDRESS, VENUE_MAPS_URL, VENUE_WAZE_URL } from '../consts';

const description = 'A working home for founders building AI products in Malaysia.';
---

<Layout title={`The AI Residency | ${SITE_TITLE}`} description={description} neutral>
	<article class="residency-page">
		<div class="residency-content">
			<header class="residency-header">
				<div class="residency-title">
					<h1>The AI Residency</h1>
					<p>Build in Malaysia. Ship for the world.</p>
				</div>
				<div class="residency-intro">
					<p>{description} Co-working space, regular demos, and support with product, engineering, and fundraising.</p>
					<div class="residency-actions">
						<a class="site-button" href={APPLY_FORM_URL}>Apply to the residency</a>
						<a class="residents-link" href="/residents">Meet the residents <span aria-hidden="true">↗</span></a>
					</div>
				</div>
			</header>

			<figure class="residency-photo">
				<Image
					src={showAndTell}
					alt="An audience of builders gathered for a Show & Tell conversation at Malaysian AI"
					widths={[540, 810, 1080]}
					sizes="(max-width: 1152px) calc(100vw - 3rem), 1104px"
					format="webp"
					quality={85}
					loading="eager"
					fetchpriority="high"
				/>
				<figcaption>Show &amp; Tell at Malaysian AI</figcaption>
			</figure>

			<section class="resident-teams" aria-labelledby="teams-title">
				<h2 id="teams-title">Resident teams</h2>
				<ul class="resident-logos">
					{residents.map(resident => (
						<li>
							<a href={resident.website}>
								<ResidentLogo resident={resident} />
								<span>{resident.name}</span>
							</a>
						</li>
					))}
				</ul>
			</section>

			<section class="residency-home" aria-labelledby="home-title">
				<h2 id="home-title">Our home</h2>
				<div class="home-address">
					<p class="home-name">500 Global, Kuala Lumpur</p>
					<address>{VENUE_ADDRESS}</address>
				</div>
				<nav class="home-directions" aria-label="Venue directions">
					<a href={VENUE_MAPS_URL}>Google Maps <span aria-hidden="true">↗</span></a>
					<a href={VENUE_WAZE_URL}>Waze <span aria-hidden="true">↗</span></a>
				</nav>
			</section>
		</div>
	</article>
</Layout>

<style>
	.residency-page {
		color: var(--page-text);
		background: var(--page-background);
	}

	.residency-content {
		max-width: 72rem;
		padding: clamp(2rem, 4vw, 3.5rem) 1.5rem clamp(3rem, 6vw, 5rem);
		margin-inline: auto;
	}

	.residency-header {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem clamp(2rem, 5vw, 5rem);
		align-items: start;
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	h1 {
		margin: 0;
		font: 400 var(--text-page-title) / 1 var(--font-display);
		letter-spacing: -0.04em;
	}

	.residency-title p {
		margin: 0.9rem 0 0;
		color: var(--page-text);
		font-size: var(--text-sm);
		line-height: 1.5;
	}

	.residency-intro > p {
		max-width: 32rem;
		margin: 0;
		color: var(--page-text);
		font-size: var(--text-base);
		line-height: var(--leading-body);
	}

	.residency-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		margin-top: 1.4rem;
	}

	.residents-link {
		color: var(--page-text);
		font-size: 0.85rem;
		text-decoration: none;
	}

	.residents-link span { margin-left: 0.25rem; }

	.residency-photo { margin: 0; }

	.residency-photo :global(img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		border-radius: var(--radius-media);
	}

	figcaption {
		margin-top: 0.75rem;
		color: var(--page-text);
		font-size: var(--text-xs);
		line-height: 1.5;
	}

	.resident-teams { margin-top: 2rem; }
	.resident-teams h2 { margin: 0 0 1rem; font-size: var(--text-sm); font-weight: 400; }
	.resident-logos { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
	.resident-logos a { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; height: 100%; padding: 1.25rem 0.5rem; border: 1px solid var(--page-border); border-radius: 0.5rem; color: var(--page-text); background: var(--card-background); text-decoration: none; }
	.resident-logos a > span { font-size: var(--text-xs); text-align: center; }
	.resident-logos a:hover { border-color: var(--color-white); }

	.residency-home {
		display: grid;
		grid-template-columns: 7rem minmax(0, 1fr) auto;
		gap: 0.75rem 1.5rem;
		align-items: start;
		padding-top: 1.5rem;
		margin-top: 2rem;
		border-top: 1px solid var(--page-border);
	}

	.residency-home h2 {
		margin: 0;
		color: var(--page-text);
		font-size: var(--text-xs);
		font-weight: 400;
		line-height: var(--leading-body);
	}

	.home-name {
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.5;
	}

	.home-address address {
		max-width: 35rem;
		margin-top: 0.3rem;
		color: var(--page-text);
		font-size: 0.8rem;
		font-style: normal;
		line-height: var(--leading-body);
	}

	.home-directions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
	}

	.home-directions a {
		color: var(--page-text);
		font-size: 0.8rem;
		line-height: var(--leading-body);
		text-decoration: none;
	}

	.residents-link:hover,
	.home-directions a:hover {
		color: var(--color-white);
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	a:focus-visible { outline: 2px solid var(--focus-color); outline-offset: 4px; }

	@media (max-width: 760px) {
		.resident-logos { grid-template-columns: repeat(3, minmax(0, 1fr)); }
		.residency-header { grid-template-columns: 1fr; gap: 1.5rem; }
		.residency-intro > p { max-width: 36rem; }
		.residency-home { grid-template-columns: 1fr; gap: 0.75rem; margin-top: 1.5rem; }
		.home-directions { margin-top: 0.25rem; }
	}
</style>
