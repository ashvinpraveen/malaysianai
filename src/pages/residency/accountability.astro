---
import FaqSection from '../../components/FaqSection.astro';
import { APPLY_FORM_URL, LUMA_URL, SITE_TITLE } from '../../consts';
import { accountabilityFaqs, accountabilityWeek, stakes, tasksToCap } from '../../data/accountability';
import Layout from '../../layouts/Layout.astro';
import { bestRateSeconds, formatHold, plankSecondsFor, plankToPushUps } from '../../lib/plank-conversion';

const description =
	'Every Monday, Malaysian AI residents name the tasks they will finish by the next Monday. Each missed task costs 50 push-ups or RM50, and planks can stand in for push-ups.';


const sprite = {
	pushup: { src: '/images/accountability/pushup.png', width: 116, height: 67 },
	plank: { src: '/images/accountability/plank.png', width: 116, height: 50 },
	hourglass: { src: '/images/accountability/hourglass.png', width: 72, height: 116 },
	pool: { src: '/images/accountability/pool.png', width: 96, height: 116 },
};

// Push-ups are credited in whole reps, so every figure on the page rounds down.
const cleared = (seconds: number) => Math.floor(plankToPushUps(seconds));
const leftoverExample = 30;
const oneTaskHold = plankSecondsFor(stakes.pushUpsPerTask);
const twoTaskHold = plankSecondsFor(stakes.pushUpsPerTask * 2);
const fullStackHold = plankSecondsFor(stakes.pushUpCap);
const bestRate = plankToPushUps(bestRateSeconds) / bestRateSeconds;
const referenceHolds = [30, 60, 120, 180, 240, 300, 420, 600, 900, 1200];

// SVG geometry in viewBox units. Text sits in HTML overlays so it stays readable when the chart shrinks.
const chart = { width: 640, height: 300, left: 52, right: 18, top: 14, bottom: 30, maxSeconds: 1200, maxPushUps: 300 };
const plotWidth = chart.width - chart.left - chart.right;
const plotHeight = chart.height - chart.top - chart.bottom;
const chartX = (seconds: number) => chart.left + (seconds / chart.maxSeconds) * plotWidth;
const chartY = (pushUps: number) => chart.top + (1 - pushUps / chart.maxPushUps) * plotHeight;
const curve = Array.from({ length: chart.maxSeconds / 5 + 1 }, (_, index) => index * 5)
	.map(seconds => `${chartX(seconds).toFixed(1)},${chartY(plankToPushUps(seconds)).toFixed(1)}`);
const linePath = `M${curve.join('L')}`;
const areaPath = `${linePath}L${chartX(chart.maxSeconds)},${chartY(0)}L${chartX(0)},${chartY(0)}Z`;
const yTicks = [0, 100, 200, 300];
const xTicks = [0, 5, 10, 15, 20];
const percentX = (seconds: number) => `${(chartX(seconds) / chart.width) * 100}%`;
const percentY = (pushUps: number) => `${(chartY(pushUps) / chart.height) * 100}%`;
const markers = [
	{ seconds: oneTaskHold, label: `1 task · ${formatHold(oneTaskHold)}` },
	{ seconds: bestRateSeconds, label: `Best rate · ${formatHold(bestRateSeconds)}` },
];
const presets = [
	{ label: '1 task', seconds: oneTaskHold },
	{ label: '2 tasks', seconds: twoTaskHold },
	{ label: 'Best rate', seconds: bestRateSeconds },
	{ label: '10 min', seconds: 600 },
];
const startSeconds = oneTaskHold;
---

<Layout
	title={`Accountability Mondays | ${SITE_TITLE}`}
	description={description}
	neutral
>
	<article class="acc-page">
		<div class="acc-content">
			<header class="acc-header">
				<div class="acc-title">
					<h1>Accountability Mondays</h1>
					<p class="acc-subtitle">How Malaysian AI residents set weekly goals and put push-ups or ringgit on the line.</p>
				</div>
				<div class="acc-intro">
					<p>
						Every Monday, residents gather and say out loud what they will finish by the next Monday.
						A week later, everyone reports back. Each missed task costs {stakes.pushUpsPerTask} push-ups
						or RM{stakes.ringgitPerTask}.
					</p>
					<p>
						It is optional and nobody is forced to stake anything. Most of us do it anyway: a goal
						said out loud to a room of builders is much harder to drop.
					</p>
					<div class="acc-actions">
						<a class="site-button" href={APPLY_FORM_URL}>Apply to the residency</a>
						<a class="acc-text-link" href="#plank">Try the plank calculator <span aria-hidden="true">↓</span></a>
					</div>
				</div>
			</header>

			<dl class="acc-facts">
				<div><dt>When</dt><dd>Every Monday</dd></div>
				<div><dt>Tasks</dt><dd>Self-declared, due next Monday</dd></div>
				<div><dt>Stake</dt><dd>{stakes.pushUpsPerTask} push-ups or RM{stakes.ringgitPerTask} per miss</dd></div>
				<div><dt>Who</dt><dd>Residents only, always optional</dd></div>
			</dl>


			<section class="acc-section" aria-labelledby="week-title">
				<div class="acc-section-head">
					<h2 id="week-title">How the week runs</h2>
					<p>Accountability runs on a Monday-to-Monday loop. You set the tasks; the room keeps score.</p>
				</div>
				<ol class="week-strip">
					{accountabilityWeek.map(day => (
						<li class:list={['week-day', { 'week-key': 'title' in day }]}>
							<span class="week-name">{day.day}</span>
							<span class="week-dot" aria-hidden="true" />
							{'title' in day && (
								<div class="week-note">
									<strong>{day.title}</strong>
									<p>{day.body}</p>
								</div>
							)}
						</li>
					))}
				</ol>
			</section>

			<section class="acc-section" aria-labelledby="stakes-title">
				<div class="acc-section-head">
					<h2 id="stakes-title">What a missed task costs</h2>
					<p>For every task you do not finish by the next Monday, you pick one of two stakes.</p>
				</div>
				<div class="stake-choice">
					<div class="stake-card">
						<img class="sprite sprite-wide" src={sprite.pushup.src} width={sprite.pushup.width} height={sprite.pushup.height} alt="" loading="lazy" decoding="async" />
						<p class="stake-figure"><span class="num">{stakes.pushUpsPerTask}</span> push-ups</p>
						<p>Do them in your own time within {stakes.clearWithinWeeks} weeks, or swap in a plank.</p>
					</div>
					<span class="stake-or" aria-hidden="true">or</span>
					<div class="stake-card">
						<img class="sprite sprite-tall" src={sprite.pool.src} width={sprite.pool.width} height={sprite.pool.height} alt="" loading="lazy" decoding="async" />
						<p class="stake-figure"><span class="num">RM{stakes.ringgitPerTask}</span> in cash</p>
						<p>Paid straight into the common pool that all stakes feed.</p>
					</div>
				</div>
			</section>

			<section class="acc-section acc-section-follow" aria-labelledby="rules-title">
				<div class="acc-section-head">
					<h2 id="rules-title">The push-up rules</h2>
					<p>Choosing push-ups buys you time, not a way out.</p>
				</div>
				<div class="rule-grid">
					<div class="rule-card">
						<img class="sprite sprite-icon" src={sprite.hourglass.src} width={sprite.hourglass.width} height={sprite.hourglass.height} alt="" loading="lazy" decoding="async" />
						<div>
							<h3>{stakes.clearWithinWeeks} weeks to clear</h3>
							<p>
								Push-ups you owe must be done within {stakes.clearWithinWeeks} weeks. Whatever is left then
								converts to cash at RM1 for every {stakes.pushUpsPerRinggit} push-ups, paid into the common pool.
							</p>
							<p class="rule-equation" aria-label={`For example, ${leftoverExample} push-ups left over becomes RM${leftoverExample / stakes.pushUpsPerRinggit}`}>
								<span><b class="num">{leftoverExample}</b> left over</span>
								<span class="rule-arrow" aria-hidden="true">→</span>
								<span><b class="num">RM{leftoverExample / stakes.pushUpsPerRinggit}</b> to the pool</span>
							</p>
						</div>
					</div>
					<div class="rule-card rule-card-stack">
						<div>
							<h3>The stack caps at {stakes.pushUpCap}</h3>
							<p>
								Push-up stakes stack, up to {stakes.pushUpCap}: that is {tasksToCap} missed tasks.
								Reach {stakes.pushUpCap} and the stack resets to zero, and you pay it off in cash instead.
							</p>
						</div>
						<div class="stack-meter" role="img" aria-label={`${tasksToCap} push-up stakes of ${stakes.pushUpsPerTask} fill the ${stakes.pushUpCap} push-up cap, which then resets and is paid in cash`}>
							{Array.from({ length: tasksToCap }, (_, index) => (
								<span class="stack-cell" style={`--level: ${(index + 1) / tasksToCap}`}>{(index + 1) * stakes.pushUpsPerTask}</span>
							))}
						</div>
						<div class="stack-scale" aria-hidden="true"><span>0</span><span>{stakes.pushUpCap}: reset and pay</span></div>
					</div>
				</div>
			</section>

			<section class="acc-section" id="plank" aria-labelledby="plank-title">
				<div class="acc-section-head acc-section-head-sprite">
					<img class="sprite sprite-wide" src={sprite.plank.src} width={sprite.plank.width} height={sprite.plank.height} alt="" loading="lazy" decoding="async" />
					<div>
						<h2 id="plank-title">Swap push-ups for a plank</h2>
						<p>
							Owe push-ups? Hold one continuous forearm plank instead. The longer you hold, the more push-ups
							it clears, but not in a straight line.
						</p>
					</div>
				</div>

				<div class="plank-lab" data-plank-calculator data-per-task={stakes.pushUpsPerTask}>
					<div class="plank-controls">
						<label for="plank-seconds">Plank hold</label>
						<output class="plank-hold num" for="plank-seconds" data-out="hold">{formatHold(startSeconds)}</output>
						<input id="plank-seconds" type="range" min="0" max={chart.maxSeconds} step="1" value={startSeconds} aria-describedby="plank-summary" />
						<div class="plank-presets" role="group" aria-label="Jump to a hold">
							{presets.map(preset => (
								<button type="button" data-seconds={preset.seconds} aria-pressed={preset.seconds === startSeconds ? 'true' : 'false'}>{preset.label}</button>
							))}
						</div>
						<dl class="plank-readout">
							<div><dt>Push-ups cleared</dt><dd class="num" data-out="pushups">{cleared(startSeconds)}</dd></div>
							<div><dt>Tasks cleared</dt><dd class="num" data-out="tasks">{(cleared(startSeconds) / stakes.pushUpsPerTask).toFixed(1)}</dd></div>
							<div><dt>Per second</dt><dd class="num" data-out="rate">{(plankToPushUps(startSeconds) / startSeconds).toFixed(2)}</dd></div>
						</dl>
						<p class="plank-summary" id="plank-summary" aria-live="polite" data-out="summary">
							A {formatHold(startSeconds)} plank clears {cleared(startSeconds)} push-ups.
						</p>
					</div>

					<figure class="plank-chart">
						<figcaption>Push-ups cleared by one continuous plank</figcaption>
						<div class="chart-frame">
							<svg
								viewBox={`0 0 ${chart.width} ${chart.height}`}
								preserveAspectRatio="none"
								role="img"
								aria-label={`Line chart. Push-ups cleared rise slowly for short planks, fastest per second around ${formatHold(bestRateSeconds)}, then flatten, reaching ${cleared(chart.maxSeconds)} at 20 minutes.`}
								data-plank-chart
								data-geometry={JSON.stringify({ ...chart, plotWidth, plotHeight })}
							>
								{yTicks.map(tick => <line class="chart-grid" x1={chart.left} x2={chart.width - chart.right} y1={chartY(tick)} y2={chartY(tick)} />)}
								<path class="chart-area" d={areaPath} />
								<path class="chart-line" d={linePath} />
								<line class="chart-crosshair" data-crosshair x1={chartX(startSeconds)} x2={chartX(startSeconds)} y1={chart.top} y2={chartY(0)} />
							</svg>
							<div class="chart-labels" aria-hidden="true">
								{yTicks.map(tick => <span class="chart-y" style={`top: ${percentY(tick)}`}>{tick}</span>)}
								{xTicks.map(tick => <span class="chart-x" style={`left: ${percentX(tick * 60)}`}>{tick}</span>)}
								{markers.map(marker => {
									const position = `left: ${percentX(marker.seconds)}; top: ${percentY(plankToPushUps(marker.seconds))}`;
									return [<span class="chart-marker" style={position} />, <span class="chart-note" style={position}>{marker.label}</span>];
								})}
								<span class="chart-dot" data-dot style={`left: ${percentX(startSeconds)}; top: ${percentY(plankToPushUps(startSeconds))}`} />
								<span class="chart-tag" data-tag style={`left: ${percentX(startSeconds)}; top: ${percentY(plankToPushUps(startSeconds))}`}>{cleared(startSeconds)}</span>
							</div>
						</div>
						<p class="chart-axis">Plank hold in minutes · tap or hover the chart to set a hold</p>
					</figure>
				</div>

				<ul class="plank-stats">
					<li><strong class="num">{formatHold(oneTaskHold)}</strong><span>clears one task ({stakes.pushUpsPerTask} push-ups)</span></li>
					<li><strong class="num">{formatHold(bestRateSeconds)}</strong><span>is the best rate: {bestRate.toFixed(2)} push-ups per second</span></li>
					<li><strong class="num">{formatHold(fullStackHold)}</strong><span>to plank off a full {stakes.pushUpCap} stack in one go</span></li>
				</ul>

				<div class="plank-formula">
					<div class="formula-card">
						<h3>The formula</h3>
						<math display="block">
							<mrow>
								<mi>p</mi><mo>=</mo><mn>10</mn><mo>·</mo><mi>tanh</mi>
								<mrow><mo>(</mo><mfrac><mrow><mn>0.04</mn><mo>·</mo><mi>x</mi></mrow><mn>10</mn></mfrac><mo>)</mo></mrow>
								<mo>·</mo>
								<msup><mrow><mo>(</mo><mfrac><mrow><mn>7</mn><mi>x</mi></mrow><mn>10</mn></mfrac><mo>)</mo></mrow><mn>0.5</mn></msup>
							</mrow>
						</math>
						<p><i>x</i> is the length of one continuous plank in seconds, and <i>p</i> is the number of push-ups it clears, rounded down.</p>
						<p>
							The tanh term keeps short holds cheap, so a 30 second plank clears only {cleared(30)}. The square root
							flattens very long holds. Together they make about four and a half minutes the most efficient hold.
						</p>
					</div>
					<table class="plank-table">
						<caption>Plank holds and the push-ups they clear</caption>
						<thead><tr><th scope="col">Hold</th><th scope="col">Push-ups</th><th scope="col">Tasks</th></tr></thead>
						<tbody>
							{referenceHolds.map(seconds => (
								<tr>
									<th scope="row">{formatHold(seconds)}</th>
									<td>{cleared(seconds)}</td>
									<td>{(cleared(seconds) / stakes.pushUpsPerTask).toFixed(1)}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</section>

			<FaqSection items={accountabilityFaqs} title="Accountability questions" id="faq" variant="page" />

			<section class="acc-cta" aria-labelledby="cta-title">
				<div class="acc-cta-sprites" aria-hidden="true">
					{Object.values(sprite).map(item => <img class="sprite" src={item.src} width={item.width} height={item.height} alt="" loading="lazy" decoding="async" />)}
				</div>
				<h2 id="cta-title">Want a room that holds you to it?</h2>
				<p>
					Accountability Mondays are for residents. Apply to the residency, or come to an open Thursday
					Show &amp; Tell to meet the room first.
				</p>
				<div class="acc-actions">
					<a class="site-button" href={APPLY_FORM_URL}>Apply now</a>
					<a class="acc-text-link" href={LUMA_URL}>Join a Thursday Show &amp; Tell <span aria-hidden="true">↗</span></a>
					<a class="acc-text-link" href="/residency">About the residency</a>
				</div>
			</section>
		</div>
	</article>
</Layout>

<script>
	import { formatHold, plankToPushUps } from '../../lib/plank-conversion';

	interface Geometry {
		width: number; height: number; left: number; top: number;
		plotWidth: number; plotHeight: number; maxSeconds: number; maxPushUps: number;
	}

	function mountPlankCalculator() {
		const root = document.querySelector<HTMLElement>('[data-plank-calculator]');
		const input = root?.querySelector<HTMLInputElement>('input[type="range"]');
		const svg = root?.querySelector<SVGSVGElement>('[data-plank-chart]');
		if (!root || !input || !svg) return () => {};
		const geometry: Geometry = JSON.parse(svg.dataset.geometry || '{}');
		const perTask = Number(root.dataset.perTask);
		const crosshair = svg.querySelector('[data-crosshair]')!;
		const dot = root.querySelector<HTMLElement>('[data-dot]')!;
		const tag = root.querySelector<HTMLElement>('[data-tag]')!;
		const presets = [...root.querySelectorAll<HTMLButtonElement>('[data-seconds]')];
		const out = (name: string) => root.querySelector<HTMLElement>(`[data-out="${name}"]`)!;
		const x = (seconds: number) => geometry.left + (seconds / geometry.maxSeconds) * geometry.plotWidth;
		const y = (pushUps: number) => geometry.top + (1 - pushUps / geometry.maxPushUps) * geometry.plotHeight;

		const render = () => {
			const seconds = Number(input.value);
			const exact = plankToPushUps(seconds);
			const pushUps = Math.floor(exact);
			out('hold').textContent = formatHold(seconds);
			out('pushups').textContent = String(pushUps);
			out('tasks').textContent = (pushUps / perTask).toFixed(1);
			out('rate').textContent = seconds ? (exact / seconds).toFixed(2) : '0.00';
			out('summary').textContent = `A ${formatHold(seconds)} plank clears ${pushUps} push-up${pushUps === 1 ? '' : 's'}.`;
			const px = x(seconds);
			const py = y(exact);
			crosshair.setAttribute('x1', String(px));
			crosshair.setAttribute('x2', String(px));
			for (const point of [dot, tag]) {
				point.style.left = `${(px / geometry.width) * 100}%`;
				point.style.top = `${(py / geometry.height) * 100}%`;
			}
			tag.textContent = String(pushUps);
			for (const preset of presets) preset.setAttribute('aria-pressed', String(Number(preset.dataset.seconds) === seconds));
		};

		const setFromPointer = (event: PointerEvent) => {
			const box = svg.getBoundingClientRect();
			const viewX = ((event.clientX - box.left) / box.width) * geometry.width;
			const seconds = Math.round((((viewX - geometry.left) / geometry.plotWidth) * geometry.maxSeconds) / 5) * 5;
			input.value = String(Math.min(Math.max(seconds, 0), geometry.maxSeconds));
			render();
		};

		const controller = new AbortController();
		const { signal } = controller;
		input.addEventListener('input', render, { signal });
		svg.addEventListener('pointerdown', setFromPointer, { signal });
		svg.addEventListener('pointermove', event => {
			if (event.pointerType === 'mouse' || event.buttons) setFromPointer(event);
		}, { signal });
		for (const preset of presets) {
			preset.addEventListener('click', () => {
				input.value = preset.dataset.seconds || '0';
				render();
			}, { signal });
		}
		render();
		return () => controller.abort();
	}

	let cleanup = () => {};
	document.addEventListener('astro:page-load', () => { cleanup(); cleanup = mountPlankCalculator(); });
	document.addEventListener('astro:before-swap', () => cleanup());
</script>

<style>
	.acc-page {
		/* Hierarchy comes from space alone: wide gaps between sections, tight gaps inside them. */
		--space-section: clamp(5rem, 10vw, 8rem);
		--space-follow: clamp(3.5rem, 6vw, 5rem);
		--space-group: clamp(2rem, 4vw, 3rem);
		--acc-accent: #e85a52;
		--acc-wash: rgba(232, 90, 82, 0.1);
		--acc-soft: rgba(232, 90, 82, 0.18);
		color: var(--page-text);
		background: var(--page-background);
	}

	@media (prefers-color-scheme: light) {
		:global(html:not([data-theme='dark'])) .acc-page {
			--acc-accent: #c2323b;
			--acc-wash: rgba(194, 50, 59, 0.1);
			--acc-soft: rgba(194, 50, 59, 0.14);
		}
	}

	:global(html[data-theme='light']) .acc-page {
		--acc-accent: #c2323b;
		--acc-wash: rgba(194, 50, 59, 0.1);
		--acc-soft: rgba(194, 50, 59, 0.14);
	}

	.acc-content {
		max-width: 72rem;
		padding: clamp(2rem, 4vw, 3.5rem) 1.5rem clamp(3rem, 6vw, 5rem);
		margin-inline: auto;
	}

	.num { font-weight: 700; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }

	.sprite { display: block; height: auto; image-rendering: pixelated; }
	.sprite-wide { width: calc(116px * 2); }
	.sprite-tall { width: calc(96px * 1.5); }
	.sprite-icon { width: 72px; }

	h1, h2, h3 { color: var(--text-heading); font-weight: 400; }

	h1 {
		margin: 0;
		font: var(--display-weight) var(--text-page-title) / 1.05 var(--font-display);
		letter-spacing: var(--tracking-display);
	}

	h2 {
		margin: 0;
		font: var(--display-weight) clamp(1.75rem, 3vw, 2.4rem) / 1.08 var(--font-display);
		letter-spacing: var(--tracking-display);
	}

	h3 {
		margin: 0 0 0.5rem;
		font-size: var(--text-base);
		font-weight: 700;
		line-height: 1.3;
	}

	p { margin: 0; font-size: var(--text-sm); line-height: var(--leading-body); }

	.acc-header {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem clamp(2rem, 5vw, 5rem);
		align-items: start;
		margin-bottom: var(--space-group);
	}

	.acc-subtitle { max-width: 26rem; margin-top: 0.9rem; }

	.acc-intro { display: grid; gap: 1rem; }
	.acc-intro > p { max-width: 32rem; font-size: var(--text-base); }

	.acc-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		margin-top: 0.4rem;
	}

	.acc-text-link {
		color: var(--page-text);
		font-size: 0.85rem;
		text-decoration: none;
	}

	.acc-text-link span { margin-left: 0.25rem; }

	.acc-text-link:hover {
		color: var(--text-hover);
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	a:focus-visible, button:focus-visible, input:focus-visible {
		outline: 2px solid var(--focus-color);
		outline-offset: 4px;
	}

	.acc-facts {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.25rem 1.5rem;
		margin: 0;
	}

	.acc-facts dt {
		margin: 0 0 0.4rem;
		color: var(--text-soft, var(--page-text));
		font-size: var(--text-xs);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.acc-facts dd { margin: 0; font-size: var(--text-sm); line-height: 1.45; }

	.acc-section { margin-top: var(--space-section); }
	.acc-section-follow { margin-top: var(--space-follow); }

	.acc-section-head {
		display: grid;
		gap: 0.85rem;
