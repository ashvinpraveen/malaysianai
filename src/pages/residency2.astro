---
import { Image } from 'astro:assets';
import showAndTell from '../assets/events/show-and-tell-supabase-ceo.jpg';
import FaqSection from '../components/FaqSection.astro';
import ResidentLogo from '../components/ResidentLogo.astro';
import {
	residency2ApplySteps,
	residency2Facts,
	residency2Faqs,
	residency2For,
	residency2LogoResidents,
	residency2NotFor,
	residency2Offer,
	residency2StoryEntries,
} from '../data/residency2';

const stories = residency2StoryEntries();
import Layout from '../layouts/Layout.astro';
import {
	APPLY_FORM_URL,
	LUMA_URL,
	SITE_TITLE,
	VENUE_ADDRESS,
	VENUE_MAPS_URL,
	VENUE_WAZE_URL,
} from '../consts';

const description =
	'An eight-week, full-time AI residency in Kuala Lumpur for founders already shipping. Peer density, weekly demos, and a working home at 500 Global — 1 October to 30 November 2026.';
---

<Layout
	title={`Two months. A year of progress. | ${SITE_TITLE}`}
	description={description}
	neutral
	noindex
>
	<article class="r2">
		<div class="r2-content">
			<header class="r2-hero">
				<p class="r2-eyebrow">Malaysian AI residency · Cohort 01</p>
				<div class="r2-hero-grid">
					<div class="r2-title">
						<h1>Two months at Malaysian AI.<br />A year of progress.</h1>
						<p class="r2-term">Full-time, in person · 1 October – 30 November 2026</p>
					</div>
					<div class="r2-intro">
						<p>
							Your environment is the work. Spend eight weeks in Kuala Lumpur surrounded by
							founders who are also all-in — a working home, weekly demos, and the pressure to
							ship what a year of part-time evenings never will.
						</p>
						<p>
							This is the selective founder track inside Malaysian AI: not a classroom, not a
							co-working tourism pass. Apply if you are already shipping an AI-native product,
							or ready to go full-time on one.
						</p>
						<div class="r2-actions" id="apply">
							<a class="site-button" href={APPLY_FORM_URL}>Apply now</a>
							<a class="r2-text-link" href="#stories">See resident stories <span aria-hidden="true">↗</span></a>
						</div>
					</div>
				</div>
			</header>

			<dl class="r2-facts">
				{residency2Facts.map((fact) => (
					<div>
						<dt>{fact.label}</dt>
						<dd>{fact.value}</dd>
					</div>
				))}
			</dl>

			<figure class="r2-photo">
				<Image
					src={showAndTell}
					alt="Builders gathered for a Show & Tell conversation at Malaysian AI"
					widths={[720, 1080, 1440, 1920, 2208]}
					sizes="(max-width: 1152px) calc(100vw - 3rem), 1104px"
					format="webp"
					quality={90}
					loading="eager"
					fetchpriority="high"
				/>
				<figcaption>Show &amp; Tell at Malaysian AI — ship in public, every week.</figcaption>
			</figure>

			<section class="r2-section" aria-labelledby="thesis-title">
				<h2 id="thesis-title">College energy. Accelerator pace. KL density.</h2>
				<div class="r2-prose">
					<p>
						Ambitious builders get constrained by school, jobs, and rooms full of people who are
						not building. The residency exists to remove that drag for eight weeks: full-time on
						the company, in person, with peers who treat shipping as the default.
					</p>
					<p>
						Think of it as the all-in chapter of Malaysian AI — the same community you meet on
						open Thursdays, compressed into a cohort with a start date, an end date, and nowhere
						to hide from the work.
					</p>
				</div>
			</section>

			<section class="r2-section r2-filter" aria-labelledby="for-title">
				<div class="r2-filter-col">
					<h2 id="for-title">Who this is for</h2>
					<ul>
						{residency2For.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</div>
				<div class="r2-filter-col r2-filter-not">
					<h2 id="not-title">Who this is not for</h2>
					<ul>
						{residency2NotFor.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</div>
			</section>

			<section class="r2-section" aria-labelledby="offer-title">
				<h2 id="offer-title">What residents get</h2>
				<p class="r2-section-lede">
					Plain inventory — no mystique. If we cannot name it, we do not sell it.
				</p>
				<ul class="r2-offer">
					{residency2Offer.map((item) => (
						<li>
							<h3>{item.title}</h3>
							<p>{item.body}</p>
						</li>
					))}
				</ul>
			</section>

			<section class="r2-section" id="stories" aria-labelledby="stories-title">
				<h2 id="stories-title">Resident stories</h2>
				<p class="r2-section-lede">
					Proof by people shipping products — not a logo wall alone.
				</p>
				<ul class="r2-stories">
					{stories.map(({ resident, story }) => (
						<li>
							<a class="r2-story" href={resident.website}>
								<span class="r2-story-brand">
									<ResidentLogo resident={resident} />
								</span>
								<span class="r2-story-copy">
									<span class="r2-story-name">{resident.name}</span>
									<span class="r2-story-tag">{resident.tag}</span>
									<span class="r2-story-body">{story}</span>
									<span class="r2-story-visit">Visit {resident.name} <span aria-hidden="true">↗</span></span>
								</span>
							</a>
						</li>
					))}
				</ul>
				<p class="r2-inline-link">
					<a href="/residents">Meet every resident team <span aria-hidden="true">↗</span></a>
				</p>
			</section>

			<section class="r2-section" aria-labelledby="path-title">
				<h2 id="path-title">How applying works</h2>
				<p class="r2-section-lede">
					Clear path. No mystery process. We review on a rolling basis until 1 October.
				</p>
				<ol class="r2-path">
					{residency2ApplySteps.map((step, index) => (
						<li>
							<span class="r2-path-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
							<div>
								<h3>{step.title}</h3>
								<p>{step.body}</p>
							</div>
						</li>
					))}
				</ol>
				<div class="r2-actions r2-actions-inline">
					<a class="site-button" href={APPLY_FORM_URL}>Apply now</a>
				</div>
			</section>

			<section class="r2-section r2-visit" aria-labelledby="visit-title">
				<h2 id="visit-title">Come on a Thursday first</h2>
				<p>
					Open Show &amp; Tell Thursdays are the try-before-you-apply path. Meet residents, watch
					demos, feel the density — then decide if eight weeks here is your next move.
				</p>
				<a class="r2-text-link" href={LUMA_URL}>Join a Thursday Show &amp; Tell <span aria-hidden="true">↗</span></a>
			</section>

			<section class="r2-section" aria-labelledby="teams-title">
				<h2 id="teams-title">Current residents</h2>
				<ul class="r2-logos">
					{residency2LogoResidents.map((resident) => (
						<li>
							<a href={resident.website}>
								<ResidentLogo resident={resident} />
								<span>{resident.name}</span>
							</a>
						</li>
					))}
				</ul>
			</section>

			<section id="our-home" class="r2-home" aria-labelledby="home-title">
				<h2 id="home-title">Our home</h2>
				<div class="home-address">
					<p class="home-name">500 Global, Kuala Lumpur</p>
					<address>{VENUE_ADDRESS}</address>
				</div>
				<nav class="home-directions" aria-label="Venue directions">
					<a href={VENUE_MAPS_URL}>Google Maps <span aria-hidden="true">↗</span></a>
					<a href={VENUE_WAZE_URL}>Waze <span aria-hidden="true">↗</span></a>
				</nav>
			</section>

			<section class="r2-closing" aria-labelledby="closing-title">
				<h2 id="closing-title">Ready to go all-in?</h2>
				<p>
					Eight weeks. Full-time. In person in Kuala Lumpur. Applications close 1 October 2026.
				</p>
				<a class="site-button" href={APPLY_FORM_URL}>Apply to the residency</a>
			</section>

			<FaqSection items={residency2Faqs} variant="page" id="residency2-faq" />
		</div>
	</article>
</Layout>

<style>
	.r2 {
		color: var(--page-text);
		background: var(--page-background);
	}

	.r2-content {
		max-width: 72rem;
		padding: clamp(2rem, 4vw, 3.5rem) 1.5rem clamp(3rem, 6vw, 5rem);
		margin-inline: auto;
	}

	.r2-eyebrow {
		margin: 0 0 1.25rem;
		color: var(--text-softer);
		font-size: var(--text-xs);
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.r2-hero-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem clamp(2rem, 5vw, 5rem);
		align-items: start;
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	h1 {
		margin: 0;
		font: 400 var(--text-page-title) / 0.95 var(--font-display);
		letter-spacing: -0.04em;
	}

	.r2-term {
		margin: 0.9rem 0 0;
		font-size: var(--text-sm);
		line-height: 1.5;
	}

	.r2-intro {
		display: grid;
		gap: 1rem;
	}

	.r2-intro > p,
	.r2-prose > p,
	.r2-visit > p,
	.r2-closing > p {
		max-width: 34rem;
		margin: 0;
		font-size: var(--text-base);
		line-height: var(--leading-body);
	}

	.r2-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		margin-top: 1.4rem;
	}

	.r2-actions-inline {
		margin-top: 1.75rem;
	}

	.r2-text-link,
	.r2-inline-link a,
	.home-directions a {
		color: var(--page-text);
		font-size: 0.85rem;
		text-decoration: none;
	}

	.r2-text-link span,
	.r2-inline-link a span,
	.home-directions a span,
	.r2-story-visit span {
		margin-left: 0.25rem;
	}

	.r2-facts {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.25rem 1.5rem;
		margin: 0 0 clamp(2rem, 4vw, 3rem);
		padding: 1.15rem 0;
		border-top: 1px solid var(--page-border);
		border-bottom: 1px solid var(--page-border);
	}

	.r2-facts dt {
		margin: 0 0 0.3rem;
		font-size: var(--text-xs);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.r2-facts dd {
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.45;
	}

	.r2-photo {
		margin: 0 0 clamp(2.5rem, 5vw, 4rem);
	}

	.r2-photo :global(img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		object-position: 50% 40%;
		border-radius: var(--radius-media);
	}

	figcaption {
		margin-top: 0.75rem;
		font-size: var(--text-xs);
		line-height: 1.5;
	}

	.r2-section {
		padding-top: clamp(2rem, 4vw, 3rem);
		margin-top: clamp(1.5rem, 3vw, 2.5rem);
		border-top: 1px solid var(--page-border);
	}

	.r2-section h2,
	.r2-closing h2 {
		margin: 0 0 1rem;
		color: var(--text-heading);
		font: 400 var(--text-section-title) / 1.05 var(--font-display);
		letter-spacing: -0.03em;
	}

	.r2-section-lede {
		max-width: 36rem;
		margin: -0.25rem 0 1.5rem;
		color: var(--text-soft);
		font-size: var(--text-sm);
		line-height: var(--leading-body);
	}

	.r2-prose {
		display: grid;
		gap: 1rem;
	}

	.r2-filter {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(1.75rem, 4vw, 3rem);
		border-top: 1px solid var(--page-border);
	}

	.r2-filter-col ul {
		display: grid;
		gap: 0.85rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.r2-filter-col li {
		padding-left: 1.1rem;
		font-size: var(--text-sm);
		line-height: var(--leading-body);
		background: linear-gradient(currentColor, currentColor) 0 0.55em / 0.45rem 0.45rem no-repeat;
	}

	.r2-filter-not li {
		color: var(--text-soft);
	}

	.r2-offer {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem 1.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.r2-offer h3 {
		margin: 0 0 0.45rem;
		font: 400 1.05rem / 1.2 var(--font-display);
		letter-spacing: -0.02em;
	}

	.r2-offer p {
		margin: 0;
		color: var(--text-soft);
		font-size: var(--text-sm);
		line-height: var(--leading-body);
	}

	.r2-stories {
		display: grid;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.r2-story {
		display: grid;
		grid-template-columns: 5.5rem minmax(0, 1fr);
		gap: 1.25rem 1.5rem;
		padding: 1.25rem 0;
		border-bottom: 1px solid var(--page-border);
		color: inherit;
		text-decoration: none;
	}

	.r2-stories li:first-child .r2-story {
		padding-top: 0;
	}

	.r2-story-brand {
		display: grid;
		place-items: center;
		align-self: start;
		aspect-ratio: 1;
		overflow: hidden;
		border: 1px solid var(--page-border);
		border-radius: var(--radius-media);
		background: var(--card-background);
	}

	.r2-story-copy {
		display: grid;
		gap: 0.35rem;
		min-width: 0;
	}

	.r2-story-name {
		font: 400 1.15rem / 1.15 var(--font-display);
		letter-spacing: -0.02em;
	}

	.r2-story-tag {
		color: var(--text-softer);
		font-size: var(--text-xs);
	}

	.r2-story-body {
		margin-top: 0.35rem;
		font-size: var(--text-sm);
		line-height: var(--leading-body);
	}

	.r2-story-visit {
		margin-top: 0.55rem;
		font-size: 0.8rem;
	}

	.r2-inline-link {
		margin: 1.25rem 0 0;
	}

	.r2-path {
		display: grid;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
		counter-reset: none;
	}

	.r2-path li {
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr);
		gap: 1rem;
		align-items: start;
	}

	.r2-path-num {
		color: var(--text-softer);
		font-size: var(--text-xs);
		letter-spacing: 0.08em;
	}

	.r2-path h3 {
		margin: 0 0 0.35rem;
		font: 400 1.05rem / 1.2 var(--font-display);
		letter-spacing: -0.02em;
	}

	.r2-path p {
		margin: 0;
		max-width: 36rem;
		color: var(--text-soft);
		font-size: var(--text-sm);
		line-height: var(--leading-body);
	}

	.r2-visit p {
		margin-bottom: 1rem;
	}

	.r2-logos {
		display: grid;
		grid-template-columns: repeat(7, minmax(0, 1fr));
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.r2-logos a {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		height: 100%;
		padding: 1.25rem 0.5rem;
		border: 1px solid var(--page-border);
		border-radius: 0.5rem;
		color: var(--page-text);
		background: var(--card-background);
		text-decoration: none;
	}

	.r2-logos a > span {
		font-size: var(--text-xs);
		text-align: center;
	}

	.r2-logos a:hover {
		border-color: var(--text-hover);
	}

	.r2-home {
		display: grid;
		grid-template-columns: 7rem minmax(0, 1fr) auto;
		gap: 0.75rem 1.5rem;
		align-items: start;
		padding-top: clamp(2rem, 4vw, 3rem);
		margin-top: clamp(2.75rem, 5vw, 4rem);
		border-top: 1px solid var(--page-border);
	}

	.r2-home h2 {
		margin: 0;
		font-size: var(--text-xs);
		font-weight: 400;
		line-height: var(--leading-body);
	}

	.home-name {
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.5;
	}

	.home-address address {
		max-width: 35rem;
		margin-top: 0.3rem;
		color: var(--page-text);
		font-size: 0.8rem;
		font-style: normal;
		line-height: var(--leading-body);
	}

	.home-directions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
	}

	.r2-closing {
		display: grid;
		gap: 1rem;
		justify-items: start;
		padding: clamp(2rem, 4vw, 3rem) 0;
		margin-top: clamp(2rem, 4vw, 3rem);
		border-top: 1px solid var(--page-border);
	}

	.r2-text-link:hover,
	.r2-inline-link a:hover,
	.home-directions a:hover,
	.r2-story:hover .r2-story-visit {
		color: var(--text-hover);
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	a:focus-visible {
		outline: 2px solid var(--focus-color);
		outline-offset: 4px;
	}

	@media (max-width: 900px) {
		.r2-offer {
			grid-template-columns: 1fr 1fr;
		}

		.r2-logos {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	@media (max-width: 760px) {
		.r2-hero-grid,
		.r2-filter {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.r2-facts {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.r2-offer {
			grid-template-columns: 1fr;
		}

		.r2-story {
			grid-template-columns: 4.5rem minmax(0, 1fr);
		}

		.r2-logos {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.r2-home {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}

		.home-directions {
			margin-top: 0.25rem;
		}

		h1 br {
			display: none;
		}
	}
</style>
