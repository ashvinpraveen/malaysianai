{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/luma-events",
      "destination": "https://api.luma.com/calendar/get-items?calendar_api_id=cal-pPgkuwCFrycSv1Z&period=future&pagination_limit=20"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "destination": "/api/markdown-not-found"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/index.md",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    }
  ],
  "redirects": [
    {
      "source": "/pivot",
      "destination": "https://luma.com/01d8h02p?utm_source=malaysianai&utm_medium=redirect&utm_campaign=pivot",
      "statusCode": 302
    },
    {
      "source": "/aimto",
      "destination": "https://aimto.my/",
      "statusCode": 301
    },
    {
      "source": "/aimto/learnathon",
      "destination": "https://aimto.my/",
      "statusCode": 301
    },
    {
      "source": "/aimto/learnathon2",
      "destination": "https://aimto.my/",
      "statusCode": 301
    },
    {
      "source": "/aimto/learnathon3",
      "destination": "https://aimto.my/",
      "statusCode": 301
    },
    {
      "source": "/aimto/learnathon4",
      "destination": "https://aimto.my/",
      "statusCode": 301
    },
    {
      "source": "/aimto/:path*",
      "destination": "https://aimto.my/",
      "statusCode": 301
    },
    {
      "source": "/aimalaysiatakeover",
      "destination": "https://aimto.my/",
      "statusCode": 301
    },
    {
      "source": "/residency/apply",
      "destination": "/residency#apply",
      "statusCode": 301
    },
    {
      "source": "/residency/showandtell",
      "destination": "/residency",
      "statusCode": 301
    },
    {
      "source": "/community",
      "destination": "/#communities",
      "statusCode": 301
    },
    {
      "source": "/venue",
      "destination": "/residency#our-home",
      "statusCode": 301
    }
  ]
}
